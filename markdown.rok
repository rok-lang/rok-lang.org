// CommonMark subset to HTML: ATX headings (GitHub ids), paragraphs,
// fenced code, block quotes (GitHub callouts), nested lists, GFM tables,
// thematic breaks, `<div>` / `<section>` HTML blocks, footnote markers,
// and the inline forms (code, emphasis, strikethrough, links, images,
// autolinks, entities, escapes, hard breaks).

use pkg::highlight;

pub struct Heading {
    pub level: i32;
    pub id: str;
    pub text: str;
}

pub struct Doc {
    pub html: str;
    pub title: str;
    pub headings: List<Heading>;
}

/// `link` maps a link destination as written to the emitted `href`.
pub fn render(src: str, link: fn(str) -> str) -> Doc {
    let md = Md { link: link, used: Dict::new(), heads: List::new() };
    let html = md.blocks(split_lines(src), false);
    let title = "";
    for h in md.heads {
        if h.level == 1 { title = h.text; break; }
    }
    Doc { html: html, title: title, headings: md.heads }
}

struct Md {
    link: fn(str) -> str;
    used: Dict<str, i32>;
    heads: List<Heading>;
}

struct Fence {
    ch: char;
    n: usize;
    info: str;
}

struct Atx {
    level: i32;
    text: str;
}

struct Marker {
    ordered: bool;
    bullet: char;
    start: str;
    indent: usize;
    col: usize;
}

// ---- line classification ----

/// Lines without `\n` / `\r\n`, in one pass (`str::lines` re-slices the
/// rest per line).
fn split_lines(s: str) -> List<str> {
    let out: List<str> = List::new();
    let cur = StrBuf::new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur.to_str().strip_suffix("\r") ?? cur.to_str());
            cur = StrBuf::new();
        } else {
            cur.push(c);
        }
    }
    if !cur.is_empty() { out.push(cur.to_str()); }
    out
}

fn indent(l: str) -> usize { l.len() - l.trim_start().len() }

fn is_blank(l: str) -> bool { l.trim().is_empty() }

/// `l` without up to `n` leading spaces.
fn dedent(l: str, n: usize) -> str {
    let k = indent(l);
    if k < n { l[k:] } else { l[n:] }
}

fn run_of(l: str, c: char) -> usize {
    let n = 0usize;
    for x in l.chars() {
        if x != c { break; }
        n += 1;
    }
    n
}

fn fence_open(l: str) -> Fence | none {
    if indent(l) > 3 { return none; }
    let t = l.trim_start();
    let ch = if t.starts_with("```") { '`' } else if t.starts_with("~~~") { '~' } else { return none; };
    let n = run_of(t, ch);
    let info = t[n:].trim();
    if ch == '`' && info.contains("`") { return none; }
    let lang = info;
    if let k: usize = info.find(" ") { lang = info[:k]; }
    Fence { ch: ch, n: n, info: lang }
}

fn fence_close(l: str, f: Fence) -> bool {
    if indent(l) > 3 { return false; }
    let t = l.trim();
    let n = run_of(t, f.ch);
    n >= f.n && n == t.char_count()
}

fn atx(l: str) -> Atx | none {
    if indent(l) > 3 { return none; }
    let t = l.trim_start();
    let n = run_of(t, '#');
    if n == 0 || n > 6 { return none; }
    let rest = t[n:];
    if !rest.is_empty() && !rest.starts_with(" ") { return none; }
    let text = rest.trim();
    // Closing sequence: trailing `#`s after a space.
    let bare = text;
    while bare.ends_with("#") { bare = bare[:bare.len() - 1]; }
    if bare.len() < text.len() && (bare.is_empty() || bare.ends_with(" ")) { text = bare.trim_end(); }
    Atx { level: n as i32, text: text }
}

fn is_hr(l: str) -> bool {
    if indent(l) > 3 { return false; }
    let t = l.trim();
    if t.is_empty() { return false; }
    let c = t.chars().next() ?? ' ';
    if c != '-' && c != '*' && c != '_' { return false; }
    let n = 0;
    for x in t.chars() {
        if x == c { n += 1; } else if x != ' ' { return false; }
    }
    n >= 3
}

/// The text after `>` (and one optional space), or `none`.
fn quoted(l: str) -> str | none {
    if indent(l) > 3 { return none; }
    let t = l.trim_start();
    if !t.starts_with(">") { return none; }
    let r = t[1:];
    if r.starts_with(" ") { return r[1:]; }
    r
}

fn marker(l: str) -> Marker | none {
    let ind = indent(l);
    let t = l[ind:];
    if t.is_empty() { return none; }
    let c = t.chars().next() ?? ' ';
    let ordered = false;
    let start = "";
    let w = 0usize;
    if c == '-' || c == '*' || c == '+' {
        w = 1;
    } else {
        let d = 0usize;
        for x in t.chars() {
            if !x.is_ascii_digit() { break; }
            d += 1;
        }
        if d == 0 || d > 9 || d >= t.len() { return none; }
        let p = t[d:];
        if !p.starts_with(".") && !p.starts_with(")") { return none; }
        ordered = true;
        start = t[:d];
        w = d + 1;
    }
    let rest = t[w:];
    if rest.is_empty() { return Marker { ordered: ordered, bullet: c, start: start, indent: ind, col: ind + w + 1 }; }
    if !rest.starts_with(" ") { return none; }
    let sp = indent(rest);
    if sp > 4 || sp == rest.len() { sp = 1; }
    Marker { ordered: ordered, bullet: c, start: start, indent: ind, col: ind + w + sp }
}

fn same_list(a: Marker, b: Marker) -> bool {
    if a.ordered != b.ordered { return false; }
    a.ordered || a.bullet == b.bullet
}

fn is_html_line(l: str) -> bool {
    let t = l.trim_start();
    t.starts_with("<div") || t.starts_with("</div>") || t.starts_with("<section") || t.starts_with("</section>")
}

fn is_footnote_def(l: str) -> bool { l.starts_with("[^") && l.contains("]:") }

/// Table cells of a row, outer pipes dropped, `\|` unescaped.
fn cells(l: str) -> List<str> {
    let t = l.trim();
    if t.starts_with("|") { t = t[1:]; }
    if t.ends_with("|") && !t.ends_with("\\|") { t = t[:t.len() - 1]; }
    let out: List<str> = List::new();
    let cur = StrBuf::new();
    let esc = false;
    for c in t.chars() {
        if c == '|' && !esc {
            out.push(cur.to_str().trim().replace("\\|", "|"));
            cur = StrBuf::new();
        } else {
            cur.push(c);
        }
        esc = c == '\\' && !esc;
    }
    out.push(cur.to_str().trim().replace("\\|", "|"));
    out
}

fn is_delim_row(l: str) -> bool {
    if !l.contains("-") { return false; }
    for c in cells(l) {
        let t = c;
        if t.starts_with(":") { t = t[1:]; }
        if t.ends_with(":") { t = t[:t.len() - 1]; }
        if t.is_empty() { return false; }
        for x in t.chars() {
            if x != '-' { return false; }
        }
    }
    true
}

fn is_table_start(lines: List<str>, i: usize) -> bool {
    i + 1 < lines.len() && lines[i].contains("|") && is_delim_row(lines[i + 1])
}

/// Can `l` interrupt a paragraph?
fn interrupts(l: str) -> bool {
    if fence_open(l) is Fence || atx(l) is Atx || is_hr(l) || quoted(l) is str || is_html_line(l) { return true; }
    if let m: Marker = marker(l) {
        if m.indent > 3 { return false; }
        return !m.ordered || m.start == "1";
    }
    false
}

// ---- escaping ----

pub fn esc(s: str) -> str {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn push_esc(out: StrBuf, c: char) {
    if c == '&' {
        out.push_str("&amp;");
    } else if c == '<' {
        out.push_str("&lt;");
    } else if c == '>' {
        out.push_str("&gt;");
    } else if c == '"' {
        out.push_str("&quot;");
    } else {
        out.push(c);
    }
}

/// Text of an HTML fragment: tags dropped, the basic entities decoded.
pub fn strip_tags(html: str) -> str {
    let out = StrBuf::new();
    let tag = false;
    for c in html.chars() {
        if c == '<' {
            tag = true;
        } else if c == '>' && tag {
            tag = false;
        } else if !tag {
            out.push(c);
        }
    }
    out.to_str().replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&amp;", "&")
}

/// GitHub's heading anchor: lowercase, keep letters / digits / `-` / `_`,
/// spaces become `-`.
pub fn slug(text: str) -> str {
    let out = StrBuf::new();
    for c in text.to_lowercase().chars() {
        if c.is_alphanumeric() || c == '-' || c == '_' {
            out.push(c);
        } else if c == ' ' {
            out.push('-');
        }
    }
    out.to_str()
}

// ---- blocks ----

impl Md {
    fn id_for(self, text: str) -> str {
        let base = slug(text);
        let n = self.used.get(base) ?? 0;
        self.used.insert(base, n + 1);
        if n == 0 { base } else { f"{base}-{n}" }
    }

    /// `tight`: paragraphs without `<p>` (items of a tight list).
    fn blocks(self, lines: List<str>, tight: bool) -> str {
        let out = StrBuf::new();
        let n = lines.len();
        let i = 0usize;
        while i < n {
            let l = lines[i];
            if is_blank(l) {
                i += 1;
                continue;
            }
            if let f: Fence = fence_open(l) {
                let pad = indent(l);
                let body = StrBuf::new();
                i += 1;
                while i < n && !fence_close(lines[i], f) {
                    body.push_str(dedent(lines[i], pad));
                    body.push('\n');
                    i += 1;
                }
                i += 1;
                out.push_str(code_block(f.info, body.to_str()));
                continue;
            }
            if let h: Atx = atx(l) {
                let inner = self.inline(h.text);
                let text = strip_tags(inner).trim();
                let id = self.id_for(text);
                self.heads.push(Heading { level: h.level, id: id, text: text });
                out.push_str(f"<h{h.level} id=\"{esc(id)}\"><a class=\"anchor\" href=\"#{esc(id)}\" aria-hidden=\"true\">#</a>{inner}</h{h.level}>\n");
                i += 1;
                continue;
            }
            if is_hr(l) {
                out.push_str("<hr>\n");
                i += 1;
                continue;
            }
            if let first: str = quoted(l) {
                let inner: List<str> = List::new();
                inner.push(first);
                i += 1;
                while i < n {
                    if let q: str = quoted(lines[i]) {
                        inner.push(q);
                    } else if !is_blank(lines[i]) && !is_blank(inner[inner.len() - 1]) && !interrupts(lines[i]) {
                        inner.push(lines[i]);
                    } else {
                        break;
                    }
                    i += 1;
                }
                out.push_str(self.quote(inner));
                continue;
            }
            if is_html_line(l) {
                while i < n && !is_blank(lines[i]) {
                    out.push_str(lines[i]);
                    out.push('\n');
                    i += 1;
                }
                continue;
            }
            if is_table_start(lines, i) {
                i = self.table(lines, i, out);
                continue;
            }
            if let m: Marker = marker(l) {
                if m.indent <= 3 {
                    i = self.list(lines, i, m, out);
                    continue;
                }
            }
            if is_footnote_def(l) {
                let k = l.find("]:") ?? 0;
                let name = l[2:k];
                out.push_str(f"<p class=\"footnote\" id=\"fn-{esc(name)}\"><sup>{esc(name)}</sup> {self.inline(l[k + 2:].trim())}</p>\n");
                i += 1;
                continue;
            }
            // Paragraph.
            let para = StrBuf::new();
            let first = true;
            while i < n && !is_blank(lines[i]) {
                if !first && (interrupts(lines[i]) || is_table_start(lines, i) || is_footnote_def(lines[i])) { break; }
                if !first { para.push('\n'); }
                let t = lines[i].trim_start();
                // Two trailing spaces: hard break (as `\` + newline).
                if t.ends_with("  ") { t = t.trim_end() + "\\"; }
                para.push_str(t);
                first = false;
                i += 1;
            }
            let text = para.to_str().trim_end();
            if text.ends_with("\\") { text = text[:text.len() - 1]; }
            if tight {
                out.push_str(self.inline(text));
                out.push('\n');
            } else {
                out.push_str(f"<p>{self.inline(text)}</p>\n");
            }
        }
        out.to_str()
    }

    fn quote(self, inner: List<str>) -> str {
        let kind = "";
        if inner.len() > 0 {
            let t = inner[0].trim();
            if t.starts_with("[!") && t.ends_with("]") {
                kind = t[2:t.len() - 1].to_lowercase();
                inner.remove(0);
            }
        }
        let body = self.blocks(inner, false);
        if kind.is_empty() { return f"<blockquote>\n{body}</blockquote>\n"; }
        let label = if kind == "note" {
            "참고"
        } else if kind == "tip" {
            "팁"
        } else if kind == "important" {
            "중요"
        } else if kind == "warning" {
            "경고"
        } else if kind == "caution" {
            "주의"
        } else {
            kind
        };
        f"<div class=\"callout {esc(kind)}\"><p class=\"callout-title\">{label}</p>\n{body}</div>\n"
    }

    fn table(self, lines: List<str>, start: usize, out: StrBuf) -> usize {
        let head = cells(lines[start]);
        let aligns: List<str> = List::new();
        for c in cells(lines[start + 1]) {
            let l = c.starts_with(":");
            let r = c.ends_with(":");
            aligns.push(if l && r { "center" } else if r { "right" } else if l { "left" } else { "" });
        }
        out.push_str("<div class=\"table-wrap\"><table>\n<thead><tr>");
        self.row(head, aligns, "th", out);
        out.push_str("</tr></thead>\n<tbody>\n");
        let i = start + 2;
        while i < lines.len() && !is_blank(lines[i]) && lines[i].contains("|") {
            out.push_str("<tr>");
            self.row(cells(lines[i]), aligns, "td", out);
            out.push_str("</tr>\n");
            i += 1;
        }
        out.push_str("</tbody></table></div>\n");
        i
    }

    fn row(self, cs: List<str>, aligns: List<str>, tag: str, out: StrBuf) {
        for k in 0..aligns.len() {
            let a = aligns[k];
            let style = if a.is_empty() { "" } else { f" style=\"text-align:{a}\"" };
            let text = if k < cs.len() { self.inline(cs[k]) } else { "" };
            out.push_str(f"<{tag}{style}>{text}</{tag}>");
        }
    }

    fn list(self, lines: List<str>, start: usize, first: Marker, out: StrBuf) -> usize {
        let items: List<List<str>> = List::new();
        let cur: List<str> = List::new();
        let m = first;
        let loose = false;
        let in_fence = false;
        let n = lines.len();
        cur.push(lines[start][m.col:]);
        if fence_open(cur[0]) is Fence { in_fence = true; }
        let i = start + 1;
        while i < n {
            let l = lines[i];
            if is_blank(l) {
                let k = i + 1;
                while k < n && is_blank(lines[k]) { k += 1; }
                if k >= n { break; }
                if indent(lines[k]) >= m.col {
                    if !in_fence { loose = true; }
                    while i < k {
                        cur.push("");
                        i += 1;
                    }
                    continue;
                }
                if let nm: Marker = marker(lines[k]) {
                    if same_list(first, nm) && nm.indent < m.col && nm.indent <= 3 + first.indent {
                        loose = true;
                        i = k;
                        continue;
                    }
                }
                break;
            }
            if !in_fence && indent(l) < m.col {
                if let nm: Marker = marker(l) {
                    if !same_list(first, nm) || is_hr(l) { break; }
                    items.push(cur);
                    cur = List::new();
                    m = nm;
                    cur.push(l[m.col:]);
                    if fence_open(cur[0]) is Fence { in_fence = true; }
                    i += 1;
                    continue;
                }
                // Lazy continuation of the item's last paragraph line.
                let last = cur[cur.len() - 1];
                if is_blank(last) || interrupts(l) || fence_open(last.trim_start()) is Fence { break; }
                cur.push(l.trim_start());
                i += 1;
                continue;
            }
            let body = dedent(l, m.col);
            if in_fence {
                let t = body.trim();
                if t.starts_with("```") || t.starts_with("~~~") { in_fence = false; }
            } else if fence_open(body) is Fence {
                in_fence = true;
            }
            cur.push(body);
            i += 1;
        }
        items.push(cur);
        let tag = if first.ordered { "ol" } else { "ul" };
        let attr = if first.ordered && first.start != "1" { f" start=\"{first.start}\"" } else { "" };
        out.push_str(f"<{tag}{attr}>\n");
        for it in items {
            out.push_str("<li>");
            out.push_str(self.blocks(it, !loose));
            out.push_str("</li>\n");
        }
        out.push_str(f"</{tag}>\n");
        i
    }
}

fn code_block(lang: str, body: str) -> str {
    let code = if lang == "rok" || lang == "rokon" { highlight::rok(body) } else { esc(body) };
    let cls = if lang.is_empty() { "" } else { f" class=\"language-{esc(lang)}\"" };
    f"<pre><code{cls}>{code}</code></pre>\n"
}

// ---- inlines ----

fn is_punct(c: char) -> bool { c.is_ascii_punctuation() }

fn text_of(cs: List<char>, a: usize, b: usize) -> str {
    let s = StrBuf::new();
    for k in a..b { s.push(cs[k]); }
    s.to_str()
}

fn run(cs: List<char>, i: usize, b: usize, c: char) -> usize {
    let k = i;
    while k < b && cs[k] == c { k += 1; }
    k - i
}

/// End of the code span opened by the backtick run at `i`, or `none`.
fn code_end(cs: List<char>, i: usize, b: usize) -> usize | none {
    let r = run(cs, i, b, '`');
    let k = i + r;
    while k < b {
        if cs[k] == '`' {
            let q = run(cs, k, b, '`');
            if q == r { return k; }
            k += q;
        } else {
            k += 1;
        }
    }
    none
}

/// The `]` matching the `[` at `i`.
fn bracket_end(cs: List<char>, i: usize, b: usize) -> usize | none {
    let depth = 0;
    let k = i;
    while k < b {
        let c = cs[k];
        if c == '\\' {
            k += 2;
            continue;
        }
        if c == '`' {
            if let e: usize = code_end(cs, k, b) {
                k = e + run(cs, e, b, '`');
                continue;
            }
            k += run(cs, k, b, '`');
            continue;
        }
        if c == '[' { depth += 1; }
        if c == ']' {
            depth -= 1;
            if depth == 0 { return k; }
        }
        k += 1;
    }
    none
}

/// The `)` matching the `(` at `i`.
fn paren_end(cs: List<char>, i: usize, b: usize) -> usize | none {
    let depth = 0;
    for k in i..b {
        let c = cs[k];
        if c == '(' { depth += 1; }
        if c == ')' {
            depth -= 1;
            if depth == 0 { return k; }
        }
    }
    none
}

/// Does `[a, b)` hold a complete inline link?
fn has_link(cs: List<char>, a: usize, b: usize) -> bool {
    for k in a..b {
        if cs[k] != '[' || (k > 0 && cs[k - 1] == '!') { continue; }
        if let e: usize = bracket_end(cs, k, b) {
            if e + 1 < b && cs[e + 1] == '(' && paren_end(cs, e + 1, b) is usize { return true; }
        }
    }
    false
}

/// CommonMark flanking rules; the ends of the text count as whitespace.
fn ws_at(cs: List<char>, k: usize) -> bool { k >= cs.len() || cs[k].is_whitespace() }

fn punct_at(cs: List<char>, k: usize) -> bool {
    if k >= cs.len() { return false; }
    let c = cs[k];
    !c.is_alphanumeric() && !c.is_whitespace()
}

fn left_flanking(cs: List<char>, i: usize, r: usize) -> bool {
    let prev_ws = i == 0 || cs[i - 1].is_whitespace();
    let prev_p = i > 0 && punct_at(cs, i - 1);
    !ws_at(cs, i + r) && (!punct_at(cs, i + r) || prev_ws || prev_p)
}

fn right_flanking(cs: List<char>, i: usize, r: usize) -> bool {
    if i == 0 || cs[i - 1].is_whitespace() { return false; }
    !punct_at(cs, i - 1) || ws_at(cs, i + r) || punct_at(cs, i + r)
}

fn can_open(cs: List<char>, i: usize, r: usize, d: char) -> bool {
    let l = left_flanking(cs, i, r);
    if d != '_' { return l; }
    l && (!right_flanking(cs, i, r) || (i > 0 && punct_at(cs, i - 1)))
}

fn can_close(cs: List<char>, i: usize, r: usize, d: char) -> bool {
    let rf = right_flanking(cs, i, r);
    if d != '_' { return rf; }
    rf && (!left_flanking(cs, i, r) || punct_at(cs, i + r))
}

/// Start of the closing delimiter run (exactly `want` of `d`) for an
/// emphasis opened before `from`.
fn closer(cs: List<char>, from: usize, b: usize, d: char, want: usize) -> usize | none {
    let k = from;
    while k < b {
        let c = cs[k];
        if c == '\\' {
            k += 2;
            continue;
        }
        if c == '`' {
            if let e: usize = code_end(cs, k, b) {
                k = e + run(cs, e, b, '`');
                continue;
            }
        }
        if c == d {
            let r = run(cs, k, b, d);
            if r == want && k > from && can_close(cs, k, r, d) { return k; }
            k += r;
            continue;
        }
        k += 1;
    }
    none
}

fn is_entity(cs: List<char>, i: usize, b: usize) -> bool {
    let k = i + 1;
    while k < b && k < i + 32 && (cs[k].is_ascii_alphanumeric() || cs[k] == '#') { k += 1; }
    k > i + 1 && k < b && cs[k] == ';'
}

impl Md {
    fn inline(self, s: str) -> str {
        let cs: List<char> = List::new();
        for c in s.chars() { cs.push(c); }
        let out = StrBuf::new();
        self.span(cs, 0, cs.len(), out);
        out.to_str()
    }

    fn span(self, cs: List<char>, a: usize, b: usize, out: StrBuf) {
        let i = a;
        while i < b {
            let c = cs[i];
            if c == '\\' && i + 1 < b {
                let nx = cs[i + 1];
                if nx == '\n' {
                    out.push_str("<br>\n");
                    i += 2;
                    continue;
                }
                if is_punct(nx) {
                    push_esc(out, nx);
                    i += 2;
                    continue;
                }
            }
            if c == '`' {
                let r = run(cs, i, b, '`');
                if let e: usize = code_end(cs, i, b) {
                    let t = text_of(cs, i + r, e).replace("\n", " ");
                    if t.len() >= 2 && t.starts_with(" ") && t.ends_with(" ") && !t.trim().is_empty() { t = t[1:t.len() - 1]; }
                    out.push_str(f"<code>{esc(t)}</code>");
                    i = e + r;
                    continue;
                }
                for _ in 0..r { out.push('`'); }
                i += r;
                continue;
            }
            if c == '[' && i + 1 < b && cs[i + 1] == '^' {
                if let e: usize = bracket_end(cs, i, b) {
                    let name = esc(text_of(cs, i + 2, e));
                    out.push_str(f"<sup class=\"fnref\"><a href=\"#fn-{name}\">{name}</a></sup>");
                    i = e + 1;
                    continue;
                }
            }
            if c == '[' || (c == '!' && i + 1 < b && cs[i + 1] == '[') {
                let img = c == '!';
                let o = if img { i + 1 } else { i };
                if let e: usize = bracket_end(cs, o, b) {
                    if e + 1 < b && cs[e + 1] == '(' {
                        if let p: usize = paren_end(cs, e + 1, b) {
                            if !img && has_link(cs, o + 1, e) {
                                // Links do not nest: the inner one wins.
                                out.push('[');
                                i += 1;
                                continue;
                            }
                            let dest = text_of(cs, e + 2, p).trim();
                            if let k: usize = dest.find(" \"") { dest = dest[:k]; }
                            if dest.starts_with("<") && dest.ends_with(">") { dest = dest[1:dest.len() - 1]; }
                            let href = esc((self.link)(dest));
                            if img {
                                let alt = StrBuf::new();
                                self.span(cs, o + 1, e, alt);
                                out.push_str(f"<img src=\"{href}\" alt=\"{esc(strip_tags(alt.to_str()))}\">");
                            } else {
                                out.push_str(f"<a href=\"{href}\">");
                                self.span(cs, o + 1, e, out);
                                out.push_str("</a>");
                            }
                            i = p + 1;
                            continue;
                        }
                    }
                }
            }
            if c == '<' {
                let k = i + 1;
                while k < b && cs[k] != '>' && cs[k] != ' ' && cs[k] != '<' { k += 1; }
                if k < b && cs[k] == '>' {
                    let u = text_of(cs, i + 1, k);
                    if u.starts_with("http://") || u.starts_with("https://") || u.starts_with("mailto:") {
                        let shown = if u.starts_with("mailto:") { u[7:] } else { u };
                        out.push_str(f"<a href=\"{esc(u)}\">{esc(shown)}</a>");
                        i = k + 1;
                        continue;
                    }
                }
            }
            if c == '&' && is_entity(cs, i, b) {
                out.push('&');
                i += 1;
                continue;
            }
            if c == '*' || c == '_' || c == '~' {
                let r = run(cs, i, b, c);
                let want = if r >= 2 { 2usize } else { 1usize };
                let open = can_open(cs, i, r, c);
                if c == '~' && r != 2 { open = false; }
                if r >= 3 {
                    // `***x***`: the extra delimiter stays literal.
                    out.push(c);
                    i += 1;
                    continue;
                }
                if open {
                    if let e: usize = closer(cs, i + want, b, c, want) {
                        let tag = if c == '~' { "del" } else if want == 2 { "strong" } else { "em" };
                        out.push_str(f"<{tag}>");
                        self.span(cs, i + want, e, out);
                        out.push_str(f"</{tag}>");
                        i = e + want;
                        continue;
                    }
                }
                for _ in 0..r { out.push(c); }
                i += r;
                continue;
            }
            push_esc(out, c);
            i += 1;
        }
    }
}

// ---- tests ----

#[cfg(test)]
fn html_of(src: str) -> str { render(src, |h| h).html }

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

#[test]
fn renders_blocks() {
    expect(html_of("# A `b`\n\ntext *em* **st**\n") == "<h1 id=\"a-b\"><a class=\"anchor\" href=\"#a-b\" aria-hidden=\"true\">#</a>A <code>b</code></h1>\n<p>text <em>em</em> <strong>st</strong></p>\n", "case 1");
    expect(html_of("- a\n  - b\n- c\n") == "<ul>\n<li>a\n<ul>\n<li>b\n</li>\n</ul>\n</li>\n<li>c\n</li>\n</ul>\n", "case 2");
    expect(html_of("| x | y |\n|---|:-:|\n| 1 | 2 |\n").contains("<td style=\"text-align:center\">2</td>"), "case 3");
    expect(html_of("> [!NOTE]\n> hi\n").contains("<div class=\"callout note\">"), "case 4");
    expect(html_of("```rok\nlet x = 1; // c\n```\n").contains("<span class=\"k\">let</span>"), "case 5");
}

#[test]
fn renders_inlines() {
    expect(html_of("snake_case_name and i*, u*") == "<p>snake_case_name and i*, u*</p>\n", "case 6");
    expect(html_of("[a `b`](x.md#y) <https://e.org> a < b & c &lt;") == "<p><a href=\"x.md#y\">a <code>b</code></a> <a href=\"https://e.org\">https://e.org</a> a &lt; b &amp; c &lt;</p>\n", "case 7");
    expect(html_of("[outer [in](a) x](b)") == "<p>[outer <a href=\"a\">in</a> x](b)</p>\n", "case 8");
}

#[test]
fn github_slugs() {
    expect(slug("3.14.10. ? 연산자 — none 조기 반환") == "31410--연산자--none-조기-반환", "case 9");
    expect(slug("점 / 물음표") == "점--물음표", "case 10");
}
