// Standard library API pages (`/std/`) from the library sources: one page
// per public module of `bare` / `core` / `std`, listing its `pub` items
// with their `///` docs. Signatures are shown as written.
//
// A module with more members than one page can carry (`ints`: twelve
// integer types) gives each of its big items a page of its own,
// `<module>/<kind>.<name>.html`, and lists them on the module page.
//
// The sources are scanned by web::apidoc.

use markdown::{Heading, esc};
use web::apidoc::{Item, Module};
use pkg::layout;
use pkg::layout::rel;

/// A page of one item of a split module.
pub struct Sub {
    pub out: str;
    pub title: str;
    pub html: str;
    pub heads: List<Heading>;
    /// Search notes by heading id (see Page::notes).
    pub notes: Dict<str, str>;
}

pub fn collect(lib: str) throws -> List<Module> { try web::apidoc::collect(lib) }

fn md(text: str) -> str {
    if text.trim().is_empty() { return ""; }
    layout::md(text, |h| h, false).html
}

fn summary(doc: str) -> str {
    let t = doc.trim().replace("\n", " ");
    if let k: usize = t.find(". ") { return t[:k + 1]; }
    t
}

fn anchor(it: Item) -> str { it.kind + "." + it.name }

/// Every item and member of `mods`, keyed as the "Added in" badges look
/// them up: `rok::core::iter::trait.Iterator`, `...::trait.Iterator::exact_len`.
pub fn keys(mods: List<Module>) -> Set<str> {
    let out: Set<str> = Set::new();
    for m in mods {
        let all: List<(Item, str)> = List::new();
        for it in m.items {
            if it.kind != "use" { all.push((it, anchor(it))); }
        }
        for it in m.impls { all.push((it, "impl." + it.name)); }
        for (it, id) in all {
            let key = m.path + "::" + id;
            out.insert(key);
            for mb in it.members { out.insert(key + "::" + mb.name); }
        }
    }
    out
}

/// "Added in 0.1.2" for an item or member newer than its docs version's
/// first release; nothing for the rest.
fn badge(since: Dict<str, str>, key: str) -> str {
    if since.contains_key(key) { f"<span class=\"since\">Added in {esc(since[key])}</span>" } else { "" }
}

/// Members on one module page beyond which its big items move out.
const SPLIT_MODULE: usize = 300;
/// An item of a split module with this many members gets its own page.
const SPLIT_ITEM: usize = 20;

fn split(m: Module) -> bool {
    let n = 0usize;
    for it in m.items { n += it.members.len(); }
    for it in m.impls { n += it.members.len(); }
    n > SPLIT_MODULE
}

fn moves_out(m: Module, it: Item) -> bool { split(m) && it.members.len() >= SPLIT_ITEM }

fn sub_out(m: Module, id: str) -> str { m.out[:m.out.len() - ".html".len()] + "/" + id + ".html" }

/// The module page's stand-in for an item on a page of its own.
fn stub_html(m: Module, it: Item, id: str, title: str, since: Dict<str, str>) -> str {
    let href = rel(m.out, sub_out(m, id));
    let out = StrBuf::new();
    out.push_str(f"<section class=\"api-item api-split\" id=\"{esc(id)}\"><h3><a href=\"{href}\">{esc(title)}</a>{badge(since, m.path + "::" + id)}</h3>");
    if !it.sig.is_empty() { out.push_str(f"<pre class=\"sig\"><code>{sig_html(it.sig)}</code></pre>"); }
    let more = if it.traits.len() > 0 { f", {it.traits.len()} trait implementations" } else { "" };
    out.push_str(f"<p class=\"api-more\"><a href=\"{href}\">{it.members.len()} members{more} →</a></p></section>");
    out.to_str()
}

/// A one-line fn signature as highlighted pieces that each stay on one
/// line: the head up to `(`, each parameter, `-> T`, `where ...`. A
/// narrow screen breaks it only between them. Others are highlighted
/// whole.
fn sig_html(sig: str) -> str { sig_named(sig, "") }

/// sig_html with the declared `name` set apart: the name in ink, the
/// modifiers before it (`pub const fn`) quiet.
fn sig_named(sig: str, name: str) -> str {
    if sig.contains("\n") || !sig.contains("fn ") { return rok_syntax::highlight_rok(sig); }
    let fn_at = sig.find("fn ") ?? 0;
    let pieces: List<str> = List::new();
    let seps: List<str> = List::new();
    let cur = StrBuf::new();
    let sep = "";
    let depth = 0;
    let params = false;
    let done = false;
    let skip = false;
    let prev = ' ';
    let pos = 0usize;
    for c in sig.chars() {
        let at = pos;
        pos += c.len_utf8();
        if skip {
            skip = false;
            if c == ' ' { continue; }
        }
        if depth == 0 && done && c == ' ' && (sig[at:].starts_with(" -> ") || sig[at:].starts_with(" where ")) {
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = " ";
            prev = c;
            continue;
        }
        cur.push(c);
        if c == '(' || c == '[' || c == '{' || c == '<' {
            depth += 1;
        } else if c == ')' || c == ']' || c == '}' || (c == '>' && prev != '-') {
            depth -= 1;
        }
        if c == '(' && depth == 1 && !params && !done && at > fn_at {
            params = true;
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = "<wbr>";
        } else if c == ')' && depth == 0 && params {
            params = false;
            done = true;
        } else if c == ',' && depth == 1 && params {
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = " ";
            skip = true;
        }
        prev = c;
    }
    if !cur.is_empty() {
        pieces.push(cur.to_str());
        seps.push(sep);
    }
    let out = StrBuf::new();
    for k in 0..pieces.len() {
        out.push_str(seps[k]);
        let p = pieces[k];
        let at: usize | none = if k == 0 && !name.is_empty() { p.find("fn " + name) } else { none };
        if let i: usize = at {
            let n = i + 3;
            out.push_str(f"<span class=\"nw\"><span class=\"mod\">{esc(p[:n])}</span><span class=\"nm\">{esc(name)}</span>{rok_syntax::highlight_rok(p[n + name.len():])}</span>");
        } else {
            out.push_str(f"<span class=\"nw\">{rok_syntax::highlight_rok(p)}</span>");
        }
    }
    out.to_str()
}

const KINDS: [(str, str); 8] = [
    ("use", "Re-exports"), ("struct", "Structs"), ("enum", "Enums"), ("trait", "Traits"),
    ("type", "Type aliases"), ("fn", "Functions"), ("const", "Constants"), ("static", "Statics"),
];

/// A link to line `line` of `file` (under library/) at `at` (`v0.1.4`,
/// `main`); nothing without a line.
fn src_link(file: str, line: usize, at: str) -> str {
    if line == 0 || file.is_empty() { return ""; }
    f"<a class=\"src\" href=\"https://github.com/rok-lang/rok/blob/{at}/library/{esc(file)}#L{line}\">Source</a>"
}

fn item_html(it: Item, id: str, title: str, heads: List<Heading>, m: Module, since: Dict<str, str>, notes: Dict<str, str>, at: str) -> str {
    let path = m.path;
    let key = path + "::" + id;
    let out = StrBuf::new();
    out.push_str(f"<section class=\"api-item\" id=\"{esc(id)}\"><h3><a href=\"#{esc(id)}\">{esc(title)}</a>{badge(since, key)}{src_link(m.file, it.line, at)}</h3>");
    notes.insert(id, (if it.kind == "impl" { "impl" } else { it.kind }) + "\t" + summary(it.doc).replace("`", ""));
    if !it.sig.is_empty() { out.push_str(f"<pre class=\"sig\"><code>{sig_html(it.sig)}</code></pre>"); }
    out.push_str(md(it.doc));
    if it.members.len() > 0 {
        out.push_str("<ul class=\"members\">");
        for mb in it.members {
            let mid = it.name + "." + mb.name;
            // A member of an item added after it: the item's own badge
            // covers members that came with it.
            let b = if since.contains_key(key) { "" } else { badge(since, key + "::" + mb.name) };
            let is_fn = mb.sig.contains("fn ");
            let code = if is_fn { sig_named(mb.sig, mb.name) } else { sig_html(mb.sig) };
            out.push_str(f"<li id=\"{esc(mid)}\"><div class=\"m-h\"><pre><code>{code}</code></pre>{b}{src_link(m.file, mb.line, at)}</div>{md(mb.doc)}</li>");
            if is_fn {
                heads.push(Heading { level: 3, id: mid, text: f"{path}::{it.name}::{mb.name}" });
                notes.insert(mid, "method\t" + summary(mb.doc).replace("`", ""));
            }
        }
        out.push_str("</ul>");
    }
    if it.traits.len() > 0 {
        out.push_str("<details class=\"impls\"><summary>Trait implementations ");
        out.push_str(f"{it.traits.len()}</summary><ul>");
        for t in it.traits { out.push_str(f"<li><code>{rok_syntax::highlight_rok(t)}</code></li>"); }
        out.push_str("</ul></details>");
    }
    out.push_str("</section>");
    out.to_str()
}

/// A module's leading comment as its intro: the repeated module path
/// dropped, and spec references in parentheses linked to the standard
/// library spec section (`spec` maps `2.9.2` to its page and anchor) or,
/// when they name no section there, dropped.
fn intro(m: Module, spec: Dict<str, str>) -> str {
    let d = m.doc;
    for sep in [" - ", " -- ", ": "] {
        if let r: str = d.strip_prefix(m.path + sep) {
            d = r;
            break;
        }
    }
    let out = StrBuf::new();
    let rest = d;
    loop {
        let k = rest.find("(") ?? rest.len();
        out.push_str(rest[:k]);
        if k == rest.len() { break; }
        rest = rest[k:];
        let e = rest.find(")") ?? 0;
        let inner = if e > 0 { rest[1:e].replace("\n", " ") } else { "" };
        let words: List<str> = List::new();
        for w in inner.split_whitespace() { words.push(w); }
        let num = if words.len() > 0 { words[words.len() - 1].trim_end_matches(".") } else { "" };
        let named = words.len() <= 3 && is_sec(num);
        for k2 in 0..words.len() - (if words.len() > 0 { 1 } else { 0 }) {
            let w = words[k2];
            if !(w == "stdlib" || w == "spec" || w == "refs-lang" || w == "refs-standard-libraries") { named = false; }
        }
        if !named {
            out.push_str("(");
            rest = rest[1:];
            continue;
        }
        let stdlib = !inner.contains("refs-lang");
        let found: str | none = if stdlib { spec.get(num) } else { none };
        if let to: str = found {
            out.push_str(f"([stdlib spec {num}]({rel(m.out, to)}))");
        } else if out.to_str().ends_with(" ") && rest[e + 1:].starts_with(" ") {
            rest = rest[1:];
        }
        rest = rest[e + 1:];
    }
    out.to_str()
}

/// `2.9.2`-like: digits and dots, at least one dot.
fn is_sec(s: str) -> bool {
    if !s.contains(".") || s.starts_with(".") { return false; }
    for c in s.chars() {
        if !(c == '.' || (c >= '0' && c <= '9')) { return false; }
    }
    true
}

/// A module page's body and its section headings (for search / TOC).
pub fn body(m: Module, mods: List<Module>, since: Dict<str, str>, notes: Dict<str, str>, at: str, spec: Dict<str, str>) -> (str, List<Heading>) {
    let heads: List<Heading> = List::new();
    let out = StrBuf::new();
    out.push_str("<h1><code>");
    let parts = segs(m.path);
    let acc = "";
    for k in 0..parts.len() {
        acc = if k == 0 { parts[0] } else { acc + "::" + parts[k] };
        if k > 0 { out.push_str("::<wbr>"); }
        let link = "";
        if let t: Module = find(mods, acc) {
            if k + 1 < parts.len() { link = rel(m.out, t.out); }
        }
        if link.is_empty() {
            out.push_str(esc(parts[k]));
        } else {
            out.push_str(f"<a href=\"{link}\">{esc(parts[k])}</a>");
        }
    }
    out.push_str("</code></h1>");
    out.push_str(md(intro(m, spec)));
    if m.children.len() > 0 {
        out.push_str("<h2 id=\"modules\">Modules</h2><ul class=\"api-list\">");
        heads.push(Heading { level: 2, id: "modules", text: "Modules" });
        for c in m.children {
            if let cm: Module = find(mods, m.path + "::" + c) {
                out.push_str(f"<li><a href=\"{rel(m.out, cm.out)}\"><code>{esc(c)}</code></a> <span>{esc(summary(cm.doc))}</span></li>");
            }
        }
        out.push_str("</ul>");
    }
    for (kind, label) in KINDS {
        let its: List<Item> = List::new();
        for it in m.items {
            if it.kind == kind { its.push(it); }
        }
        if its.len() == 0 { continue; }
        out.push_str(f"<h2 id=\"{kind}\">{label}</h2>");
        heads.push(Heading { level: 2, id: kind, text: label });
        for it in its {
            if kind != "use" { heads.push(Heading { level: 3, id: anchor(it), text: m.path + "::" + it.name }); }
            if moves_out(m, it) {
                out.push_str(stub_html(m, it, anchor(it), it.name, since));
            } else {
                out.push_str(item_html(it, anchor(it), it.name, heads, m, since, notes, at));
            }
        }
    }
    if m.impls.len() > 0 {
        out.push_str("<h2 id=\"impl\">Implementations</h2>");
        heads.push(Heading { level: 2, id: "impl", text: "Implementations" });
        for it in m.impls {
            heads.push(Heading { level: 3, id: "impl." + it.name, text: "impl " + it.name });
            if moves_out(m, it) {
                out.push_str(stub_html(m, it, "impl." + it.name, "impl " + it.name, since));
            } else {
                out.push_str(item_html(it, "impl." + it.name, "impl " + it.name, heads, m, since, notes, at));
            }
        }
    }
    (out.to_str(), heads)
}

/// The pages of `m`'s items that moved out (none unless `m` is split).
pub fn subpages(m: Module, since: Dict<str, str>, at: str) -> List<Sub> {
    let subs: List<Sub> = List::new();
    let all: List<(Item, str, str)> = List::new();
    for it in m.items {
        if it.kind != "use" { all.push((it, anchor(it), it.name)); }
    }
    for it in m.impls { all.push((it, "impl." + it.name, "impl " + it.name)); }
    for (it, id, title) in all {
        if !moves_out(m, it) { continue; }
        let out = sub_out(m, id);
        let heads: List<Heading> = List::new();
        let notes: Dict<str, str> = Dict::new();
        let b = StrBuf::new();
        b.push_str(f"<h1><code><a href=\"{rel(out, m.out)}\">{esc(m.path)}</a>::{esc(title)}</code></h1>");
        b.push_str(item_html(it, id, title, heads, m, since, notes, at));
        subs.push(Sub { out: out, title: m.path + "::" + title, html: b.to_str(), heads: heads, notes: notes });
    }
    subs
}

/// A split module's pages for the sidebar, from page `from`.
pub fn sub_toc(m: Module, from: str) -> str {
    let out = StrBuf::new();
    for s in subpages(m, Dict::new(), "main") {
        let name = s.title[m.path.len() + 2:];
        let cur = if s.out == from { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<li><a{cur} href=\"{rel(from, s.out)}\">{esc(name)}</a></li>");
    }
    out.to_str()
}

fn segs(path: str) -> List<str> {
    let out: List<str> = List::new();
    for p in path.split("::") { out.push(p); }
    out
}

fn find(mods: List<Module>, path: str) -> Module | none {
    for m in mods {
        if m.path == path { return m; }
    }
    none
}

/// Sidebar of page `from`: the modules of `m`'s tier and, on an item's
/// own page, the module's item pages.
pub fn sidebar(m: Module, mods: List<Module>, from: str) -> str {
    let tier = segs(m.path)[1];
    let root = "rok::" + tier;
    let out = StrBuf::new();
    out.push_str(f"<a class=\"up\" href=\"{rel(from, "std/index.html")}\">← Standard library API</a>");
    out.push_str("<ul class=\"pages api-tree\">");
    for q in mods {
        if q.path != root && !q.path.starts_with(root + "::") { continue; }
        let qs = segs(q.path);
        let depth = qs.len() - 2;
        let label = if depth == 0 { q.path } else { qs[depth + 1] };
        let pad = if depth > 1 { f" style=\"--depth:{depth - 1}\"" } else { "" };
        let cur = if q.path == m.path && from == m.out { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<li{pad}><a{cur} href=\"{rel(from, q.out)}\">{esc(label)}</a>");
        if q.path == m.path && from != m.out { out.push_str(f"<ul>{sub_toc(m, from)}</ul>"); }
        out.push_str("</li>");
    }
    out.push_str("</ul>");
    out.to_str()
}

/// "On this page" of an API page: its sections and items, each item's
/// methods under it in alphabetical order.
pub fn toc(heads: List<Heading>) -> str {
    let out = StrBuf::new();
    let methods: List<(str, str)> = List::new();
    let flush = |ms: List<(str, str)>| {
        ms.sort_by(|a, b| a.0.cmp(b.0));
        for (name, id) in ms { out.push_str(f"<li class=\"m\"><a href=\"#{esc(id)}\"><code>{esc(name)}</code></a></li>"); }
        ms.clear();
    };
    for h in heads {
        let name = if h.text.starts_with("impl ") { h.text } else if let k: usize = h.text.rfind("::") { h.text[k + 2:] } else { h.text };
        if h.level == 2 {
            flush(methods);
            out.push_str(f"<li><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
            continue;
        }
        let item = false;
        for k in ["struct.", "enum.", "trait.", "type.", "fn.", "const.", "static.", "impl."] {
            if h.id.starts_with(k) { item = true; }
        }
        if item {
            flush(methods);
            out.push_str(f"<li class=\"sub\"><a href=\"#{esc(h.id)}\"><code>{esc(name)}</code></a></li>");
        } else {
            methods.push((name, h.id));
        }
    }
    flush(methods);
    out.to_str()
}

/// `/std/index.html`: the tiers and their modules.
pub fn index(mods: List<Module>) -> str {
    let out = StrBuf::new();
    out.push_str("<h1>Standard library API</h1>");
    out.push_str("<p>API listing generated from the public items and doc comments of the standard library sources (<code>library/</code>). Behavior and guarantees are defined in the <a href=\"../spec/refs-standard-libraries/index.html\">standard library specification</a>.</p>");
    for (tier, what) in [("bare", "The lowest layer: pointers, memory, FFI"), ("core", "Collections, numbers, iterators, formatting, synchronization, tasks. Available to all code automatically"), ("std", "Files, networking, time, threads, processes, environment, ROKON")] {
        out.push_str(f"<h2 id=\"{tier}\"><code>rok::{tier}</code></h2><p>{what}.</p><ul class=\"api-list\">");
        for q in mods {
            if q.path == "rok::" + tier || q.path.starts_with("rok::" + tier + "::") {
                out.push_str(f"<li><a href=\"{rel("std/index.html", q.out)}\"><code>{esc(q.path)}</code></a> <span>{esc(summary(q.doc))}</span></li>");
            }
        }
        out.push_str("</ul>");
    }
    out.to_str()
}

#[test]
fn signature_pieces() {
    // The head, each parameter, the return type; `fn(T) -> bool` inside a
    // parameter stays whole.
    let h = sig_html("pub fn retain(self, keep: fn(T) -> bool) -> List<T>");
    assert(h.split("class=\"nw\"").count() == 5, h);
    assert(h.contains("<wbr><span") && !h.contains("( ") && !h.contains("<span class=\"nw\"> "), h);
    assert(sig_html("pub struct List<T>").split("class=\"nw\"").count() == 1, "not a fn");
}
