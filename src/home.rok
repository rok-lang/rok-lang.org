// The rok-lang.org landing page.

use rok::std::fs;
use markdown::esc;
use pkg::Site;
use pkg::layout;

/// A program from the docs' examples.
pub struct Example {
    pub title: str;
    pub lead: str;
    pub href: str;
}

/// The changelog section of one release.
struct News {
    date: str;
    items: List<str>;
}

/// Shown first, in this order, when the docs have them.
const PICKS: [str; 8] = ["sudoku", "game-of-life", "interpreter", "tcp-echo", "text-adventure", "csv-report", "word-count", "json-parser"];

const MONTHS: [str; 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

/// "2026-10-29" -> "29 October 2026".
fn long_date(d: str) -> str {
    let p: List<str> = List::new();
    for x in d.split("-") { p.push(x); }
    if p.len() != 3 { return d; }
    let m = try p[1].parse::<usize>() catch _ { return d; };
    let day = try p[2].parse::<usize>() catch _ { return d; };
    if m < 1 || m > 12 { return d; }
    f"{day} {MONTHS[m - 1]} {p[0]}"
}

/// The `## <release> (<date>)` section of CHANGELOG.md, one entry per
/// top-level bullet.
fn news(path: str, release: str) -> News | none {
    let text = try fs::read_to_str(path) catch _ { return none; };
    let head = f"## {release} (";
    let date = "";
    let items: List<str> = List::new();
    let on = false;
    for l in text.lines() {
        if l.starts_with("## ") {
            if on { break; }
            if l.starts_with(head) {
                on = true;
                date = l[head.len():].trim_end_matches(")");
            }
            continue;
        }
        if !on { continue; }
        if l.starts_with("- ") {
            items.push(l[2:]);
        } else if l.starts_with("  ") && items.len() > 0 {
            items[items.len() - 1] = items[items.len() - 1] + " " + l.trim();
        }
    }
    if !on { return none; }
    News { date: date, items: items }
}

/// `#123` in a changelog entry as a link to that issue or pull request
/// (GitHub sends either address to the right one).
fn refs(html: str) -> str {
    let out = StrBuf::new();
    let rest = html;
    loop {
        let k = rest.find("#") ?? rest.len();
        out.push_str(rest[:k]);
        if k == rest.len() { break; }
        let n = 0usize;
        for c in rest[k + 1:].chars() {
            if c < '0' || c > '9' { break; }
            n += 1;
        }
        let before = if k == 0 { ' ' } else { (out.to_str().chars().last() ?? ' ') };
        if n == 0 || !(before == ' ' || before == '(' || before == ',') {
            out.push('#');
            rest = rest[k + 1:];
            continue;
        }
        let num = rest[k + 1:k + 1 + n];
        out.push_str(f"<a href=\"https://github.com/rok-lang/rok/issues/{num}\">#{num}</a>");
        rest = rest[k + 1 + n:];
    }
    out.to_str()
}

/// Inline markdown, without the paragraph.
fn inline(s: str) -> str {
    let h = layout::md(s, |x| x, false).html.trim();
    if h.starts_with("<p>") && h.ends_with("</p>") { h[3:h.len() - 4] } else { h }
}

fn code(src: str) -> str { f"<pre class=\"cb pre\"><code>{rok_syntax::highlight_rok(src)}</code></pre>" }

/// A program of the landing page (home/<name>/) and what `rok run` prints
/// for it (home/<name>.out), both checked in; `rok run -- check` reruns
/// them with the toolchain and fails when the output has changed.
pub struct Sample {
    pub name: str;
    pub src: str;
    pub out: str;
}

pub const SAMPLES: [Sample; 4] = [
    Sample { name: "hello", src: include_str!("../home/hello/src/main.rok"), out: include_str!("../home/hello.out") },
    Sample { name: "describe", src: include_str!("../home/describe/src/main.rok"), out: include_str!("../home/describe.out") },
    Sample { name: "find", src: include_str!("../home/find/src/main.rok"), out: include_str!("../home/find.out") },
    Sample { name: "ages", src: include_str!("../home/ages/src/main.rok"), out: include_str!("../home/ages.out") },
];

fn sample(name: str) -> Sample {
    for s in SAMPLES {
        if s.name == name { return s; }
    }
    SAMPLES[0]
}

/// The line `rok run` points at (`--> src/main.rok:3:13`), or 0.
fn error_line(out: str) -> usize {
    for l in out.lines() {
        if let r: str = l.trim().strip_prefix("--> src/main.rok:") {
            return try (r.split_once(":") ?? (r, "")).0.parse::<usize>() catch _ { 0usize };
        }
    }
    0
}

/// `src` highlighted, one `.ln` per line, line `hl` marked.
fn numbered(src: str, hl: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for l in src.trim_end().split("\n") {
        k += 1;
        let cls = if k == hl { "ln hl" } else { "ln" };
        out.push_str(f"<span class=\"{cls}\">{rok_syntax::highlight_rok(l)}\n</span>");
    }
    // No line break after the last line: it would show as an empty line.
    out.to_str().replace("\n</span>", "</span>").replace("</span><span class=\"ln", "\n</span><span class=\"ln")
}

/// What rokc printed as a terminal transcript in its own colours, after
/// `$ rok run`; each error code links to its page (`docs`).
fn transcript(out: str, docs: fn(str) -> str) -> str {
    let body = pkg::link_codes_in(layout::diag_html(out), |c| docs(f"errors/{c}.html"));
    "<span class=\"p\">$</span> rok run\n" + body
}

/// A program and what rokc says about it: the code with the reported
/// line marked, then the terminal.
fn program(s: Sample, docs: fn(str) -> str, label: str) -> str {
    let hl = error_line(s.out);
    f"<div class=\"cb prog\"><div class=\"cb-h\"><span class=\"t-label\">src/main.rok</span></div><pre class=\"pre\"><code>{numbered(s.src, hl)}</code></pre></div>
<div class=\"term-bar\" aria-hidden=\"true\">~/{s.name}</div><pre class=\"term\" aria-label=\"{label}\">{transcript(s.out, docs)}</pre>"
}

fn feature(title: str, text: str, link: str, label: str, s: Sample, docs: fn(str) -> str) -> str {
    f"<div class=\"feat\"><div class=\"feat-t\"><h3 class=\"t-h3\">{title}</h3><p>{text}</p><a class=\"t-ui\" href=\"{esc(link)}\">{label}</a></div><div class=\"feat-f\">{program(s, docs, "rok run in a terminal: what rokc reports for this program")}</div></div>\n"
}

/// The release archives: (system, triple, note, extension).
const ARCHIVES: [(str, str, str, str); 6] = [
    ("macOS", "aarch64-apple-darwin", "Apple silicon", ".tar.xz"),
    ("Linux", "x86_64-unknown-linux-gnu", "glibc 2.34 or later", ".tar.xz"),
    ("Linux", "aarch64-unknown-linux-gnu", "glibc 2.34 or later", ".tar.xz"),
    ("Linux", "x86_64-unknown-linux-musl", "static, any distribution", ".tar.xz"),
    ("Linux", "aarch64-unknown-linux-musl", "static, any distribution", ".tar.xz"),
    ("Windows", "x86_64-pc-windows-msvc", "Windows 10 or later", ".zip"),
];

/// The landing page's body. `examples` are the docs' examples; the
/// release notes come from the toolchain's CHANGELOG.md, if present.
pub fn body(site: Site, examples: List<Example>, sizes: Dict<str, i64>) -> str {
    let r = site.release;
    let docs = |p: str| esc(layout::latest(site, p));
    let rel_url = f"https://github.com/rok-lang/rok/releases/tag/v{r}";
    let n = news(site.library + "/../CHANGELOG.md", r);
    let out = StrBuf::new();

    // Error codes link to their pages when latest/ has them.
    let to = |p: str| if p.starts_with("errors/") && site.no_errors { "" } else { layout::latest(site, p) };
    let came = if let x: News = n { f"Rok {r} came out on {long_date(x.date)}" } else { f"Rok {r} is out" };
    out.push_str(f"<section class=\"hero\"><div class=\"frame\">
<div class=\"hero-t\">
<a class=\"t-ui news-link\" href=\"{rel_url}\">{came} →</a>
<h1 class=\"t-display\">A compiled language that tells you what to write.</h1>
<p class=\"t-lead\">Rok has closed sum types, no null, and errors in function signatures. When code doesn't compile, the error says what is wrong and, most of the time, what to write instead.</p>
<div class=\"install\">
<div class=\"line mono\"><code>curl -fsSL <span class=\"nw\">https://rok-lang.org/install.sh | sh</span></code>{web::chrome::copy_button("curl -fsSL https://rok-lang.org/install.sh | sh", false)}</div>
<p class=\"t-small\">macOS and Linux. On Windows, use <a href=\"install.ps1\">install.ps1</a> or <a href=\"download.html#archives\">an archive</a>.</p>
</div>
<p class=\"go\"><a class=\"btn\" href=\"{docs("learn/index.html")}\">Read the guide</a><a class=\"t-ui\" href=\"{esc(site.playground)}\">or try it in the browser</a></p>
</div>
<figure class=\"hero-f\">
{program(sample("hello"), to, "rok run in a terminal: an error that says what to write")}
<figcaption class=\"t-small\">rok {esc(r)}. Line 3 after the fix: <code class=\"ic\">println((name ?? \"guest\").len());</code></figcaption>
</figure>
</div></section>
");

    out.push_str("<section class=\"feats\"><div class=\"frame\">\n<h2 class=\"t-h2\">What it checks for you</h2>\n");
    out.push_str(feature("Every case of a sum type", "A value is <code class=\"ic\">i32 | str | bool</code>, and <code class=\"ic\">match</code> has to handle all three. Leave one out, or add a variant later, and the compiler names the case no arm covers.", layout::latest(site, "learn/05-sum-types.html"), "Guide, chapter 5: Sum Types and none", sample("describe"), to));
    out.push_str(feature("Values that may be missing", "There is no null. A value that might not be there has the type <code class=\"ic\">T?</code>, and you say what happens when it isn't: a default with <code class=\"ic\">??</code>, or a branch with <code class=\"ic\">if let</code>.", layout::latest(site, "learn/05-sum-types.html#defaults-with--and-chaining-with-"), "Guide: defaults with ?? and ?.", sample("find"), to));
    out.push_str(feature("Errors you can see coming", "A function that can fail says so with <code class=\"ic\">throws</code>, and every call to it is marked <code class=\"ic\">try</code>. Reading the code, you can see each place an error can come from.", layout::latest(site, "learn/10-errors.html"), "Guide, chapter 10: Error Handling", sample("ages"), to));
    out.push_str("</div></section>\n");

    if examples.len() > 0 {
        let picked: List<Example> = List::new();
        let seen: Set<str> = Set::new();
        for slug in PICKS {
            for e in examples {
                if e.href.ends_with("/" + slug) {
                    picked.push(e);
                    seen.insert(e.href);
                }
            }
        }
        for e in examples {
            if picked.len() >= 8 { break; }
            if !seen.contains(e.href) { picked.push(e); }
        }
        out.push_str(f"<section class=\"progs\"><div class=\"frame\">
<div><h2 class=\"t-h2\">Programs to read</h2><p>{examples.len()} complete programs, each one built and run when the docs are checked.</p><a class=\"t-ui\" href=\"{docs("examples/index.html")}\">All {examples.len()} examples</a></div>
<div class=\"ex-list\">");
        for k in 0..picked.len() {
            if k >= 8 { break; }
            let e = picked[k];
            out.push_str(f"<a class=\"ex\" href=\"{esc(e.href)}\"><b>{esc(e.title)}</b><span>{esc(e.lead)}</span></a>");
        }
        out.push_str("</div>\n</div></section>\n");
    }

    out.push_str(f"<section class=\"get\"><div class=\"frame\">
<div><h2 class=\"t-h2\">Install</h2><p>One toolchain: the compiler with LLVM built in, the package tool, a REPL, a Jupyter kernel and a language server. Nothing else to install.</p>
<pre class=\"cb pre\"><code><span class=\"c\"># macOS, Linux</span>
curl -fsSL https://rok-lang.org/install.sh | sh

<span class=\"c\"># Windows, in PowerShell</span>
powershell -ExecutionPolicy Bypass -c \"irm https://rok-lang.org/install.ps1 | iex\"

<span class=\"c\"># Nix</span>
nix profile install github:rok-lang/rok</code></pre></div>
<div class=\"arc-wrap\"><table class=\"arc\"><caption>Archives for {esc(r)}</caption><tbody>");
    for (os, triple, note, ext) in ARCHIVES {
        let url = f"https://github.com/rok-lang/rok/releases/download/v{r}/rok-{r}-{triple}{ext}";
        let size = if let n: i64 = sizes.get(f"rok-{r}-{triple}{ext}") { f"<span class=\"sz\">{pkg::mb(n)}</span>" } else { "" };
        out.push_str(f"<tr{pkg::os_attrs(triple)}><th scope=\"row\">{os}</th><td class=\"mono\">{triple}</td><td class=\"note\">{note}</td><td><a href=\"{esc(url)}\">{ext}</a>{size}</td></tr>");
    }
    out.push_str("</tbody></table><p class=\"t-small\">Checksums, other formats and cross-compilation targets: <a href=\"download.html\">Download</a>.</p></div>\n</div></section>\n");

    if let x: News = n {
        out.push_str(f"<section class=\"new\"><div class=\"frame\">
<div><h2 class=\"t-h2\">New in {esc(r)}</h2><p class=\"t-small\">{long_date(x.date)}</p><a class=\"t-ui\" href=\"https://github.com/rok-lang/rok/blob/v{r}/CHANGELOG.md\">Full changelog</a></div>
<ul>");
        for k in 0..x.items.len() {
            if k >= 6 { break; }
            out.push_str(f"<li>{refs(inline(x.items[k]))}</li>");
        }
        out.push_str("</ul>\n</div></section>\n");
    }
    out.to_str()
}
