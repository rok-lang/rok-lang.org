// rok-lang.org: builds two static sites into `out` (site.rokon) and
// checks every internal link of both.
//
//   out/www/        rok-lang.org: the landing page (www/index.md), the
//                   download page (www/download.md) and the
//                   installers
//   out/docs/<v>/   docs.rok-lang.org/<v>/: the spec (English at `spec/`,
//                   Korean at `ko/spec/`), the guide and examples (docs/)
//                   and the standard library API, for one version
//   out/docs/       versions.json, index.html (to latest/) and 404.html;
//                   latest/ is a copy of the newest release (versions.rokon)
//
// Other version directories already in out/docs/ are kept, so a deploy
// lays the builds of earlier tags there first.
//
//   rok run [-- --version <v>]   build; <v> is a release ("0.1") or dev
//   rok run -- check             build; run the pages' code blocks; exit 1
//                                on a broken link or a failing block
//   rok run -- code [filter]     only run the code blocks (of pages whose
//                                path contains `filter`)

mod apidoc;
mod check;
mod home;
mod http;
mod layout;
mod serve;

use rok::std::env;
use rok::std::fs;
use rok::std::rokon;
use rok::core::task::time::Instant;
use markdown::Heading;
use layout::{dir_of, rel};

#[derive(Rokon)]
pub struct Site {
    pub title: str;
    pub tagline: str;
    /// The landing page's `<meta name="description">`, and the fallback
    /// for pages without a first paragraph.
    pub description: str = "";
    /// The toolchain release the download page offers.
    pub release: str = "0.1.0";
    /// Where the home site is served.
    pub base_url: str = "https://rok-lang.org";
    /// The playground; docs code blocks open there with "try".
    pub playground: str = "https://playground.rok-lang.org";
    /// Where the docs are served, above the version directories.
    pub docs_url: str = "https://docs.rok-lang.org";
    /// The docs version being built: `--version`, else `dev`.
    pub version: str = "dev";
    /// The newest release. Only its docs open code in the playground,
    /// which runs that release.
    pub newest: str = "";
    /// The spec's English edition (`spec/en`), relative to this file.
    pub spec: str = "../spec/en";
    /// The Korean edition (`spec/ko`), rendered under `ko/`; `""` for none.
    pub spec_ko: str = "";
    /// Where links that leave the spec directory point (`../LICENSE`).
    pub spec_repo: str;
    pub spec_branch: str = "main";
    /// The guide and examples (rok-lang/docs), relative to this file.
    pub docs: str = "../docs";
    /// The home site's pages (rok-lang/www), relative to this file.
    pub www: str = "../www";
    /// rok-lang/docs, for the docs pages' edit links.
    pub repo: str = "https://github.com/rok-lang/docs";
    pub packages: str;
    /// The standard library sources (`bare/src/`, `core/src/`, `std/src/`).
    pub library: str = "../rok/library";
    pub out: str = "public";
    /// The release this build documents (`0.1.2`), and the earlier
    /// releases of its version, oldest first: what the API's "Added in"
    /// badges compare against. Set by `serve` when it archives a release;
    /// empty, no badges.
    pub built_from: str = "";
    pub history: List<Release> = List::new();
}

/// A release and its standard library sources.
#[derive(Rokon)]
pub struct Release {
    pub release: str;
    pub library: str;
}

/// versions.rokon: the released docs versions, newest first.
#[derive(Rokon)]
pub struct Versions {
    pub released: List<str>;
    /// The newest patch release of each, e.g. "0.1" -> "0.1.2".
    pub patches: Dict<str, str> = Dict::new();
}

pub struct Page {
    /// Source path relative to the spec directory; `""` for site pages.
    pub src: str;
    /// Output path relative to the site root.
    pub out: str;
    /// Spec directory of the source (its chapter).
    pub dir: str;
    pub title: str;
    pub html: str;
    pub heads: List<Heading>;
}

/// A doc page's content and navigation without any chrome: enough for the
/// current generator to re-wrap it. Archived per released version so a
/// design change reaches old versions while their content stays pinned.
#[derive(Rokon)]
pub struct Frag {
    pub out: str;
    pub title: str;
    pub side: str;
    pub body: str;
    pub pager: str;
    /// "On this page" items, or `""`.
    pub toc: str = "";
    /// An hreflang `<link>` block to splice before `</head>`, or `""`.
    pub head: str;
}

/// One released version's docs as fragments, plus its search index.
#[derive(Rokon)]
pub struct Bundle {
    pub version: str;
    pub pages: List<Frag>;
    pub search: str;
}

/// Final HTML of a doc page: the current chrome around `f`'s content.
fn wrap(site: Site, f: Frag) -> str {
    let html = layout::page(site, f.out, f.title, f.side, f.toc, f.body, f.pager);
    if f.head.is_empty() { html } else { html.replace("</head>", f.head) }
}

/// `a/./b/../c` -> `a/c`; leading `..` kept.
fn norm(p: str) -> str {
    let segs: List<str> = List::new();
    for s in p.split("/") {
        if s.is_empty() || s == "." { continue; }
        if s == ".." && segs.len() > 0 && segs[segs.len() - 1] != ".." {
            segs.pop();
            continue;
        }
        segs.push(s);
    }
    let out = StrBuf::new();
    for k in 0..segs.len() {
        if k > 0 { out.push('/'); }
        out.push_str(segs[k]);
    }
    out.to_str()
}

fn join(dir: str, p: str) -> str {
    if dir.is_empty() { p } else { dir + "/" + p }
}

/// Output path of a spec source: `x/README.md` -> `spec/x/index.html`.
fn out_of(src: str) -> str {
    if src == "README.md" { return "spec/index.html"; }
    if let s: str = src.strip_suffix("/README.md") { return "spec/" + s + "/index.html"; }
    if let s: str = src.strip_suffix(".md") { return "spec/" + s + ".html"; }
    "spec/" + src
}

fn last_seg(p: str) -> str {
    let t = norm(p);
    if let k: usize = t.rfind("/") { return t[k + 1:]; }
    t
}

/// The `href` for a link written in `src_dir` of the edition in `spec`
/// (output under `prefix`), from the page `out`.
fn spec_link(site: Site, spec: str, prefix: str, href: str, src_dir: str, out: str) -> str {
    if href.starts_with("#") || href.contains("://") || href.starts_with("mailto:") { return href; }
    let path = href;
    let frag = "";
    if let k: usize = href.find("#") {
        path = href[:k];
        frag = href[k:];
    }
    let target = norm(join(src_dir, path));
    if target == ".." || target.starts_with("../") {
        // Outside the language directory: the spec repository.
        let in_repo = norm(last_seg(spec) + "/" + target);
        return f"{site.spec_repo}/blob/{site.spec_branch}/{in_repo}{frag}";
    }
    let file = if target.ends_with(".md") {
        target
    } else if !last_seg(target).contains(".") {
        layout::readme_of(target)
    } else {
        target
    };
    rel(out, prefix + out_of(file)) + frag
}

/// `"3.11.4. Patterns"` -> `"3.11.4."`; `""` if unnumbered.
fn sec_no(t: str) -> str {
    let w = t;
    if let k: usize = t.find(" ") { w = t[:k]; }
    if !w.ends_with(".") { return ""; }
    let first = true;
    for c in w.chars() {
        let ok = if first { c >= '0' && c <= '9' } else { (c >= '0' && c <= '9') || c == '.' || (c >= 'a' && c <= 'z') };
        if !ok { return ""; }
        first = false;
    }
    w
}

/// Heading ids of `a` paired with those of `b` as `"a1 b1 a2 b2 ..."`:
/// by position when the outlines match, else by section number (an
/// unnumbered heading goes to its numbered section).
fn sec_map(a: List<Heading>, b: List<Heading>) -> str {
    let same = a.len() == b.len();
    for k in 0..a.len() {
        if !same { break; }
        if sec_no(a[k].text) != sec_no(b[k].text) { same = false; }
    }
    let by: Dict<str, str> = Dict::new();
    for h in b {
        let n = sec_no(h.text);
        if !n.is_empty() && (by.get(n) ?? "").is_empty() { by.insert(n, h.id); }
    }
    let out = StrBuf::new();
    let last = "";
    for k in 0..a.len() {
        let n = sec_no(a[k].text);
        if !n.is_empty() { last = by.get(n) ?? ""; }
        let to = if same { b[k].id } else { last };
        if to.is_empty() { continue; }
        if !out.is_empty() { out.push(' '); }
        out.push_str(a[k].id + " " + to);
    }
    out.to_str()
}

/// EN / Korean switch for spec page `p`, linking to the same page of the
/// other edition (`others`); search.js carries the reader's section over.
fn lang_switch(p: Page, others: List<Page>, ko: bool) -> str {
    if others.len() == 0 { return ""; }
    let q = others[0];
    let sec = "";
    for o in others {
        if o.src == p.src {
            q = o;
            sec = sec_map(p.heads, o.heads);
        }
    }
    let href = rel(p.out, q.out);
    let en = if ko { f"<a href=\"{href}\" hreflang=\"en\" lang=\"en\">EN</a>" } else { "<span aria-current=\"true\">EN</span>" };
    let kr = if ko { "<span aria-current=\"true\">한국어</span>" } else { f"<a href=\"{href}\" hreflang=\"ko\" lang=\"ko\">한국어</a>" };
    f"<nav class=\"lang-switch\" aria-label=\"Language\" data-sec=\"{markdown::esc(sec)}\">{en}<span aria-hidden=\"true\"> · </span>{kr}</nav>\n"
}

/// The edit link of spec page `p` of the edition in `spec`.
fn spec_edit(site: Site, spec: str, p: Page) -> str {
    layout::edit_link(f"{site.spec_repo}/blob/{site.spec_branch}/{last_seg(spec)}/{p.src}", p.out.starts_with("ko/"))
}

/// The edit link of docs page `p` (docs/).
fn docs_edit(site: Site, p: Page) -> str {
    layout::edit_link(f"{site.repo}/blob/{docs_branch(site)}/{p.src.replace("README.md", "index.md")}", false)
}

fn spec_root(dir: str) -> str {
    let d = norm(dir);
    if dir.starts_with("/") { d = "/" + d; }
    d
}

/// The spec edition in `spec`, rendered under `prefix` (`""`, `"ko/"`).
fn spec_pages(site: Site, spec: str, prefix: str, ko: bool) throws -> List<Page> {
    let srcs: List<str> = List::new();
    for entry in fs::walk(spec) {
        let e = try entry.get();
        let p = e.path().as_str();
        if e.is_file() && p.ends_with(".md") { srcs.push(p[spec.len() + 1:]); }
    }
    sort_sources(srcs);
    let pages: List<Page> = List::new();
    for src in srcs {
        let out = prefix + out_of(src);
        let dir = dir_of(src);
        let text = try fs::read_to_str(spec + "/" + src);
        let doc = layout::md(text, |h| spec_link(site, spec, prefix, h, dir, out), ko);
        let title = if doc.title.is_empty() { src } else { doc.title };
        pages.push(Page { src: src, out: out, dir: dir, title: title, html: doc.html, heads: doc.headings });
    }
    pages
}

/// README first within each directory, then by name.
fn sort_key(src: str) -> str { src.replace("README.md", "!") }

fn sort_sources(xs: List<str>) {
    for i in 1..xs.len() {
        let x = xs[i];
        let j = i;
        while j > 0 && sort_key(xs[j - 1]) > sort_key(x) {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[j] = x;
    }
}

fn json_str(s: str) -> str {
    let out = StrBuf::new();
    out.push('"');
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if (c as u32) < 0x20u32 {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out.to_str()
}

fn write(root: str, path: str, data: str) throws {
    let full = root + "/" + path;
    try fs::create_dir_all(dir_of(full));
    try fs::write(full, data);
}

/// Every value of `name="..."` in `html`.
fn attr_values(cs: List<char>, name: str) -> List<str> {
    let pat: List<char> = List::new();
    for c in name.chars() { pat.push(c); }
    pat.push('=');
    pat.push('"');
    let out: List<str> = List::new();
    let n = cs.len();
    let m = pat.len();
    let i = 0usize;
    while i + m <= n {
        let hit = i == 0 || cs[i - 1] == ' ';
        let k = 0usize;
        while hit && k < m {
            if cs[i + k] != pat[k] { hit = false; }
            k += 1;
        }
        if !hit {
            i += 1;
            continue;
        }
        let v = StrBuf::new();
        let j = i + m;
        while j < n && cs[j] != '"' {
            v.push(cs[j]);
            j += 1;
        }
        out.push(v.to_str().replace("&quot;", "\"").replace("&amp;", "&"));
        i = j;
    }
    out
}

fn chars_of(s: str) -> List<char> {
    let cs: List<char> = List::new();
    for c in s.chars() { cs.push(c); }
    cs
}

/// Drop `.html` from an internal href target (`index.html` -> its directory).
/// External, mailto and anchor-only hrefs are left alone.
fn clean_one(href: str) -> str {
    if href.contains("://") || href.starts_with("mailto:") || href.starts_with("#") || href.is_empty() { return href; }
    let path = href;
    let frag = "";
    if let k: usize = href.find("#") { path = href[:k]; frag = href[k:]; }
    let clean = if path.ends_with("/index.html") {
        path[:path.len() - "index.html".len()]
    } else if path == "index.html" {
        "./"
    } else if path.ends_with(".html") {
        path[:path.len() - ".html".len()]
    } else {
        path
    };
    clean + frag
}

/// Rewrite every `href="..."` to its extensionless form. Output files keep
/// their `.html` names; the server / Pages resolve the clean paths. The link
/// check runs on the uncleaned pages, so it still verifies `.html` targets.
fn clean_hrefs(html: str) -> str {
    let cs = chars_of(html);
    let n = cs.len();
    let out = StrBuf::new();
    let i = 0usize;
    while i < n {
        let hit = cs[i] == 'h' && i + 6 <= n && (i == 0 || cs[i - 1] == ' ')
            && cs[i + 1] == 'r' && cs[i + 2] == 'e' && cs[i + 3] == 'f' && cs[i + 4] == '=' && cs[i + 5] == '"';
        if !hit {
            out.push(cs[i]);
            i += 1;
            continue;
        }
        out.push_str("href=\"");
        let j = i + 6;
        let v = StrBuf::new();
        while j < n && cs[j] != '"' {
            v.push(cs[j]);
            j += 1;
        }
        out.push_str(clean_one(v.to_str()));
        out.push('"');
        i = if j < n { j + 1 } else { j };
    }
    out.to_str()
}

/// Broken internal `href` / `src` targets (missing file or anchor).
fn check(files: Dict<str, str>, statics: Set<str>) -> List<str> {
    let ids: Dict<str, Set<str>> = Dict::new();
    let refs: Dict<str, List<str>> = Dict::new();
    for out in files.keys() {
        let cs = chars_of(files[out]);
        let s: Set<str> = Set::new();
        for id in attr_values(cs, "id") { s.insert(id); }
        ids.insert(out, s);
        let r = attr_values(cs, "href");
        r.extend(attr_values(cs, "src"));
        refs.insert(out, r);
    }
    let bad: List<str> = List::new();
    for out in files.keys() {
        for href in refs[out] {
            if href.contains("://") || href.starts_with("mailto:") || href == "#" { continue; }
            let path = href;
            let frag = "";
            if let k: usize = href.find("#") {
                path = href[:k];
                frag = href[k + 1:];
            }
            let target = if path.is_empty() { out } else { norm(join(dir_of(out), path)) };
            if let s: Set<str> = ids.get(target) {
                if !frag.is_empty() && !s.contains(frag) { bad.push(f"{out}: {href} (no anchor)"); }
            } else if !statics.contains(target) {
                bad.push(f"{out}: {href} (no page)");
            }
        }
    }
    bad
}

/// `<docs>/**.md`, sorted (each directory's `index.md` first); the
/// repository's own files are not pages.
fn page_sources(root: str) throws -> List<str> {
    let srcs: List<str> = List::new();
    for entry in fs::walk(root) {
        let e = try entry.get();
        let p = e.path().as_str()[root.len() + 1:];
        if !e.is_file() || !p.ends_with(".md") || p.starts_with(".") { continue; }
        if p == "README.md" || p == "CODE_OF_CONDUCT.md" || p == "SECURITY.md" || p == "CONTRIBUTING.md" { continue; }
        srcs.push(p);
    }
    for k in 0..srcs.len() { srcs[k] = srcs[k].replace("index.md", "README.md"); }
    sort_sources(srcs);
    for k in 0..srcs.len() { srcs[k] = srcs[k].replace("README.md", "index.md"); }
    srcs
}

fn code_check(filter: str) throws -> List<str> {
    let snips: List<check::Snippet> = List::new();
    let paths: List<str> = List::new();
    let site = try load_site();
    for src in try page_sources(site.docs) { paths.push(site.docs + "/" + src); }
    paths.push(site.www + "/index.md");
    paths.push(site.www + "/download.md");
    for page in paths {
        if !page.contains(filter) { continue; }
        snips.extend(check::extract(page, try fs::read_to_str(page)));
    }
    let rokc = try env::var("ROKC") catch _ { "rokc" };
    // Outside this package: `rokc run` looks upward for a package.
    let bad = try check::check_all(rokc, env::temp_dir().as_str() + "/rok-lang.org-snippets", snips);
    let run = 0usize;
    for s in snips {
        if s.mode != "norun" { run += 1; }
    }
    for b in bad { eprint(f"code block: {b}"); }
    println(f"{run} code blocks checked ({snips.len() - run} norun), {bad.len()} failing");
    bad
}

/// `site.rokon`, with the fields of `site.local.rokon` (git-ignored,
/// for a machine whose checkouts are not siblings), or of the file
/// $ROK_SITE_LOCAL names (the server's builds), laid over it.
fn load_site() throws -> Site {
    let base = try rokon::parse(try fs::read_to_str("site.rokon"));
    let local_path = try env::var("ROK_SITE_LOCAL") catch _ { "site.local.rokon" };
    if fs::exists(local_path) {
        let local = try rokon::parse(try fs::read_to_str(local_path));
        if let rokon::Value::Struct { name: _, fields } = base {
            if let rokon::Value::Struct { name: _, fields: over } = local {
                for (k, v) in over.entries() { fields.insert(k, v); }
            }
        }
    }
    try rokon::decode(base, "site.rokon")
}

fn sitemap(urls: List<str>) -> str {
    let b = StrBuf::new();
    b.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
    for u in urls { b.push_str(f"<url><loc>{markdown::esc(u)}</loc></url>\n"); }
    b.push_str("</urlset>\n");
    b.to_str()
}

/// For the "Added in" badges: each API item and member that the first
/// release of `site.history` lacks, mapped to the release that added it.
fn added_in(site: Site, mods: List<apidoc::Module>) throws -> Dict<str, str> {
    let since: Dict<str, str> = Dict::new();
    if site.history.len() == 0 || site.built_from.is_empty() { return since; }
    let seen = apidoc::keys(try apidoc::collect(site.history[0].library));
    for h in site.history[1..] {
        for k in apidoc::keys(try apidoc::collect(h.library)) {
            if !seen.contains(k) {
                since.insert(k, h.release);
                seen.insert(k);
            }
        }
    }
    for k in apidoc::keys(mods) {
        if !seen.contains(k) { since.insert(k, site.built_from); }
    }
    since
}

/// The rok-lang/docs branch a build documents: `main` for dev, else the
/// newest patch of the version (`v0.1.4`).
fn docs_branch(site: Site) -> str {
    if site.version == "dev" || site.built_from.is_empty() { "main" } else { "v" + site.built_from }
}

/// versions.rokon, or the file $ROK_VERSIONS names (the server's builds).
fn load_versions() throws -> Versions {
    let path = try env::var("ROK_VERSIONS") catch _ { "versions.rokon" };
    try rokon::decode(try rokon::parse(try fs::read_to_str(path)), path)
}

/// The names under static/, without copying (for the link check).
fn static_names() throws -> Set<str> {
    let names: Set<str> = Set::new();
    for entry in fs::walk("static") {
        let e = try entry.get();
        if e.is_file() { names.insert(e.path().as_str()["static/".len():]); }
    }
    names
}

/// Copies static/ into `dir`; the copied names.
fn copy_static(dir: str) throws -> Set<str> {
    let names: Set<str> = Set::new();
    for entry in fs::walk("static") {
        let e = try entry.get();
        if !e.is_file() { continue; }
        let name = e.path().as_str()["static/".len():];
        try fs::create_dir_all(dir_of(dir + "/" + name));
        try fs::copy(e.path(), dir + "/" + name);
        names.insert(name);
    }
    names
}

fn copy_tree(from: str, to: str) throws {
    if fs::exists(to) { try fs::remove_dir_all(to); }
    for entry in fs::walk(from) {
        let e = try entry.get();
        if !e.is_file() { continue; }
        let dest = to + e.path().as_str()[from.len():];
        try fs::create_dir_all(dir_of(dest));
        try fs::copy(e.path(), dest);
    }
}

/// A version is `dev`, a minor (`0.1`, whose patch releases share one
/// build) or a patch release (`0.1.4`, the server's builds).
fn is_version(v: str) -> bool {
    if v == "dev" { return true; }
    let dots = 0usize;
    let digits = 0usize;
    for c in v.chars() {
        if c == '.' {
            if digits == 0 { return false; }
            dots += 1;
            digits = 0;
        } else if c >= '0' && c <= '9' {
            digits += 1;
        } else {
            return false;
        }
    }
    (dots == 1 || dots == 2) && digits > 0
}

fn usage() {
    eprintln("usage: rok run [-- [check] [--version <major.minor> | --version dev] | -- code [filter] | -- archive <major.minor> <dir>]");
    env::exit(2);
}

fn main() throws {
    let t0 = Instant::now();
    let args = env::args();
    if args.len() > 1 && args[1] == "serve" {
        try serve::run();
        return;
    }
    if args.len() > 1 && args[1] == "code" {
        let bad = try code_check(if args.len() > 2 { args[2] } else { "" });
        if bad.len() > 0 { env::exit(1); }
        return;
    }
    let strict = false;
    let version = "dev";
    let archive_out = "";
    let k = 1usize;
    while k < args.len() {
        if args[k] == "check" {
            strict = true;
        } else if args[k] == "--version" && k + 1 < args.len() {
            version = args[k + 1];
            k += 1;
        } else if args[k] == "archive" && k + 2 < args.len() {
            version = args[k + 1];
            archive_out = args[k + 2];
            k += 2;
        } else {
            usage();
        }
        k += 1;
    }
    if !is_version(version) {
        eprintln(f"error: `--version {version}`: write a release as <major>.<minor> (`--version 0.1`) or <major>.<minor>.<patch>, or `--version dev`");
        env::exit(2);
    }
    let site = try load_site();
    site.version = version;
    let vs = try load_versions();
    let newest = if vs.released.len() > 0 { vs.released[0] } else { "" };
    site.newest = newest;
    if version != "dev" && !vs.released.contains(version) {
        eprintln(f"note: {version} is not in versions.rokon, so the version menu will not list it");
    }
    let out_root = site.out;

    let pages = try spec_pages(site, spec_root(site.spec), "", false);
    let ko_pages: List<Page> = if site.spec_ko.is_empty() { List::new() } else { try spec_pages(site, spec_root(site.spec_ko), "ko/", true) };

    let ko_outs: Set<str> = Set::new();
    for p in ko_pages { ko_outs.insert(p.out); }
    // Each doc page as a chrome-less fragment, keyed by output path; the
    // current chrome is applied in `wrap`, so a released version's archived
    // fragments re-wrap with it too.
    let frags: Dict<str, Frag> = Dict::new();
    for k in 0..pages.len() {
        let p = pages[k];
        frags.insert(p.out, Frag { out: p.out, title: p.title, side: layout::sidebar(pages, k), toc: layout::toc(p), body: lang_switch(p, ko_pages, false) + p.html + spec_edit(site, site.spec, p), pager: layout::pager(pages, k), head: "" });
    }
    for k in 0..ko_pages.len() {
        let p = ko_pages[k];
        frags.insert(p.out, Frag { out: p.out, title: p.title, side: layout::sidebar(ko_pages, k), toc: layout::toc(p), body: lang_switch(p, pages, true) + p.html + spec_edit(site, site.spec_ko, p), pager: layout::pager(ko_pages, k), head: "" });
    }

    // Each spec page names its other edition for search engines.
    for p in pages {
        let ko = "ko/" + p.out;
        if !ko_outs.contains(ko) { continue; }
        let alt = f"<link rel=\"alternate\" hreflang=\"en\" href=\"{markdown::esc(layout::latest(site, p.out))}\">\n<link rel=\"alternate\" hreflang=\"ko\" href=\"{markdown::esc(layout::latest(site, ko))}\">\n</head>";
        let fe = frags[p.out];
        fe.head = alt;
        frags.insert(p.out, fe);
        let fk = frags[ko];
        fk.head = alt;
        frags.insert(ko, fk);
    }

    // The docs' own pages: `docs/x.md` -> `x.html`; a directory
    // (`docs/learn/`) is a chapter with its own sidebar and pager.
    let own: List<Page> = List::new();
    for src in try page_sources(site.docs) {
        let doc = layout::md(try fs::read_to_str(site.docs + "/" + src), |h| h, false);
        let key = src.replace("index.md", "README.md");
        own.push(Page { src: key, out: src.replace(".md", ".html"), dir: dir_of(src), title: doc.title, html: doc.html, heads: doc.headings });
    }
    for k in 0..own.len() {
        let p = own[k];
        if p.dir.is_empty() {
            let side = if p.out == "index.html" { "" } else { layout::page_toc(p) };
            let toc = if p.out == "index.html" { "" } else { layout::toc(p) };
            frags.insert(p.out, Frag { out: p.out, title: p.title, side: side, toc: toc, body: p.html + docs_edit(site, p), pager: "", head: "" });
            continue;
        }
        let group: List<Page> = List::new();
        let at = 0usize;
        for q in own {
            if q.dir == p.dir {
                if q.out == p.out { at = group.len(); }
                group.push(q);
            }
        }
        let html = if p.dir == "learn" { layout::chapter(p.html, p.title) } else { p.html };
        let body = (if at == 0 { html + layout::contents(group) } else { html }) + docs_edit(site, p);
        frags.insert(p.out, Frag { out: p.out, title: p.title, side: layout::sidebar(group, at), toc: layout::toc(p), body: body, pager: layout::pager(group, at), head: "" });
    }

    // Standard library API: `std/<tier>/<module>.html`.
    let api: List<Page> = List::new();
    let mods = try apidoc::collect(site.library);
    let since = try added_in(site, mods);
    for m in mods {
        let (html, heads) = apidoc::body(m, mods, since);
        frags.insert(m.out, Frag { out: m.out, title: m.path, side: apidoc::sidebar(m, mods, m.out), toc: apidoc::toc(heads), body: html, pager: "", head: "" });
        for s in apidoc::subpages(m, since) {
            frags.insert(s.out, Frag { out: s.out, title: s.title, side: apidoc::sidebar(m, mods, s.out), toc: apidoc::toc(s.heads), body: s.html, pager: "", head: "" });
            api.push(Page { src: "", out: s.out, dir: "std", title: s.title, html: "", heads: s.heads });
        }
        api.push(Page { src: "", out: m.out, dir: "std", title: m.path, html: "", heads: heads });
    }
    frags.insert("std/index.html", Frag { out: "std/index.html", title: "Standard library API", side: "", body: apidoc::index(mods), pager: "", head: "" });

    // Search index: every page and its `##` / `###` sections (the
    // English spec only).
    // A heading many pages share ("Code", "Walkthrough") is named by its
    // page in the results.
    let seen: Dict<str, usize> = Dict::new();
    for group in [own, pages, api] {
        for p in group {
            for h in p.heads { seen.insert(h.text, (seen.get(h.text) ?? 0usize) + 1); }
        }
    }
    // Each page is written once: {"p": [[title, url]], "h": [[page,
    // heading, id] or [page, heading, id, 1] when named by its page]}.
    let pl = StrBuf::new();
    let hl = StrBuf::new();
    let n = 0usize;
    for group in [own, pages, api] {
        for p in group {
            if p.out == "index.html" { continue; }
            if n > 0 { pl.push_str(",\n"); }
            pl.push_str(f"[{json_str(p.title)},{json_str(p.out)}]");
            for h in p.heads {
                if h.level == 2 || h.level == 3 {
                    let named = if (seen.get(h.text) ?? 0usize) >= 4 { ",1" } else { "" };
                    if !hl.is_empty() { hl.push_str(",\n"); }
                    hl.push_str(f"[{n},{json_str(h.text)},{json_str(h.id)}{named}]");
                }
            }
            n += 1;
        }
    }
    let idx = StrBuf::new();
    idx.push_str(f"{{\"p\":[\n{pl.to_str()}],\n\"h\":[\n{hl.to_str()}]}}\n");

    // This version's pages, with the current chrome.
    let files: Dict<str, str> = Dict::new();
    for out in frags.keys() { files.insert(out, wrap(site, frags[out])); }

    // `archive` mode: emit this version's content as a bundle for a later
    // deploy to re-wrap with the chrome of the day, instead of writing HTML.
    // The link check still runs, so a release with a broken link is caught.
    if !archive_out.is_empty() {
        let abad = check(files, try static_names());
        for b in abad { eprintln(f"broken link: {b}"); }
        if abad.len() > 0 { env::exit(1); }
        let outs: List<str> = List::new();
        for o in frags.keys() { outs.push(o); }
        outs.sort();
        let fl: List<Frag> = List::new();
        for o in outs { fl.push(frags[o]); }
        try write(archive_out, "bundle.rokon", rokon::to_string(Bundle { version: version, pages: fl, search: idx.to_str() }));
        println(f"archived docs {version}: {fl.len()} pages → {archive_out}/bundle.rokon ({t0.elapsed():?})");
        return;
    }

    // The home site: the landing page links into the newest docs with
    // `docs:<path>`.
    let www: Dict<str, str> = Dict::new();
    let examples: List<home::Example> = List::new();
    for p in own {
        if p.out.starts_with("examples/") && p.out != "examples/index.html" {
            examples.push(home::Example { title: p.title, lead: layout::lead_text(p.html), href: layout::latest(site, p.out) });
        }
    }
    // `{release}` in its pages is the release the download page offers.
    let www_urls: List<str> = List::new();
    for name in ["index", "download", "roadmap"] {
        let text = (try fs::read_to_str(f"{site.www}/{name}.md")).replace("{release}", site.release);
        let doc = layout::md(text, |h| if h.starts_with("docs:") { layout::latest(site, h["docs:".len():]) } else { h }, false);
        // Raw HTML blocks are not seen by the link mapper.
        let html = doc.html.replace("href=\"docs:", "href=\"" + layout::latest(site, "")).replace("href=\"play:", "href=\"" + site.playground + "/");
        let out = name + ".html";
        let body = if name == "index" { home::body(site, examples) } else { html };
        www.insert(out, layout::www_page(site, out, doc.title, body));
        www_urls.push(site.base_url + "/" + if name == "index" { "" } else { out });
    }
    www.insert("404.html", layout::www_page(site, "404.html", "Page not found", layout::not_found(|p| layout::latest(site, p), false)));

    let docs_root = out_root + "/docs";
    let docs_dir = docs_root + "/" + version;
    let www_dir = out_root + "/www";
    for d in [docs_dir, www_dir] {
        if fs::exists(d) { try fs::remove_dir_all(d); }
    }
    for out in files.keys() { try write(docs_dir, out, clean_hrefs(files[out])); }
    try write(docs_dir, "search-index.json", idx.to_str());
    let statics = try copy_static(docs_dir);
    statics.insert("search-index.json");
    for out in www.keys() { try write(www_dir, out, clean_hrefs(www[out])); }
    let www_statics = try copy_static(www_dir);
    // The installers, served at /install.sh and /install.ps1, come from the toolchain checkout.
    for f in ["install.sh", "install.ps1"] {
        try fs::copy(site.library + "/../" + f, www_dir + "/" + f);
        www_statics.insert(f);
    }

    // Released versions other than the one built now: re-wrap their
    // archived fragments with the current chrome, so a design change reaches
    // them while their content stays pinned. `serve` archives each release
    // once and points ROK_DOCS_ARCHIVE at the archive.
    let arch_bad: List<str> = List::new();
    let archive = try env::var("ROK_DOCS_ARCHIVE") catch _ { "" };
    if !archive.is_empty() {
        for v in vs.released {
            if v == version { continue; }
            let bpath = f"{archive}/{v}/bundle.rokon";
            if !fs::exists(bpath) { continue; }
            let b: Bundle = try rokon::decode(try rokon::parse(try fs::read_to_str(bpath)), bpath);
            site.version = v;
            let vdir = docs_root + "/" + v;
            if fs::exists(vdir) { try fs::remove_dir_all(vdir); }
            let vfiles: Dict<str, str> = Dict::new();
            for f in b.pages { vfiles.insert(f.out, wrap(site, f)); }
            for out in vfiles.keys() { try write(vdir, out, clean_hrefs(vfiles[out])); }
            try write(vdir, "search-index.json", b.search);
            let vstatics = try copy_static(vdir);
            vstatics.insert("search-index.json");
            for bd in check(vfiles, vstatics) { arch_bad.push(f"[{v}] {bd}"); }
            println(f"docs {v}: {b.pages.len()} pages re-wrapped from archive → {vdir}/");
        }
        site.version = version;
    }

    // Above the versions: the version list for the menu, a redirect to
    // latest/, and the 404 page (which borrows latest/'s files).
    let list = StrBuf::new();
    let patches = StrBuf::new();
    for v in vs.released {
        if !list.is_empty() { list.push(','); }
        list.push_str(json_str(v));
        if vs.patches.contains_key(v) {
            if !patches.is_empty() { patches.push(','); }
            patches.push_str(f"{json_str(v)}:{json_str(vs.patches[v])}");
        }
    }
    try write(docs_root, "versions.json", f"{{\"latest\":{json_str(newest)},\"released\":[{list.to_str()}],\"patches\":{{{patches.to_str()}}}}}\n");
    try write(docs_root, "index.html", layout::to_latest(site));
    try write(docs_root, "robots.txt", f"User-agent: *\nDisallow: /dev/\nSitemap: {site.docs_url}/sitemap.xml\n");
    try write(www_dir, "robots.txt", f"User-agent: *\nAllow: /\nSitemap: {site.base_url}/sitemap.xml\n");
    try write(www_dir, ".well-known/security.txt", f"Contact: mailto:security@rok-lang.org\nExpires: 2027-10-24T00:00:00.000Z\nPreferred-Languages: en, ko\nCanonical: {site.base_url}/.well-known/security.txt\nPolicy: https://github.com/rok-lang/rok/blob/main/SECURITY.md\n");
    try write(www_dir, "sitemap.xml", sitemap(www_urls));
    // The sitemap lists latest/, so the build of that version writes it.
    if version == newest {
        let urls: List<str> = List::new();
        for out in files.keys() {
            if out != "404.html" { urls.push(layout::latest(site, if out == "index.html" { "" } else { out })); }
        }
        urls.sort();
        try write(docs_root, "sitemap.xml", sitemap(urls));
    }
    // latest/ follows the newest release, whether built now or laid in
    // from the archive.
    let latest_from = docs_root + "/" + newest;
    let has_latest = !newest.is_empty() && fs::exists(latest_from);
    if has_latest { try copy_tree(latest_from, docs_root + "/latest"); }
    // The 404 page uses latest/'s files, so it speaks for that version.
    site.version = if newest.is_empty() { version } else { newest };
    try write(docs_root, "404.html", clean_hrefs(layout::page(site, "404.html", "Page not found", "", "", layout::not_found(|p| "/latest/" + p, true), "")));

    let bad = check(files, statics);
    for b in check(www, www_statics) { bad.push("www/" + b); }
    for b in arch_bad { bad.push(b); }
    for b in bad { eprintln(f"broken link: {b}"); }
    let latest_note = if has_latest { ", latest/ = " + newest } else { "" };
    println(f"docs {version}: {pages.len()} + {ko_pages.len()} (ko) spec pages + {own.len()} guide pages + {api.len()} API pages → {docs_dir}/ ({files.len()} html){latest_note}; home → {www_dir}/; {bad.len()} broken links, {t0.elapsed():?}");
    if !has_latest && !newest.is_empty() {
        eprintln(f"note: no {docs_root}/{newest}/, so no latest/: build it with `--version {newest}`, or point ROK_DOCS_ARCHIVE at an archive");
    }
    if strict {
        let failing = try code_check("");
        println(f"checked in {t0.elapsed():?}");
        if bad.len() > 0 || failing.len() > 0 { env::exit(1); }
    }
}
