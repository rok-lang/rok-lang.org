// rok-lang.org: builds two static sites into `out` (site.rokon) and
// checks every internal link of both.
//
//   out/www/        rok-lang.org: the landing page (www/index.md), the
//                   download page (www/download.md) and the
//                   installers
//   out/docs/<v>/   docs.rok-lang.org/<v>/: the spec (English at `spec/`,
//                   Korean at `ko/spec/`), the guide and examples (docs/)
//                   and the standard library API, for one version
//   out/docs/       versions.json, index.html (to latest/) and 404.html
//                   (each version directory has its own too);
//                   latest/ is the newest release (versions.rokon) again
//
// Every link is written as a canonical root-relative address (web::url),
// so each version directory, latest/ included, links within itself.
//
// Other version directories already in out/docs/ are kept, so a deploy
// lays the builds of earlier tags there first.
//
//   rok run [-- --version <v>]   build; <v> is a release ("0.1") or dev
//   rok run -- check             build; run the pages' code blocks; exit 1
//                                on a broken link or a failing block
//   rok run -- code [filter]     only run the code blocks (of pages whose
//                                path contains `filter`)
//   rok run -- home              rewrite home/<name>.out, what `rok run`
//                                prints for the landing page's programs

mod apidoc;
mod check;
mod home;
mod layout;
mod serve;

use rok::std::env;
use rok::std::fs;
use rok::std::process::{Command, Stdio};
use rok::std::rokon;
use rok::core::crypto::HashAlgorithm;
use rok::core::encoding;
use rok::core::task::time::Instant;
use markdown::Heading;
use layout::{dir_of, rel};
use web::chrome;
use web::kit;
use web::url;

#[derive(Rokon)]
pub struct Site {
    pub title: str;
    pub tagline: str;
    /// The landing page's `<meta name="description">`, and the fallback
    /// for pages without a first paragraph.
    pub description: str = "";
    /// The toolchain release the home and download pages offer: the
    /// newest in versions.rokon.
    pub release: str = "";
    /// Where the home site is served.
    pub base_url: str = "https://rok-lang.org";
    /// The playground; docs code blocks open there with "try".
    pub playground: str = "https://playground.rok-lang.org";
    /// Where the docs are served, above the version directories.
    pub docs_url: str = "https://docs.rok-lang.org";
    /// The docs version being built: `--version`, else `dev`.
    pub version: str = "dev";
    /// The newest release. Only its docs open code in the playground,
    /// which runs that release.
    pub newest: str = "";
    /// Its newest patch release (`0.1.4`), for the banner of other versions.
    pub newest_release: str = "";
    /// The spec's English edition (`spec/en`), relative to this file.
    pub spec: str = "../spec/en";
    /// The Korean edition (`spec/ko`), rendered under `ko/`; `""` for none.
    pub spec_ko: str = "";
    /// Where links that leave the spec directory point (`../LICENSE`).
    pub spec_repo: str;
    pub spec_branch: str = "main";
    /// The guide and examples (rok-lang/docs), relative to this file.
    pub docs: str = "../docs";
    /// The home site's pages (rok-lang/www), relative to this file.
    pub www: str = "../www";
    /// rok-lang/docs, for the docs pages' edit links.
    pub repo: str = "https://github.com/rok-lang/docs";
    pub packages: str;
    /// The standard library sources (`bare/src/`, `core/src/`, `std/src/`).
    pub library: str = "../rok/library";
    pub out: str = "public";
    /// The release this build documents (`0.1.2`), and the earlier
    /// releases of its version, oldest first: what the API's "Added in"
    /// badges compare against. Set by `serve` when it archives a release;
    /// empty, no badges.
    pub built_from: str = "";
    pub history: List<Release> = List::new();
    /// The og:image version: the first 10 hex digits of static/og.png's
    /// SHA-256, set on load. A new image is a new URL, so link previews
    /// refetch it. Its pixel size comes from the same file.
    pub og: str = "";
    pub og_w: i64 = 0i64;
    pub og_h: i64 = 0i64;
    /// The docs being wrapped have no error code pages (releases before
    /// they were written): no Error codes section in the chrome.
    pub no_errors: bool = false;
    /// The static files' versions (layout::asset), by name, set on load.
    pub assets: Dict<str, str> = Dict::new();
    /// versions.rokon, for the version menu.
    pub released: List<str> = List::new();
    pub patches: Dict<str, str> = Dict::new();
}

/// A release and its standard library sources.
#[derive(Rokon)]
pub struct Release {
    pub release: str;
    pub library: str;
}

/// versions.rokon: the released docs versions, newest first.
#[derive(Rokon)]
pub struct Versions {
    pub released: List<str>;
    /// The newest patch release of each, e.g. "0.1" -> "0.1.2".
    pub patches: Dict<str, str> = Dict::new();
}

pub struct Page {
    /// Source path relative to the spec directory; `""` for site pages.
    pub src: str;
    /// Output path relative to the site root.
    pub out: str;
    /// Spec directory of the source (its chapter).
    pub dir: str;
    pub title: str;
    pub html: str;
    pub heads: List<Heading>;
    /// Search notes of headings by id: `kind\tsummary` (API items).
    pub notes: Dict<str, str> = Dict::new();
}

/// A doc page's content and navigation without any chrome: enough for the
/// current generator to re-wrap it. Archived per released version so a
/// design change reaches old versions while their content stays pinned.
#[derive(Rokon)]
pub struct Frag {
    pub out: str;
    pub title: str;
    pub side: str;
    pub body: str;
    pub pager: str;
    /// "On this page" items, or `""`.
    pub toc: str = "";
    /// hreflang `<link>`s for `<head>`, or `""`.
    pub head: str;
    /// The page in the other language, from the version root, or `""`.
    pub alt: str = "";
    /// This page's heading ids paired with those of `alt` (search.js
    /// carries the reader's section over).
    pub sec: str = "";
    /// A Korean page still in English: kept out of search engines.
    pub noindex: bool = false;
    /// The breadcrumb between the section and this page (spec chapters),
    /// each link after a separator, or `""`.
    pub crumb: str = "";
}

/// One released version's docs as fragments, plus its search index.
#[derive(Rokon)]
pub struct Bundle {
    pub version: str;
    pub pages: List<Frag>;
    pub search: str;
    /// The Korean pages' search index.
    pub search_ko: str = "";
}

/// Final HTML of a doc page: the current chrome around `f`'s content.
/// `latest` holds the pages of the newest release.
fn wrap(site: Site, f: Frag, latest: Set<str>) -> str {
    layout::page(site, f, layout::ver_banner(site, layout::root_of(f.out), f.out, latest.contains(f.out)))
}

/// `a/./b/../c` -> `a/c`; leading `..` kept.
fn norm(p: str) -> str {
    let segs: List<str> = List::new();
    for s in p.split("/") {
        if s.is_empty() || s == "." { continue; }
        if s == ".." && segs.len() > 0 && segs[segs.len() - 1] != ".." {
            segs.pop();
            continue;
        }
        segs.push(s);
    }
    let out = StrBuf::new();
    for k in 0..segs.len() {
        if k > 0 { out.push('/'); }
        out.push_str(segs[k]);
    }
    out.to_str()
}

fn join(dir: str, p: str) -> str {
    if dir.is_empty() { p } else { dir + "/" + p }
}

/// Output path of a spec source: `x/README.md` -> `spec/x/index.html`.
fn out_of(src: str) -> str {
    if src == "README.md" { return "spec/index.html"; }
    if let s: str = src.strip_suffix("/README.md") { return "spec/" + s + "/index.html"; }
    if let s: str = src.strip_suffix(".md") { return "spec/" + s + ".html"; }
    "spec/" + src
}

fn last_seg(p: str) -> str {
    let t = norm(p);
    if let k: usize = t.rfind("/") { return t[k + 1:]; }
    t
}

/// The `href` for a link written in `src_dir` of the edition in `spec`
/// (output under `prefix`), from the page `out`.
fn spec_link(site: Site, spec: str, prefix: str, href: str, src_dir: str, out: str) -> str {
    if href.starts_with("#") || href.contains("://") || href.starts_with("mailto:") { return href; }
    let path = href;
    let frag = "";
    if let k: usize = href.find("#") {
        path = href[:k];
        frag = href[k:];
    }
    let target = norm(join(src_dir, path));
    if target == ".." || target.starts_with("../") {
        // The other edition (`../ko/README.md`): its pages here.
        for (ed, pre) in [("en", ""), ("ko", "ko/")] {
            if pre == "ko/" && site.spec_ko.is_empty() { continue; }
            let top = "../" + ed;
            if target != top && !target.starts_with(top + "/") { continue; }
            let r = target[top.len():].trim_start_matches("/");
            let file = if r.is_empty() {
                "README.md"
            } else if r.ends_with(".md") {
                r
            } else if !last_seg(r).contains(".") {
                layout::readme_of(r)
            } else {
                ""
            };
            if !file.is_empty() { return rel(out, pre + out_of(file)) + frag; }
        }
        // Anything else outside the language directory: the spec repository.
        let in_repo = norm(last_seg(spec) + "/" + target);
        return f"{site.spec_repo}/blob/{site.spec_branch}/{in_repo}{frag}";
    }
    let file = if target.ends_with(".md") {
        target
    } else if !last_seg(target).contains(".") {
        layout::readme_of(target)
    } else {
        target
    };
    rel(out, prefix + out_of(file)) + frag
}

/// `"3.11.4. Patterns"` -> `"3.11.4."`; `""` if unnumbered.
fn sec_no(t: str) -> str {
    let w = t;
    if let k: usize = t.find(" ") { w = t[:k]; }
    if !w.ends_with(".") { return ""; }
    let first = true;
    for c in w.chars() {
        let ok = if first { c >= '0' && c <= '9' } else { (c >= '0' && c <= '9') || c == '.' || (c >= 'a' && c <= 'z') };
        if !ok { return ""; }
        first = false;
    }
    w
}

/// Heading ids of `a` paired with those of `b` as `"a1 b1 a2 b2 ..."`:
/// by position when the outlines match, else by section number (an
/// unnumbered heading goes to its numbered section).
fn sec_map(a: List<Heading>, b: List<Heading>) -> str {
    let same = a.len() == b.len();
    for k in 0..a.len() {
        if !same { break; }
        if sec_no(a[k].text) != sec_no(b[k].text) { same = false; }
    }
    let by: Dict<str, str> = Dict::new();
    for h in b {
        let n = sec_no(h.text);
        if !n.is_empty() && (by.get(n) ?? "").is_empty() { by.insert(n, h.id); }
    }
    let out = StrBuf::new();
    let last = "";
    for k in 0..a.len() {
        let n = sec_no(a[k].text);
        if !n.is_empty() { last = by.get(n) ?? ""; }
        let to = if same { b[k].id } else { last };
        if to.is_empty() { continue; }
        if !out.is_empty() { out.push(' '); }
        out.push_str(a[k].id + " " + to);
    }
    out.to_str()
}

/// The other edition's page of `p` among `others` (the same source), with
/// the heading pairs for search.js; `("", "")` if it has none.
fn twin(p: Page, others: List<Page>) -> (str, str) {
    for o in others {
        if o.src == p.src { return (o.out, sec_map(p.heads, o.heads)); }
    }
    ("", "")
}

/// Where `path` of the repository `repo` is edited: GitHub's editor on
/// main for dev and the newest release (changes land there), else the
/// file as it is on `branch`, the older release's.
fn edit_url(site: Site, repo: str, branch: str, path: str) -> str {
    if site.version == "dev" || site.version == site.newest || site.newest.is_empty() { f"{repo}/edit/main/{path}" } else { f"{repo}/blob/{branch}/{path}" }
}

/// The edit link of spec page `p` of the edition in `spec`.
fn spec_edit(site: Site, spec: str, p: Page) -> str {
    layout::edit_link(edit_url(site, site.spec_repo, site.spec_branch, f"{last_seg(spec)}/{p.src}"), p.out.starts_with("ko/"))
}

/// The edit link of docs page `p` (docs/), whose source is under `dir`
/// (`""`, or `ko/` for a Korean page).
fn docs_edit(site: Site, p: Page, dir: str) -> str {
    layout::edit_link(edit_url(site, site.repo, docs_branch(site), dir + p.src.replace("README.md", "index.md")), dir == "ko/")
}

fn spec_root(dir: str) -> str {
    let d = norm(dir);
    if dir.starts_with("/") { d = "/" + d; }
    d
}

/// The chapters between spec page `pages[k]` and its section's index
/// (layout::section), outermost first, as breadcrumb links.
fn spec_crumb(pages: List<Page>, k: usize) -> str {
    let p = pages[k];
    let ko = p.out.starts_with("ko/");
    let (_, _, _, index) = layout::section(if ko { p.out["ko/".len():] } else { p.out });
    if index.is_empty() { return ""; }
    let top = layout::in_lang(index, ko);
    if p.out == top { return ""; }
    let chain: List<str> = List::new();
    let d = p.dir;
    while !d.is_empty() {
        let readme = layout::readme_of(d);
        let up = dir_of(d);
        for q in pages {
            if q.src != readme || q.out == top || q.out == p.out { continue; }
            chain.push(f"<span class=\"sep\" aria-hidden=\"true\">/</span><a href=\"{rel(p.out, q.out)}\">{markdown::esc(q.title)}</a>");
        }
        // Stop at the section's own directory.
        if top.ends_with(readme.replace("README.md", "index.html")) { break; }
        d = up;
    }
    chain.reverse();
    chain.join("")
}

/// The spec edition in `spec`, rendered under `prefix` (`""`, `"ko/"`).
fn spec_pages(site: Site, spec: str, prefix: str, ko: bool) throws -> List<Page> {
    let srcs: List<str> = List::new();
    for entry in fs::walk(spec) {
        let e = try entry.get();
        let p = e.path().as_str();
        if e.is_file() && p.ends_with(".md") { srcs.push(p[spec.len() + 1:]); }
    }
    sort_sources(srcs);
    let pages: List<Page> = List::new();
    for src in srcs {
        let out = prefix + out_of(src);
        let dir = dir_of(src);
        let text = try fs::read_to_str(spec + "/" + src);
        if src == "README.md" { text = spec_intro(text); }
        let doc = layout::md(text, |h| spec_link(site, spec, prefix, h, dir, out), ko);
        let title = if doc.title.is_empty() { src } else { doc.title };
        pages.push(Page { src: src, out: out, dir: dir, title: title, html: doc.html, heads: doc.headings });
    }
    pages
}

/// The spec's README as the spec's own introduction: without what only
/// the repository needs (the language switch, the maintainer line, the
/// table of project links), and naming itself the specification rather
/// than the repository. Text it does not find is left alone.
fn spec_intro(text: str) -> str {
    let out = StrBuf::new();
    let table = false;
    for l in text.split("\n") {
        let t = l.trim();
        // The page has its own language switch.
        if t.contains("English") && t.contains("한국어") && t.contains("·") && t.char_count() < 60 { continue; }
        if t.starts_with("Designed and maintained by") || t.starts_with("설계와 유지보수는") { continue; }
        if t.starts_with("|") {
            if !table && (t.contains("GitHub organization") || t.contains("GitHub 조직") || t.contains("| What ") || t.contains("| 자리 ")) { table = true; }
            if table { continue; }
        } else {
            table = false;
        }
        out.push_str(l);
        out.push('\n');
    }
    let s = out.to_str();
    // Blank lines the dropped blocks leave behind.
    while s.contains("\n\n\n") { s = s.replace("\n\n\n", "\n\n"); }
    for (from, to) in [
        ("this repository is its formal specification", "this is its formal specification"),
        ("live in a separate repository; this one holds", "live in a separate repository; the specification holds"),
        ("The repository has a fixed shape.", "The specification has a fixed shape."),
        ("이 저장소는 그 언어의 형식 사양", "이 문서는 그 언어의 형식 사양"),
        ("저장소는 정해진 모양으로", "사양은 정해진 모양으로"),
    ] {
        s = s.replace(from, to);
    }
    s
}

/// README first within each directory, then by name.
fn sort_key(src: str) -> str { src.replace("README.md", "!") }

fn sort_sources(xs: List<str>) {
    for i in 1..xs.len() {
        let x = xs[i];
        let j = i;
        while j > 0 && sort_key(xs[j - 1]) > sort_key(x) {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[j] = x;
    }
}

fn json_str(s: str) -> str {
    let out = StrBuf::new();
    out.push('"');
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if (c as u32) < 0x20u32 {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out.to_str()
}

fn write(root: str, path: str, data: str) throws {
    let full = root + "/" + path;
    try fs::create_dir_all(dir_of(full));
    try fs::write(full, data);
}

/// Every value of `name="..."` in `html`.
fn attr_values(cs: List<char>, name: str) -> List<str> {
    let pat: List<char> = List::new();
    for c in name.chars() { pat.push(c); }
    pat.push('=');
    pat.push('"');
    let out: List<str> = List::new();
    let n = cs.len();
    let m = pat.len();
    let i = 0usize;
    while i + m <= n {
        let hit = i == 0 || cs[i - 1] == ' ';
        let k = 0usize;
        while hit && k < m {
            if cs[i + k] != pat[k] { hit = false; }
            k += 1;
        }
        if !hit {
            i += 1;
            continue;
        }
        let v = StrBuf::new();
        let j = i + m;
        while j < n && cs[j] != '"' {
            v.push(cs[j]);
            j += 1;
        }
        out.push(v.to_str().replace("&quot;", "\"").replace("&amp;", "&"));
        i = j;
    }
    out
}

fn chars_of(s: str) -> List<char> {
    let cs: List<char> = List::new();
    for c in s.chars() { cs.push(c); }
    cs
}

/// `html` of the page `out` under the site directory `base` (`/latest`,
/// `""` for a site root) with every internal `href`, `src` and `data-root`
/// as its canonical root-relative address (web::url), and absolute links
/// into either site canonical too (markdown autolinks bypass the link
/// mappers). Pages are generated
/// with relative links, so the link check and the archives stay
/// independent of where a version is served; this is the last step.
fn site_hrefs(site: Site, html: str, base: str, out: str) -> str {
    let d = dir_of(out);
    let dir = if d.is_empty() { base } else { base + "/" + d };
    let cs = chars_of(html);
    let n = cs.len();
    let res = StrBuf::new();
    let i = 0usize;
    while i < n {
        let name = "";
        if i > 0 && (cs[i - 1] == ' ' || cs[i - 1] == '\n' || cs[i - 1] == '\t') {
            for a in ["href=\"", "src=\"", "data-root=\""] {
                let k = 0usize;
                let ac = chars_of(a);
                while k < ac.len() && i + k < n && cs[i + k] == ac[k] { k += 1; }
                if k == ac.len() {
                    name = a;
                    break;
                }
            }
        }
        if name.is_empty() {
            res.push(cs[i]);
            i += 1;
            continue;
        }
        res.push_str(name);
        let j = i + name.char_count();
        let v = StrBuf::new();
        while j < n && cs[j] != '"' {
            v.push(cs[j]);
            j += 1;
        }
        let val = v.to_str();
        if name == "data-root=\"" {
            // search.js joins page paths to it.
            let r = url::resolve(dir, val);
            res.push_str(if r == "/" { r } else { r + "/" });
        } else {
            res.push_str(url::site_href(dir, layout::own(site, val)));
        }
        res.push('"');
        i = if j < n { j + 1 } else { j };
    }
    res.to_str()
}

/// The pages of one version directory `dir` (`latest`, `0.1.0`, `dev`)
/// under `docs_root`, linking within it, with its 404 page, search index
/// and static files; the static names.
fn write_version(site: Site, docs_root: str, dir: str, files: Dict<str, str>, search: str, search_ko: str) throws -> Set<str> {
    let vdir = docs_root + "/" + dir;
    if fs::exists(vdir) { try fs::remove_dir_all(vdir); }
    let base = "/" + dir;
    for out in files.keys() { try write(vdir, out, site_hrefs(site, files[out], base, out)); }
    try write(vdir, "404.html", site_hrefs(site, layout::not_found_page(site, dir, false), base, "404.html"));
    try write(vdir, "ko/404.html", site_hrefs(site, layout::not_found_page(site, dir, true), base, "ko/404.html"));
    try write(vdir, "search-index.json", search);
    let statics = try copy_static(vdir);
    statics.insert("search-index.json");
    if !search_ko.is_empty() {
        try write(vdir, "ko/search-index.json", search_ko);
        statics.insert("ko/search-index.json");
    }
    statics
}

/// Broken internal `href` / `src` targets (missing file or anchor).
fn check(files: Dict<str, str>, statics: Set<str>) -> List<str> {
    let ids: Dict<str, Set<str>> = Dict::new();
    let refs: Dict<str, List<str>> = Dict::new();
    for out in files.keys() {
        let cs = chars_of(files[out]);
        let s: Set<str> = Set::new();
        for id in attr_values(cs, "id") { s.insert(id); }
        ids.insert(out, s);
        let r = attr_values(cs, "href");
        r.extend(attr_values(cs, "src"));
        refs.insert(out, r);
    }
    let bad: List<str> = List::new();
    for out in files.keys() {
        for href in refs[out] {
            if href.contains("://") || href.starts_with("mailto:") || href == "#" { continue; }
            let path = href;
            let frag = "";
            if let k: usize = href.find("#") {
                path = href[:k];
                frag = href[k + 1:];
            }
            // An asset's `?v=`.
            path = url::split_ref(path).0;
            let target = if path.is_empty() { out } else { norm(join(dir_of(out), path)) };
            // Another version's docs (the banner, the version menu).
            if target.starts_with("../") { continue; }
            if let s: Set<str> = ids.get(target) {
                if !frag.is_empty() && !s.contains(frag) { bad.push(f"{out}: {href} (no anchor)"); }
            } else if !statics.contains(target) {
                bad.push(f"{out}: {href} (no page)");
            }
        }
    }
    bad
}

/// Static files referenced by a relative path from the pages written
/// under `root` (after site_hrefs, so the served HTML).
fn relative_assets(root: str) throws -> List<str> {
    let bad: List<str> = List::new();
    for entry in fs::walk(root) {
        let e = try entry.get();
        let p = e.path().as_str();
        if !e.is_file() || !p.ends_with(".html") { continue; }
        let html = try fs::read_to_str(p);
        // After any white space, not just the space site_hrefs looks for.
        for a in ["href=\"", "src=\""] {
            let rest = html;
            loop {
                let k = rest.find(a) ?? rest.len();
                if k == rest.len() { break; }
                let ws = k > 0 && rest[k - 1:k].trim().is_empty();
                rest = rest[k + a.len():];
                let v = rest[:rest.find("\"") ?? rest.len()];
                if ws && url::relative_asset(v) { bad.push(f"{p[root.len() + 1:]}: {v} (relative asset path)"); }
            }
        }
    }
    bad
}

/// `<docs>/**.md`, sorted (each directory's `index.md` first); the
/// repository's own files are not pages.
fn page_sources(root: str) throws -> List<str> {
    let srcs: List<str> = List::new();
    for entry in fs::walk(root) {
        let e = try entry.get();
        let p = e.path().as_str()[root.len() + 1:];
        if !e.is_file() || !p.ends_with(".md") || p.starts_with(".") || p.starts_with("ko/") { continue; }
        if p == "README.md" || p == "CODE_OF_CONDUCT.md" || p == "SECURITY.md" || p == "CONTRIBUTING.md" { continue; }
        srcs.push(p);
    }
    for k in 0..srcs.len() { srcs[k] = srcs[k].replace("index.md", "README.md"); }
    sort_sources(srcs);
    for k in 0..srcs.len() { srcs[k] = srcs[k].replace("README.md", "index.md"); }
    srcs
}

/// What `rok run` prints for the landing page's program home/<name>/.
fn home_run(name: str) throws -> str {
    let rok = try env::var("ROK") catch _ { "rok" };
    let dir = f"home/{name}";
    let out = try Command::new(rok).args(["run"]).current_dir(dir).stdin(Stdio::Null).output();
    if fs::exists(dir + "/target") { try fs::remove_dir_all(dir + "/target"); }
    let text = ((try? str::from_utf8(out.stderr)) ?? "") + ((try? str::from_utf8(out.stdout)) ?? "");
    text.trim_end() + "\n"
}

/// The landing page's programs whose checked-in output (home/<name>.out)
/// is no longer what `rok run` prints; with `write`, rewritten instead.
fn home_check(write: bool) throws -> List<str> {
    let bad: List<str> = List::new();
    for smp in home::SAMPLES {
        let got = try home_run(smp.name);
        if got == smp.out { continue; }
        if write {
            try fs::write(f"home/{smp.name}.out", got);
            println(f"home/{smp.name}.out rewritten");
        } else {
            bad.push(f"home/{smp.name}.out differs from what `rok run` prints now; rerun `rok run -- home` and rebuild:\n{got}");
        }
    }
    bad
}

fn code_check(filter: str) throws -> List<str> {
    let snips: List<check::Snippet> = List::new();
    let paths: List<str> = List::new();
    let site = try load_site();
    for src in try page_sources(site.docs) { paths.push(site.docs + "/" + src); }
    if fs::exists(site.docs + "/ko") {
        for src in try page_sources(site.docs + "/ko") { paths.push(site.docs + "/ko/" + src); }
    }
    paths.push(site.www + "/index.md");
    paths.push(site.www + "/download.md");
    for page in paths {
        if !page.contains(filter) { continue; }
        snips.extend(check::extract(page, try fs::read_to_str(page)));
    }
    let rokc = try env::var("ROKC") catch _ { "rokc" };
    // Outside this package: `rokc run` looks upward for a package.
    let bad = try check::check_all(rokc, env::temp_dir().as_str() + "/rok-lang.org-snippets", snips);
    let run = 0usize;
    for s in snips {
        if s.mode != "norun" { run += 1; }
    }
    for b in bad { eprint(f"code block: {b}"); }
    println(f"{run} code blocks checked ({snips.len() - run} norun), {bad.len()} failing");
    bad
}

/// `site.rokon`, with the fields of `site.local.rokon` (git-ignored,
/// for a machine whose checkouts are not siblings), or of the file
/// $ROK_SITE_LOCAL names (the server's builds), laid over it.
fn load_site() throws -> Site {
    let base = try rokon::parse(try fs::read_to_str("site.rokon"));
    let local_path = try env::var("ROK_SITE_LOCAL") catch _ { "site.local.rokon" };
    if fs::exists(local_path) {
        let local = try rokon::parse(try fs::read_to_str(local_path));
        if let rokon::Value::Struct { name: _, fields } = base {
            if let rokon::Value::Struct { name: _, fields: over } = local {
                for (k, v) in over.entries() { fields.insert(k, v); }
            }
        }
    }
    let site: Site = try rokon::decode(base, "site.rokon");
    site.og = try og_version("static/og.png");
    let (w, h) = try png_size("static/og.png");
    site.og_w = w;
    site.og_h = h;
    for f in kit::files(kit::Mark::Rok) { site.assets.insert(f.name, encoding::hex_encode(HashAlgorithm::Sha256.digest(f.data))[:10]); }
    for name in ["style.css", "search.js", "hero.js"] { site.assets.insert(name, try og_version("static/" + name)); }
    site
}

/// Width and height from a PNG's IHDR chunk.
fn png_size(path: str) throws -> (i64, i64) {
    let b = try fs::read(path);
    if b.len() < 24 { throw ValueError { msg: f"{path}: not a PNG" }; }
    let be = |k: usize| ((b[k] as i64) << 24) | ((b[k + 1] as i64) << 16) | ((b[k + 2] as i64) << 8) | (b[k + 3] as i64);
    (be(16), be(20))
}

/// The first 10 hex digits of the SHA-256 of the file at `path`.
pub fn og_version(path: str) throws -> str {
    encoding::hex_encode(HashAlgorithm::Sha256.digest(try fs::read(path)))[:10]
}

fn sitemap(urls: List<str>) -> str {
    let b = StrBuf::new();
    b.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
    for u in urls { b.push_str(f"<url><loc>{markdown::esc(u)}</loc></url>\n"); }
    b.push_str("</urlset>\n");
    b.to_str()
}

/// For the "Added in" badges: each API item and member that the first
/// release of `site.history` lacks, mapped to the release that added it.
fn added_in(site: Site, mods: List<web::apidoc::Module>) throws -> Dict<str, str> {
    let since: Dict<str, str> = Dict::new();
    if site.history.len() == 0 || site.built_from.is_empty() { return since; }
    let seen = apidoc::keys(try apidoc::collect(site.history[0].library));
    for h in site.history[1..] {
        for k in apidoc::keys(try apidoc::collect(h.library)) {
            if !seen.contains(k) {
                since.insert(k, h.release);
                seen.insert(k);
            }
        }
    }
    for k in apidoc::keys(mods) {
        if !seen.contains(k) { since.insert(k, site.built_from); }
    }
    since
}

/// The rok-lang/docs branch a build documents: `main` for dev, else the
/// newest patch of the version (`v0.1.4`).
fn docs_branch(site: Site) -> str {
    if site.version == "dev" || site.built_from.is_empty() { "main" } else { "v" + site.built_from }
}

/// versions.rokon, or the file $ROK_VERSIONS names (the server's builds).
fn load_versions() throws -> Versions {
    let path = try env::var("ROK_VERSIONS") catch _ { "versions.rokon" };
    try rokon::decode(try rokon::parse(try fs::read_to_str(path)), path)
}

/// The names under static/, of the kit's files and of its fonts, without
/// copying (for the link check).
fn static_names() throws -> Set<str> {
    let names: Set<str> = Set::new();
    for f in kit::files(kit::Mark::Rok) { names.insert(f.name); }
    for entry in fs::walk(kit::FONTS_DIR) {
        let e = try entry.get();
        let name = e.path().as_str()[kit::FONTS_DIR.len() + 1:].replace("\\", "/");
        if e.is_file() && !name.ends_with(".md") { names.insert("fonts/" + name); }
    }
    for entry in fs::walk("static") {
        let e = try entry.get();
        if e.is_file() { names.insert(e.path().as_str()["static/".len():]); }
    }
    names
}

/// Writes the kit's files (web/, built in), copies its fonts to fonts/
/// and static/ into `dir`; the names written.
fn copy_static(dir: str) throws -> Set<str> {
    let names: Set<str> = Set::new();
    try fs::create_dir_all(dir);
    for f in kit::files(kit::Mark::Rok) {
        try fs::write(dir + "/" + f.name, f.data);
        names.insert(f.name);
    }
    for name in try kit::copy_fonts(kit::FONTS_DIR, dir + "/fonts") { names.insert("fonts/" + name); }
    for entry in fs::walk("static") {
        let e = try entry.get();
        if !e.is_file() { continue; }
        let name = e.path().as_str()["static/".len():];
        try fs::create_dir_all(dir_of(dir + "/" + name));
        try fs::copy(e.path(), dir + "/" + name);
        names.insert(name);
    }
    names
}

/// A version is `dev`, a minor (`0.1`, whose patch releases share one
/// build) or a patch release (`0.1.4`, the server's builds).
fn is_version(v: str) -> bool {
    if v == "dev" { return true; }
    let dots = 0usize;
    let digits = 0usize;
    for c in v.chars() {
        if c == '.' {
            if digits == 0 { return false; }
            dots += 1;
            digits = 0;
        } else if c >= '0' && c <= '9' {
            digits += 1;
        } else {
            return false;
        }
    }
    (dots == 1 || dots == 2) && digits > 0
}

fn usage() {
    eprintln("usage: rok run [-- [check] [--version <major.minor> | --version dev] | -- code [filter] | -- archive <major.minor> <dir>]");
    env::exit(2);
}

/// The size of each asset of release `r` on GitHub, by file name, from
/// the release API; empty when it cannot be read (offline, rate limit).
fn release_sizes(r: str) -> Dict<str, i64> {
    let sizes: Dict<str, i64> = Dict::new();
    let out = try Command::new("curl").args(["-fsSL", "--max-time", "15", "-H", "Accept: application/vnd.github+json", f"https://api.github.com/repos/rok-lang/rok/releases/tags/v{r}"]).stdin(Stdio::Null).output() catch _ { return sizes; };
    if !out.status.success() { return sizes; }
    let text = (try? str::from_utf8(out.stdout)) ?? "";
    // Each asset object has "name" before "size"; the uploader's object
    // in between has neither.
    let at = text.find("\"assets\":") ?? text.len();
    loop {
        let (name, k) = between(text, at, "\"name\": \"", "\"") ?? break;
        at = k;
        let (num, k2) = between(text, at, "\"size\": ", ",") ?? break;
        if let n: i64 = try? num.trim().parse::<i64>() {
            sizes.insert(name, n);
            at = k2;
        }
    }
    sizes
}

/// `42034164` -> `42 MB`.
pub fn mb(n: i64) -> str { f"{(n + 500000i64) / 1000000i64} MB" }

/// The download page as served: each archive link followed by its size
/// (`sizes`), each system's row marked with its os, architecture and libc
/// for search.js.
fn download_page(html: str, sizes: Dict<str, i64>) -> str {
    let h = html;
    for (name, n) in sizes.entries() {
        if name.ends_with(".sha256") { continue; }
        let pat = f"/{name}\">";
        let k = h.find(pat) ?? continue;
        let e = (h[k:].find("</a>") ?? continue) + k + 4;
        h = h[:e] + f"<span class=\"sz\">{mb(n)}</span>" + h[e:];
    }
    let out = StrBuf::new();
    let rest = h;
    let open = "<div class=\"dl-os\">";
    loop {
        let k = rest.find(open) ?? rest.len();
        out.push_str(rest[:k]);
        if k == rest.len() { break; }
        rest = rest[k + open.len():];
        let triple = if let (t, _): (str, usize) = between(rest, 0, "<code>", "</code>") { t } else { "" };
        out.push_str(f"<div class=\"dl-os\"{os_attrs(triple)}>");
    }
    out.to_str()
}

/// ` data-os="linux" data-arch="aarch64" data-libc="gnu"` for a triple.
pub fn os_attrs(triple: str) -> str {
    let os = if triple.contains("apple-darwin") { "macos" } else if triple.contains("windows") { "windows" } else if triple.contains("linux") { "linux" } else { "" };
    if os.is_empty() { return ""; }
    let arch = (triple.split_once("-") ?? (triple, "")).0;
    let libc = if triple.ends_with("-musl") { "musl" } else if triple.ends_with("-gnu") { "gnu" } else { "" };
    f" data-os=\"{os}\" data-arch=\"{arch}\" data-libc=\"{libc}\""
}

/// hreflang links between a page's English and Korean editions.
fn hreflang(site: Site, en: str, ko: str) -> str {
    let e = markdown::esc(layout::latest(site, en));
    f"<link rel=\"alternate\" hreflang=\"en\" href=\"{e}\">\n<link rel=\"alternate\" hreflang=\"ko\" href=\"{markdown::esc(layout::latest(site, ko))}\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"{e}\">\n"
}

/// The text between `a` and the next `b` in `s` after `from`, and the
/// index after `b`; none without them.
fn between(s: str, from: usize, a: str, b: str) -> (str, usize) | none {
    let i = (s[from:].find(a) ?? return none) + from + a.len();
    let j = (s[i:].find(b) ?? return none) + i;
    (s[i:j], j + b.len())
}

/// The docs home (docs/index.md, raw HTML) as this site shows it: its
/// install command in the landing page's command box, its section cards
/// as one plain list in header order, each section by its one name.
fn docs_home(html: str, ko: bool) -> str {
    let h = html;
    // The block layout::md made of it: `<div class="code cb">...</div></div>`.
    let i = h.find("<div class=\"install\">") ?? h.len();
    if let (cmd, _): (str, usize) = between(h, i, "<pre><code", "</code></pre>") {
        let a = (h[i:].find("<div class=\"code cb") ?? 0) + i;
        let e = (h[a:].find("</div></div>") ?? 0) + a + "</div></div>".len();
        let text = markdown::strip_tags(cmd[(cmd.find(">") ?? 0) + 1:]).replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'");
        if a > i && e > a { h = h[:a] + f"<div class=\"line mono\"><code>{markdown::esc(text)}</code>{chrome::copy_button(text, ko)}</div>" + h[e:]; }
    }
    let a = h.find("<div class=\"cards\">") ?? return h;
    let e = (h[a:].find("</div>") ?? return h) + a;
    let cards = h[a:e];
    // (order, name, href, text)
    let rows: List<(usize, str, str, str)> = List::new();
    let at = 0usize;
    loop {
        let (href, k) = between(cards, at, "<a class=\"card\" href=\"", "\"") ?? break;
        let (title, k2) = between(cards, k, "<h3>", "</h3>") ?? break;
        let (text, k3) = between(cards, k2, "<p>", "</p>") ?? break;
        at = k3;
        let target = href.replace("../", "");
        // The Korean home's API card goes to the Korean API pages.
        if ko && target.starts_with("std/") { href = target; }
        let (_, en, kr, index) = layout::section(target);
        let order = 100usize;
        for i in 0..layout::SECTIONS.len() {
            if layout::SECTIONS[i].3 == target { order = i * 2; }
        }
        if target == "spec/refs-standard-libraries/index.html" { order = 7; }
        let name = if index == target { layout::tr(ko, en, kr) } else { markdown::strip_tags(title) };
        rows.push((order, name, href, text));
    }
    if rows.len() == 0 { return h; }
    rows.sort_by(|x, y| x.0.cmp(y.0));
    let list = StrBuf::new();
    list.push_str("<dl class=\"sections\">");
    for (_, name, href, text) in rows { list.push_str(f"<dt><a href=\"{href}\">{name}</a></dt><dd>{text}</dd>"); }
    list.push_str("</dl>");
    h[:a] + list.to_str() + h[e + "</div>".len():]
}

/// `html` of page `out` with each `error[E...]` / `warning[E...]` inside a
/// `<pre>` linked to its page (the Korean one on a Korean page), for the
/// codes in `codes`.
fn link_codes(html: str, out: str, codes: Set<str>) -> str {
    if codes.len() == 0 || !html.contains("[E") { return html; }
    let pre = if out.starts_with("ko/") { "ko/" } else { "" };
    let res = StrBuf::new();
    let rest = html;
    loop {
        let a = rest.find("<pre") ?? rest.len();
        res.push_str(rest[:a]);
        rest = rest[a:];
        if rest.is_empty() { break; }
        let b = if let e: usize = rest.find("</pre>") { e + 6 } else { rest.len() };
        res.push_str(link_codes_in(rest[:b], |c| if codes.contains(c) && out != pre + "errors/" + c + ".html" { rel(out, pre + "errors/" + c + ".html") } else { "" }));
        rest = rest[b:];
    }
    res.to_str()
}

/// `s` with each `error[E...]` / `warning[E...]` whose code `to` maps to
/// an href linked there.
pub fn link_codes_in(s: str, to: fn(str) -> str) -> str {
    let res = StrBuf::new();
    let rest = s;
    loop {
        let k = rest.find("[E") ?? rest.len();
        if k == rest.len() {
            res.push_str(rest);
            break;
        }
        let w = if rest[:k].ends_with("error") { 5usize } else if rest[:k].ends_with("warning") { 7usize } else { 0usize };
        let close = rest[k:].find("]") ?? 0;
        let code = if close > 2 && close < 8 { rest[k + 1:k + close] } else { "" };
        let href = if w == 0 || code.is_empty() { "" } else { to(code) };
        if href.is_empty() {
            res.push_str(rest[:k + 2]);
            rest = rest[k + 2:];
            continue;
        }
        res.push_str(rest[:k - w]);
        res.push_str(f"<a class=\"ecode\" href=\"{href}\">{rest[k - w:k + close + 1]}</a>");
        rest = rest[k + close + 1:];
    }
    res.to_str()
}

/// `html` of Korean page `out` with links to Korean pages that do not
/// exist (`outs` has them all), such as the API's or the logo, or to a
/// section a Korean page does not have (`ids`: each page's ids), pointed
/// at the English ones.
fn ko_links(html: str, out: str, outs: Set<str>, ids: Dict<str, Set<str>>) -> str {
    ko_attr(ko_attr(html, out, outs, ids, " href=\""), out, outs, ids, " src=\"")
}

fn ko_attr(html: str, out: str, outs: Set<str>, ids: Dict<str, Set<str>>, pat: str) -> str {
    let res = StrBuf::new();
    let rest = html;
    loop {
        let k = rest.find(pat) ?? rest.len();
        if k == rest.len() {
            res.push_str(rest);
            break;
        }
        res.push_str(rest[:k + pat.len()]);
        rest = rest[k + pat.len():];
        let e = rest.find("\"") ?? rest.len();
        let v = rest[:e];
        rest = rest[e:];
        if v.contains("://") || v.starts_with("#") || v.starts_with("mailto:") || v.is_empty() {
            res.push_str(v);
            continue;
        }
        let (path, frag) = if let i: usize = v.find("#") { (v[:i], v[i:]) } else { (v, "") };
        let target = norm(join(dir_of(out), path));
        let plain = target.strip_prefix("ko/") ?? "";
        // A section of the English text (an untranslated page's link) that
        // the Korean page names otherwise: the English page.
        let id = if frag.len() > 1 { frag[1:] } else { "" };
        let lacks = !id.is_empty() && !((ids.get(target) ?? Set::new()).contains(id)) && (ids.get(plain) ?? Set::new()).contains(id);
        if !plain.is_empty() && ((!outs.contains(target) && (outs.contains(plain) || !plain.ends_with(".html"))) || lacks) {
            res.push_str(rel(out, plain) + frag);
        } else {
            res.push_str(v);
        }
    }
    res.to_str()
}

/// The standard library spec's numbered sections: `2.9.2` -> its page and
/// anchor (`spec/refs-standard-libraries/.../209-collections.html#292-list`).
fn spec_sections(pages: List<Page>) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    for p in pages {
        if !p.src.starts_with("refs-standard-libraries/") { continue; }
        for h in p.heads {
            let n = sec_no(h.text).trim_end_matches(".");
            if !n.is_empty() && !out.contains_key(n) { out.insert(n, if h.level == 1 { p.out } else { p.out + "#" + h.id }); }
        }
    }
    out
}

/// The first paragraph after each `##` / `###` heading of `html`, as
/// plain text cut to a search excerpt, by heading id.
fn section_leads(html: str) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    let at = 0usize;
    loop {
        let k = html[at:].find(" id=\"") ?? break;
        let i = at + k;
        at = i + 5;
        if i < 3 || !(html[i - 3:i] == "<h2" || html[i - 3:i] == "<h3") { continue; }
        let id = html[at:at + (html[at:].find("\"") ?? 0)];
        let close = (html[at:].find("</h") ?? continue) + at;
        let next_h = (html[close + 3:].find("<h") ?? html.len()) + close + 3;
        if let (para, _): (str, usize) = between(html, close, "<p>", "</p>") {
            let pos = (html[close:].find("<p>") ?? 0) + close;
            if pos < next_h { out.insert(id, clip_text(markdown::strip_tags(para).replace("\n", " ").trim(), 110)); }
        }
    }
    out
}

fn clip_text(s: str, n: usize) -> str {
    if s.char_count() <= n { return s; }
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n { break; }
        out.push(c);
        k += 1;
    }
    out.to_str().trim_end() + "…"
}

/// The search index of one language: {"p": [[title, url, excerpt]], "h":
/// [[page, text, id, named, kind, excerpt]]}. A url is the page's
/// canonical address in its version (`learn/05-sum-types`); `named` is 1
/// when many pages share the heading (`Code`), so results name its page;
/// `kind` is the API item's (`fn`, `method`, `struct` ..) or `""`.
fn search_index(groups: [List<Page>; 3]) -> str {
    let seen: Dict<str, usize> = Dict::new();
    for group in groups {
        for p in group {
            for h in p.heads { seen.insert(h.text, (seen.get(h.text) ?? 0usize) + 1); }
        }
    }
    let pl = StrBuf::new();
    let hl = StrBuf::new();
    let n = 0usize;
    for group in groups {
        for p in group {
            if p.out == "index.html" || p.out == "ko/index.html" { continue; }
            if n > 0 { pl.push_str(",\n"); }
            let lead = clip_text(layout::lead_text(p.html), 110);
            pl.push_str(f"[{json_str(p.title)},{json_str(url::canon(p.out))},{json_str(lead)}]");
            let leads: Dict<str, str> = if p.html.is_empty() { Dict::new() } else { section_leads(p.html) };
            for h in p.heads {
                if h.level != 2 && h.level != 3 { continue; }
                let (kind, note) = (p.notes.get(h.id) ?? "\t").split_once("\t") ?? ("", "");
                let text = if kind.is_empty() { h.text } else { api_name(h.text, kind) };
                let named = if kind.is_empty() && (seen.get(h.text) ?? 0usize) >= 4 { 1 } else { 0 };
                let ex = if kind.is_empty() { leads.get(h.id) ?? "" } else { note };
                if !hl.is_empty() { hl.push_str(",\n"); }
                hl.push_str(f"[{n},{json_str(text)},{json_str(h.id)},{named},{json_str(kind)},{json_str(ex)}]");
            }
            n += 1;
        }
    }
    f"{{\"p\":[\n{pl.to_str()}],\n\"h\":[\n{hl.to_str()}]}}\n"
}

/// An API heading's search name: `rok::core::collections::list::List::push`
/// -> `List::push` for a member, `List` for an item.
fn api_name(text: str, kind: str) -> str {
    let parts: List<str> = List::new();
    for x in text.split("::") { parts.push(x); }
    if parts.len() >= 2 && (kind == "method" || kind == "field" || kind == "variant" || kind == "assoc") { return parts[parts.len() - 2] + "::" + parts[parts.len() - 1]; }
    if text.starts_with("impl ") { return text; }
    parts[parts.len() - 1]
}

fn main() throws {
    let t0 = Instant::now();
    let args = env::args();
    if args.len() > 1 && args[1] == "serve" {
        try serve::run();
        return;
    }
    if args.len() > 1 && args[1] == "home" {
        try home_check(true);
        return;
    }
    if args.len() > 1 && args[1] == "code" {
        let bad = try code_check(if args.len() > 2 { args[2] } else { "" });
        if bad.len() > 0 { env::exit(1); }
        return;
    }
    let strict = false;
    let version = "dev";
    let archive_out = "";
    let k = 1usize;
    while k < args.len() {
        if args[k] == "check" {
            strict = true;
        } else if args[k] == "--version" && k + 1 < args.len() {
            version = args[k + 1];
            k += 1;
        } else if args[k] == "archive" && k + 2 < args.len() {
            version = args[k + 1];
            archive_out = args[k + 2];
            k += 2;
        } else {
            usage();
        }
        k += 1;
    }
    if !is_version(version) {
        eprintln(f"error: `--version {version}`: write a release as <major>.<minor> (`--version 0.1`) or <major>.<minor>.<patch>, or `--version dev`");
        env::exit(2);
    }
    let site = try load_site();
    site.version = version;
    let vs = try load_versions();
    let newest = if vs.released.len() > 0 { vs.released[0] } else { "" };
    site.newest = newest;
    site.newest_release = vs.patches.get(newest) ?? newest;
    if !site.newest_release.is_empty() { site.release = site.newest_release; }
    site.released = vs.released;
    site.patches = vs.patches;
    if version != "dev" && !vs.released.contains(version) {
        eprintln(f"note: {version} is not in versions.rokon, so the version menu will not list it");
    }
    let out_root = site.out;

    let pages = try spec_pages(site, spec_root(site.spec), "", false);
    let ko_pages: List<Page> = if site.spec_ko.is_empty() { List::new() } else { try spec_pages(site, spec_root(site.spec_ko), "ko/", true) };

    // Each doc page as a chrome-less fragment, keyed by output path; the
    // current chrome is applied in `wrap`, so a released version's archived
    // fragments re-wrap with it too.
    let frags: Dict<str, Frag> = Dict::new();
    for (eds, others, spec, ko) in [(pages, ko_pages, site.spec, false), (ko_pages, pages, site.spec_ko, true)] {
        for k in 0..eds.len() {
            let p = eds[k];
            let (alt, sec) = twin(p, others);
            // Each spec page names its other edition for search engines.
            let head = if alt.is_empty() { "" } else { hreflang(site, if ko { alt } else { p.out }, if ko { p.out } else { alt }) };
            frags.insert(p.out, Frag { out: p.out, title: p.title, side: layout::sidebar(eds, k), toc: layout::toc(p), body: p.html + spec_edit(site, spec, p), pager: layout::pager(eds, k, ko), head: head, alt: alt, sec: sec, crumb: spec_crumb(eds, k) });
        }
    }

    // The docs' own pages: `docs/x.md` -> `x.html`; a directory
    // (`docs/learn/`) is a chapter with its own sidebar and pager. The
    // Korean ones mirror them under `ko/`: a page not translated yet is
    // its English text under a note.
    let own: List<Page> = List::new();
    for src in try page_sources(site.docs) {
        let doc = layout::md(try fs::read_to_str(site.docs + "/" + src), |h| h, false);
        let key = src.replace("index.md", "README.md");
        own.push(Page { src: key, out: src.replace(".md", ".html"), dir: dir_of(src), title: doc.title, html: doc.html, heads: doc.headings });
    }
    let ko_dir = site.docs + "/ko";
    let ko_own: List<Page> = List::new();
    let translated: Set<str> = Set::new();
    for p in own {
        let file = ko_dir + "/" + p.src.replace("README.md", "index.md");
        if fs::exists(file) {
            let doc = layout::md(try fs::read_to_str(file), |h| h, true);
            ko_own.push(Page { src: p.src, out: "ko/" + p.out, dir: p.dir, title: if doc.title.is_empty() { p.title } else { doc.title }, html: doc.html, heads: doc.headings });
            translated.insert("ko/" + p.out);
        } else {
            let note = "<p class=\"tr-note\">이 페이지는 아직 번역되지 않았습니다. 영어 원문을 그대로 보여 줍니다.</p>\n";
            ko_own.push(Page { src: p.src, out: "ko/" + p.out, dir: p.dir, title: p.title, html: note + "<div lang=\"en\">\n" + p.html + "</div>\n", heads: p.heads });
        }
    }
    if fs::exists(ko_dir) {
        for src in try page_sources(ko_dir) {
            if !fs::exists(site.docs + "/" + src) { eprintln(f"note: docs/ko/{src} has no English page, so it is not built"); }
        }
    }
    for (group_all, others, ko) in [(own, ko_own, false), (ko_own, own, true)] {
        for k in 0..group_all.len() {
            let p = group_all[k];
            let (alt, sec) = twin(p, others);
            let real = !ko || translated.contains(p.out);
            let alt_real = ko || translated.contains(alt);
            let head = if real && alt_real && !alt.is_empty() { hreflang(site, if ko { alt } else { p.out }, if ko { p.out } else { alt }) } else { "" };
            let edit = docs_edit(site, p, if ko && real { "ko/" } else { "" });
            if p.dir.is_empty() {
                let side = if p.src == "README.md" { "" } else { layout::page_toc(p) };
                let toc = if p.src == "README.md" { "" } else { layout::toc(p) };
                let body = if p.src == "README.md" { docs_home(p.html, ko) } else { p.html };
                frags.insert(p.out, Frag { out: p.out, title: p.title, side: side, toc: toc, body: body + edit, pager: "", head: head, alt: alt, sec: sec, noindex: !real });
                continue;
            }
            let group: List<Page> = List::new();
            let at = 0usize;
            for q in group_all {
                if q.dir == p.dir {
                    if q.out == p.out { at = group.len(); }
                    group.push(q);
                }
            }
            let html = if p.dir == "learn" { layout::chapter(p.html, p.title) } else { p.html };
            // The errors index lists its codes itself.
            let body = (if at == 0 && p.dir != "errors" { html + layout::contents(group) } else { html }) + edit;
            frags.insert(p.out, Frag { out: p.out, title: p.title, side: layout::sidebar(group, at), toc: layout::toc(p), body: body, pager: layout::pager(group, at, ko), head: head, alt: alt, sec: sec, noindex: !real });
        }
    }

    // Standard library API: `std/<tier>/<module>.html`, from the library's
    // English doc comments; `ko/std/` is the same in Korean chrome.
    let api: List<Page> = List::new();
    let mods = try apidoc::collect(site.library);
    let since = try added_in(site, mods);
    let spec_secs = spec_sections(pages);
    let types = apidoc::type_index(mods);
    let src_ref = if site.version == "dev" || site.built_from.is_empty() { "main" } else { "v" + site.built_from };
    for m in mods {
        let notes: Dict<str, str> = Dict::new();
        let (html, heads) = apidoc::body(m, mods, since, notes, src_ref, spec_secs, types);
        frags.insert(m.out, Frag { out: m.out, title: m.path, side: apidoc::sidebar(m, mods, m.out), toc: apidoc::toc(heads), body: html, pager: "", head: "" });
        for s in apidoc::subpages(m, since, src_ref, types) {
            frags.insert(s.out, Frag { out: s.out, title: s.title, side: apidoc::sidebar(m, mods, s.out), toc: apidoc::toc(s.heads), body: s.html, pager: "", head: "" });
            api.push(Page { src: "", out: s.out, dir: "std", title: s.title, html: "", heads: s.heads, notes: s.notes });
        }
        api.push(Page { src: "", out: m.out, dir: "std", title: m.path, html: "", heads: heads, notes: notes });
    }
    frags.insert("std/index.html", Frag { out: "std/index.html", title: "Standard library API", side: "", body: apidoc::index(mods, spec_secs), pager: "", head: "" });
    let (bare, all) = apidoc::coverage(mods);
    if bare > 0 { eprintln(f"note: {bare} of {all} public API items and members have no doc comment"); }
    let api_ko: List<Page> = List::new();
    for p in api { api_ko.push(Page { src: "", out: "ko/" + p.out, dir: "ko/std", title: p.title, html: "", heads: p.heads, notes: p.notes }); }
    let api_note = "<p class=\"tr-note\">API 참조는 영어로만 있습니다. 표준 라이브러리 소스의 영어 문서 주석에서 만듭니다.</p>\n";
    let std_outs: List<str> = List::new();
    for o in frags.keys() {
        if o.starts_with("std/") { std_outs.push(o); }
    }
    for o in std_outs {
        let f = frags[o];
        let body = if let k: usize = f.body.find("</h1>") { f.body[:k + 5] + "\n" + api_note + "<div lang=\"en\">\n" + f.body[k + 5:] + "</div>\n" } else { api_note + "<div lang=\"en\">\n" + f.body + "</div>\n" };
        frags.insert("ko/" + o, Frag { out: "ko/" + o, title: f.title, side: f.side, toc: f.toc, body: body, pager: "", head: "", alt: o, noindex: true });
        f.alt = "ko/" + o;
        frags.insert(o, f);
    }

    // Every `error[E...]` in a terminal or output block links to its page,
    // and a Korean page's links into pages that exist only in English (the
    // API, the logo) go there.
    let codes: Set<str> = Set::new();
    for p in own {
        if p.dir == "errors" && p.src != "errors/README.md" { codes.insert(p.out["errors/".len():p.out.len() - ".html".len()]); }
    }
    let outs: Set<str> = Set::new();
    let ids: Dict<str, Set<str>> = Dict::new();
    for o in frags.keys() {
        outs.insert(o);
        let set: Set<str> = Set::new();
        for id in attr_values(chars_of(frags[o].body), "id") { set.insert(id); }
        ids.insert(o, set);
    }
    for o in outs {
        let f = frags[o];
        f.body = link_codes(f.body, o, codes);
        if o.starts_with("ko/") {
            f.body = ko_links(f.body, o, outs, ids);
            f.side = ko_links(f.side, o, outs, ids);
        }
        frags.insert(o, f);
    }

    // A search index per language: every page, its `##` / `###` sections
    // and the API's items and members.
    let idx = search_index([own, pages, api]);
    let idx_ko = search_index([ko_own, ko_pages, api_ko]);

    // The newest release's pages, for the banner's link on other versions.
    let archive = try env::var("ROK_DOCS_ARCHIVE") catch _ { "" };
    let latest_outs: Set<str> = Set::new();
    let latest_hidden: Set<str> = Set::new();
    if version == newest {
        for o in frags.keys() {
            latest_outs.insert(o);
            if frags[o].noindex { latest_hidden.insert(o); }
        }
    } else if !archive.is_empty() && fs::exists(f"{archive}/{newest}/bundle.rokon") {
        let bpath = f"{archive}/{newest}/bundle.rokon";
        let b: Bundle = try rokon::decode(try rokon::parse(try fs::read_to_str(bpath)), bpath);
        for f in b.pages {
            latest_outs.insert(f.out);
            if f.noindex { latest_hidden.insert(f.out); }
        }
    }

    // This version's pages, with the current chrome.
    site.no_errors = !frags.contains_key("errors/index.html");
    let files: Dict<str, str> = Dict::new();
    for out in frags.keys() { files.insert(out, wrap(site, frags[out], latest_outs)); }

    // `archive` mode: emit this version's content as a bundle for a later
    // deploy to re-wrap with the chrome of the day, instead of writing HTML.
    // The link check still runs, so a release with a broken link is caught.
    if !archive_out.is_empty() {
        let abad = check(files, try static_names());
        for b in abad { eprintln(f"broken link: {b}"); }
        if abad.len() > 0 { env::exit(1); }
        let outs: List<str> = List::new();
        for o in frags.keys() { outs.push(o); }
        outs.sort();
        let fl: List<Frag> = List::new();
        for o in outs { fl.push(frags[o]); }
        try write(archive_out, "bundle.rokon", rokon::to_string(Bundle { version: version, pages: fl, search: idx, search_ko: idx_ko }));
        println(f"archived docs {version}: {fl.len()} pages → {archive_out}/bundle.rokon ({t0.elapsed():?})");
        return;
    }

    // The home site: the landing page links into the newest docs with
    // `docs:<path>`.
    let www: Dict<str, str> = Dict::new();
    let examples: List<home::Example> = List::new();
    for p in own {
        if p.out.starts_with("examples/") && p.out != "examples/index.html" {
            examples.push(home::Example { title: p.title, lead: layout::lead_text(p.html), href: layout::latest(site, p.out) });
        }
    }
    // `{release}` in its pages is the release the download page offers.
    let www_urls: List<str> = List::new();
    // The home site links into latest/: an Error codes link only if the
    // newest release's docs have them.
    let docs_no_errors = site.no_errors;
    if latest_outs.len() > 0 { site.no_errors = !latest_outs.contains("errors/index.html"); }
    let sizes = release_sizes(site.release);
    for name in ["index", "download", "roadmap"] {
        let text = (try fs::read_to_str(f"{site.www}/{name}.md")).replace("{release}", site.release);
        let doc = layout::md(text, |h| if h.starts_with("docs:") { layout::latest(site, h["docs:".len():]) } else { h }, false);
        // Raw HTML blocks are not seen by the link mapper.
        let html = doc.html.replace("href=\"docs:", "href=\"" + layout::latest(site, "")).replace("href=\"play:", "href=\"" + site.playground + "/");
        let out = name + ".html";
        let body = if name == "index" { home::body(site, examples, sizes) } else if name == "download" { download_page(html, sizes) } else { html };
        www.insert(out, layout::www_page(site, out, doc.title, body));
        www_urls.push(site.base_url + "/" + if name == "index" { "" } else { name });
    }
    www.insert("404.html", layout::www_page(site, "404.html", "Page not found", layout::not_found(|p| layout::latest(site, p), false, site.no_errors)));
    site.no_errors = docs_no_errors;

    let docs_root = out_root + "/docs";
    let docs_dir = docs_root + "/" + version;
    let www_dir = out_root + "/www";
    if fs::exists(www_dir) { try fs::remove_dir_all(www_dir); }
    let statics = try write_version(site, docs_root, version, files, idx, idx_ko);
    let fl: List<Frag> = List::new();
    for o in frags.keys() { fl.push(frags[o]); }
    try write(docs_root + "/" + version, "og.rokon", rokon::to_string(layout::cards(fl)));
    for out in www.keys() { try write(www_dir, out, site_hrefs(site, www[out], "", out)); }
    let www_statics = try copy_static(www_dir);
    // The installers, served at /install.sh and /install.ps1, come from the toolchain checkout.
    for f in ["install.sh", "install.ps1"] {
        try fs::copy(site.library + "/../" + f, www_dir + "/" + f);
        www_statics.insert(f);
    }
    // latest/ is the newest release's pages again, linking within latest/.
    let latest_pages: Dict<str, str> = if version == newest { files } else { Dict::new() };
    let latest_search = if version == newest { idx } else { "" };
    let latest_search_ko = if version == newest { idx_ko } else { "" };

    // Released versions other than the one built now: re-wrap their
    // archived fragments with the current chrome, so a design change reaches
    // them while their content stays pinned. `serve` archives each release
    // once and points ROK_DOCS_ARCHIVE at the archive.
    let arch_bad: List<str> = List::new();
    if !archive.is_empty() {
        for v in vs.released {
            if v == version { continue; }
            let bpath = f"{archive}/{v}/bundle.rokon";
            if !fs::exists(bpath) { continue; }
            let b: Bundle = try rokon::decode(try rokon::parse(try fs::read_to_str(bpath)), bpath);
            site.version = v;
            site.no_errors = true;
            for f in b.pages {
                if f.out == "errors/index.html" { site.no_errors = false; }
            }
            let vfiles: Dict<str, str> = Dict::new();
            for f in b.pages { vfiles.insert(f.out, wrap(site, f, latest_outs)); }
            let vstatics = try write_version(site, docs_root, v, vfiles, b.search, b.search_ko);
            try write(docs_root + "/" + v, "og.rokon", rokon::to_string(layout::cards(b.pages)));
            for bd in check(vfiles, vstatics) { arch_bad.push(f"[{v}] {bd}"); }
            if v == newest {
                latest_pages = vfiles;
                latest_search = b.search;
                latest_search_ko = b.search_ko;
            }
            println(f"docs {v}: {b.pages.len()} pages re-wrapped from archive → {docs_root}/{v}/");
        }
        site.version = version;
    }

    // Above the versions: the version list for the menu, a redirect to
    // latest/, and the 404 page (which borrows latest/'s files).
    let list = StrBuf::new();
    let patches = StrBuf::new();
    for v in vs.released {
        if !list.is_empty() { list.push(','); }
        list.push_str(json_str(v));
        if vs.patches.contains_key(v) {
            if !patches.is_empty() { patches.push(','); }
            patches.push_str(f"{json_str(v)}:{json_str(vs.patches[v])}");
        }
    }
    try write(docs_root, "versions.json", f"{{\"latest\":{json_str(newest)},\"released\":[{list.to_str()}],\"patches\":{{{patches.to_str()}}}}}\n");
    try write(docs_root, "index.html", layout::to_latest(site));
    try write(docs_root, "robots.txt", f"User-agent: *\nDisallow: /dev/\nSitemap: {site.docs_url}/sitemap.xml\n");
    try write(www_dir, "robots.txt", f"User-agent: *\nAllow: /\nSitemap: {site.base_url}/sitemap.xml\n");
    try write(www_dir, ".well-known/security.txt", f"Contact: mailto:security@rok-lang.org\nExpires: 2027-10-24T00:00:00.000Z\nPreferred-Languages: en, ko\nCanonical: {site.base_url}/.well-known/security.txt\nPolicy: {chrome::SECURITY}\n");
    try write(www_dir, "sitemap.xml", sitemap(www_urls));
    // The sitemap lists latest/: this build's pages if it is the newest
    // release, else the archived ones.
    if latest_outs.len() > 0 {
        let urls: List<str> = List::new();
        for out in latest_outs {
            if out != "404.html" && !latest_hidden.contains(out) { urls.push(layout::latest(site, if out == "index.html" { "" } else { out })); }
        }
        urls.sort();
        try write(docs_root, "sitemap.xml", sitemap(urls));
    }
    // latest/ follows the newest release, whether built now or re-wrapped
    // from the archive; its own 404 page speaks for it and, above the
    // version directories, for the docs root.
    site.version = if newest.is_empty() { version } else { newest };
    let has_latest = !newest.is_empty() && latest_pages.len() > 0;
    if has_latest { try write_version(site, docs_root, "latest", latest_pages, latest_search, latest_search_ko); }
    try write(docs_root, "404.html", site_hrefs(site, layout::not_found_page(site, "latest", false), "/latest", "404.html"));
    site.version = version;

    let bad = check(files, statics);
    for b in check(www, www_statics) { bad.push("www/" + b); }
    for b in arch_bad { bad.push(b); }
    for b in try relative_assets(out_root) { bad.push(b); }
    for b in bad { eprintln(f"broken link: {b}"); }
    let latest_note = if has_latest { ", latest/ = " + newest } else { "" };
    println(f"docs {version}: {pages.len()} + {ko_pages.len()} (ko) spec pages + {own.len()} guide pages + {api.len()} API pages → {docs_dir}/ ({files.len()} html){latest_note}; home → {www_dir}/; {bad.len()} broken links, {t0.elapsed():?}");
    if !has_latest && !newest.is_empty() {
        eprintln(f"note: {newest} is neither built now nor archived, so no latest/: build it with `--version {newest}`, or point ROK_DOCS_ARCHIVE at an archive");
    }
    if strict {
        let failing = try code_check("");
        for b in try home_check(false) {
            eprintln(f"home: {b}");
            failing.push(b);
        }
        println(f"checked in {t0.elapsed():?}");
        if bad.len() > 0 || failing.len() > 0 { env::exit(1); }
    }
}

#[test]
fn error_codes_link() {
    let codes: Set<str> = Set::new();
    codes.insert("E200");
    let h = link_codes("<p>error[E200]</p><pre>error[E200]: x\nwarning[E999]: y</pre>", "ko/learn/02-x.html", codes);
    assert(h.starts_with("<p>error[E200]</p>"), "prose untouched");
    assert(h.contains("<a class=\"ecode\" href=\"../errors/E200.html\">error[E200]</a>: x") && h.contains("warning[E999]: y"), h);
}

#[test]
fn korean_links() {
    let outs: Set<str> = Set::new();
    for o in ["ko/learn/a.html", "learn/a.html", "std/index.html", "spec/x.html", "ko/spec/x.html"] { outs.insert(o); }
    let ids: Dict<str, Set<str>> = Dict::new();
    let en: Set<str> = Set::new();
    en.insert("intro");
    ids.insert("spec/x.html", en);
    let h = ko_links("<a href=\"../std/index.html\">a</a><a href=\"a.html\">b</a><a href=\"../spec/x.html#intro\">c</a><img src=\"../../logo.svg\">", "ko/learn/a.html", outs, ids);
    assert(h.contains("href=\"../../std/index.html\"") && h.contains("href=\"a.html\""), h);
    assert(h.contains("href=\"../../spec/x.html#intro\"") && h.contains("src=\"../../logo.svg\""), h);
}

#[test]
fn docs_home_sections() {
    let h = docs_home("<div class=\"cards\"><a class=\"card\" href=\"std/index.html\"><span class=\"tag\">api/</span><h3>API</h3><p>Every module.</p></a><a class=\"card\" href=\"learn/index.html\"><h3>Learn Rok</h3><p>Chapters.</p></a></div>", false);
    assert(h == "<dl class=\"sections\"><dt><a href=\"learn/index.html\">Guide</a></dt><dd>Chapters.</dd><dt><a href=\"std/index.html\">Std library</a></dt><dd>Every module.</dd></dl>", h);
}
