{col("Learn", f"<a href=\"{esc(l.learn)}\">Guide</a><a href=\"{esc(l.examples)}\">Examples</a><a href=\"{esc(site.playground)}\">Playground</a>")}
{col("Reference", f"<a href=\"{esc(l.spec)}\">Language spec</a><a href=\"{esc(l.api)}\">Std library</a><a href=\"{esc(l.tools)}\">Tools</a>")}
{col("Ecosystem", f"<a href=\"{esc(site.packages)}\">Stones</a><a href=\"{esc(l.publishing)}\">Publishing</a><a href=\"{gh}/rok.vscode\">VS Code</a><a href=\"{gh}/rok.vim\">Vim</a>")}
{col("Project", f"<a href=\"{esc(l.roadmap)}\">Roadmap</a><a href=\"{gh}/rok\">GitHub</a><a href=\"{gh}/rok/blob/main/SECURITY.md\">Security</a><a href=\"{gh}/rok/blob/main/CODE_OF_CONDUCT.md\">Code of conduct</a><a href=\"mailto:contact@rok-lang.org\">Contact</a>")}
</div>
<div class=\"frame bar\">
<nav aria-label=\"Rok sites\"><a href=\"{esc(l.home)}\">Home</a><a href=\"{esc(l.docs)}\">Docs</a><a href=\"{esc(site.packages)}\">Stones</a><a href=\"{esc(site.playground)}\">Playground</a></nav>
<span class=\"mono\">rok {esc(site.release)}</span>
<span>MIT OR Apache-2.0</span><span>Made by <a href=\"https://daminstudio.com\">DaminStudio</a></span>{note}
{theme_seg(ko)}
</div>
</footer>
"
}

/// The section a docs page belongs to: (label, index page).
fn section(at: str) -> (str, str) {
    if at.starts_with("learn/") { return ("Learn", "learn/index.html"); }
    if at.starts_with("examples/") { return ("Examples", "examples/index.html"); }
    if at.starts_with("spec/refs-lang/009-tools/") { return ("Tools", "spec/refs-lang/009-tools/index.html"); }
    if at.starts_with("spec/refs-lang/") { return ("Language", "spec/refs-lang/index.html"); }
    if at.starts_with("spec/refs-standard-libraries/") || at.starts_with("std/") { return ("Std library", "std/index.html"); }
    if at.starts_with("spec/") { return ("Spec", "spec/index.html"); }
    ("", "")
}

/// The note over the docs of any version but the newest release, linking
/// to this page in latest/ if it is there (`in_latest`), else to latest/.
pub fn ver_banner(site: Site, out: str, in_latest: bool) -> str {
    if site.version == site.newest || site.newest.is_empty() { return ""; }
    let ko = out.starts_with("ko/");
    let to = root_of(out) + "../latest/" + if in_latest && out != "404.html" { out } else { "index.html" };
    let rel = "v" + if site.newest_release.is_empty() { site.newest } else { site.newest_release };
    let (what, go) = if ko {
        (if site.version == "dev" { "다음 버전을 위한, 아직 릴리스되지 않은 문서입니다." } else { f"v{site.version} 문서를 보고 있습니다." }, f"최신 릴리스: {rel} →")
    } else {
        (if site.version == "dev" { "Unreleased docs for the next version." } else { f"You are reading the docs for v{site.version}." }, f"Latest release: {rel} →")
    };
    f"<p class=\"ver-banner\">{what} <a href=\"{to}\">{go}</a></p>\n"
}

/// A page of the docs of one version, `out` relative to that version's
/// root, under `banner` (`ver_banner`). search.js fills the version menu
/// from `versions.json` beside the version directories.
pub fn page(site: Site, out: str, title: str, side: str, toc: str, body: str, pager: str, banner: str) -> str {
    // The 404 page sits above the versions and is served for any missing
    // path, so it borrows the newest release's files.
    let root = if out == "404.html" { "/latest/" } else { root_of(out) };
    let ko = out.starts_with("ko/");
    // Nav state of a Korean spec page is that of its English twin.
    let at = if ko { out["ko/".len():] } else { out };
    let (sec, sec_index) = section(at);
    let nav = StrBuf::new();
    for (label, href) in [("Learn", "learn/index.html"), ("Examples", "examples/index.html"), ("Language", "spec/refs-lang/index.html"), ("Std library", "std/index.html"), ("Tools", "spec/refs-lang/009-tools/index.html")] {
        nav.push_str(nav_item(root + href, label, sec == label));
    }
    let name = site.title + " Docs";
    let full = if out == "index.html" { name } else { title + " - " + name };
    let (contents, on_this) = if ko { ("목차", "이 페이지의 내용") } else { ("Contents", "On this page") };
    // On narrow screens the sidebar is a drawer, opened from a bar in
    // the sticky header (search.js).
    let (aside, bar) = if side.is_empty() {
        ("", "")
    } else {
        let close = if ko { "목차 닫기" } else { "Close contents" };
        (f"<nav id=\"side\" class=\"side\" aria-label=\"{contents}\"><div class=\"side-h\"><p class=\"t-label\">{contents}</p><button class=\"ib side-close\" type=\"button\" aria-label=\"{close}\">{ICON_CLOSE}</button></div>{side}</nav>\n", f"<div class=\"cbar\"><button class=\"side-toggle\" type=\"button\" aria-controls=\"side\" aria-expanded=\"false\">{ICON_SIDE}{contents}</button><span class=\"cbar-t\" aria-hidden=\"true\">{esc(title)}</span></div>\n")
    };
    let on_page = if toc.is_empty() { "" } else { f"<aside class=\"toc\" aria-label=\"{on_this}\"><p class=\"t-label\">{on_this}</p><ul>{toc}</ul></aside>\n" };
    // Below the wide layout's "On this page" column: the same list,
    // folded under the title.
    let body = if toc.is_empty() {
        body
    } else if let k: usize = body.find("</h1>") {
        body[:k + 5] + f"\n<details class=\"toc-m\"><summary>{on_this}</summary><ul>{toc}</ul></details>" + body[k + 5:]
    } else {
        body
    };
    let kind = if out == "index.html" { "home" } else if side.is_empty() { "doc wide" } else { "doc" };
    let crumb = if sec.is_empty() || at == sec_index || out == "404.html" { "" } else { f"<nav class=\"crumb\" aria-label=\"Breadcrumb\"><a href=\"{root}{sec_index}\">{sec}</a></nav>\n" };
    let lang = if ko { "ko" } else { "en" };
    let desc = esc(describe(site, out, body));
    let url = latest(site, if out == "index.html" || out == "404.html" { "" } else { out });
    // Unreleased docs stay out of search engines.
    let robots = if site.version == "dev" { "<meta name=\"robots\" content=\"noindex\">\n" } else { "" };
    let ver = if site.version == "dev" { "dev" } else { "v" + site.version };
    let links = Links { home: site.base_url, docs: root + "index.html", learn: root + "learn/index.html", examples: root + "examples/index.html", spec: root + "spec/refs-lang/index.html", api: root + "std/index.html", tools: root + "spec/refs-lang/009-tools/index.html", publishing: root + "learn/18-features-and-stones.html#publishing-a-stone", roadmap: site.base_url + "/roadmap" };
    let play = if !site.newest.is_empty() && site.version == site.newest { esc(site.playground) } else { "" };
    let note = if at.starts_with("spec/") { "<span>Spec text © Han Damin, <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a></span>" } else { "" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"{lang}\">
<head>
{head(site, root, full, desc, url, latest(site, "og.png"), robots)}</head>
<body class=\"{kind}\" data-root=\"{root}\" data-version=\"{esc(site.version)}\" data-play=\"{play}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr top\" lang=\"en\">
<div class=\"in\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"24\" height=\"24\">Rok<span class=\"sl\">/</span><span class=\"site\">Docs</span></a>
{TOGGLE}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"Sections\">{nav.to_str()}</nav>
<div class=\"tools\">
<div class=\"search\" role=\"search\">{ICON_SEARCH}<input id=\"q\" type=\"search\" placeholder=\"Search docs\" aria-label=\"Search docs\" aria-keyshortcuts=\"/\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"results\"><kbd class=\"kbd\" aria-hidden=\"true\">/</kbd><ul id=\"results\" class=\"results\" role=\"listbox\" aria-label=\"Search results\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></div>
<details class=\"vers\"><summary aria-label=\"Docs version: {ver}\">{ver}</summary><ul class=\"vers-menu\"></ul></details>
{theme_button(ko)}
</div>
</div>
{bar}</header>
{banner}<div class=\"shell\">
{aside}<main id=\"content\" class=\"main\">
<article class=\"prose\">
{crumb}{body}{pager}
</article>
{on_page}</main>
</div>
{footer(site, links, note, root + "logo.svg", ko)}<script src=\"{root}search.js\" defer></script>
</body>
</html>
"
}

/// A page of the home site (rok-lang.org): no search, its nav into the
/// newest docs. The landing page (`index.html`) brings its own layout.
pub fn www_page(site: Site, out: str, title: str, body: str) -> str {
    let root = if out == "404.html" { "/" } else { root_of(out) };
    let nav = StrBuf::new();
    nav.push_str(nav_item(esc(latest(site, "learn/index.html")), "Learn", false));
    nav.push_str(nav_item(esc(latest(site, "index.html")), "Docs", false));
    nav.push_str(nav_item(esc(latest(site, "examples/index.html")), "Examples", false));
    nav.push_str(nav_item(esc(site.playground), "Playground", false));
    nav.push_str(nav_item(esc(site.packages), "Stones", false));
    nav.push_str(nav_item(root + "roadmap.html", "Roadmap", out == "roadmap.html"));
    let full = if out == "index.html" { site.title + " - " + site.tagline } else { title + " - " + site.title };
    let url = if out == "index.html" || out == "404.html" { site.base_url + "/" } else { site.base_url + "/" + out };
    let kind = if out == "index.html" { "landing" } else { "plain" };
    let desc = esc(if out == "download.html" { f"Download rok {site.release} for macOS, Linux and Windows: the install script, or an archive with its SHA-256." } else if out == "roadmap.html" { "The rok roadmap: what the current release ships and where the language is headed next." } else { site.description });
    let main = if out == "index.html" { body } else { f"<div class=\"frame page\"><article class=\"prose\">\n{body}</article></div>\n" };
    let install = if out == "download.html" { " aria-current=\"page\"" } else { "" };
    let links = Links { home: root + "index.html", docs: latest(site, "index.html"), learn: latest(site, "learn/index.html"), examples: latest(site, "examples/index.html"), spec: latest(site, "spec/refs-lang/index.html"), api: latest(site, "std/index.html"), tools: latest(site, "spec/refs-lang/009-tools/index.html"), publishing: latest(site, "learn/18-features-and-stones.html#publishing-a-stone"), roadmap: root + "roadmap.html" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"en\">
<head>
{head(site, root, full, desc, url, site.base_url + "/og.png", "")}</head>
<body class=\"{kind} www\" data-root=\"{root}\" data-play=\"{esc(site.playground)}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr top\" lang=\"en\">
<div class=\"frame in\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"26\" height=\"26\">Rok</a>
{TOGGLE}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"Main\">{nav.to_str()}</nav>
<div class=\"tools\">
<a class=\"gh\" href=\"https://github.com/rok-lang/rok\">GitHub</a>
<a class=\"btn btn-sm\" href=\"{root}download.html\"{install}>Install</a>
{theme_button(false)}
</div>
</div>
</header>
<main id=\"content\">
{main}</main>
{footer(site, links, "", root + "logo.svg", false)}<script src=\"{root}search.js\" defer></script>
</body>
</html>
"
}

/// Body of a 404 page, a compiler-style error; search.js fills in the
/// path. `to(p)` is the address of docs page `p`.
pub fn not_found(to: fn(str) -> str, search: bool) -> str {
    let help = if search { "search with <kbd class=\"kbd\">/</kbd>, or start from one of these" } else { "start from one of these" };
    f"<div class=\"lost\">
<h1>Page not found</h1>
<p class=\"lead\">This page rolled away, or it never existed.</p>
<pre class=\"err\"><span class=\"e\">error[E404]</span>: page not found
 <span class=\"g\">--&gt;</span> <span id=\"lost-path\">this address</span>
  <span class=\"g\">|</span>
  <span class=\"g\">=</span> <span class=\"h\">help</span>: {help}</pre>
<p class=\"cta\"><a class=\"btn\" href=\"{esc(to("index.html"))}\">Docs home</a><a href=\"{esc(to("learn/index.html"))}\">Learn</a><a href=\"{esc(to("spec/refs-lang/index.html"))}\">Language</a><a href=\"{esc(to("std/index.html"))}\">Std library</a></p>
</div>
"
}
/// The docs root's `index.html`: off to the newest release.
pub fn to_latest(site: Site) -> str {
    let home = esc(latest(site, "index.html"));
    f"<!doctype html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Rok Docs</title>
<meta http-equiv=\"refresh\" content=\"0; url=latest/index.html\">
<link rel=\"canonical\" href=\"{home}\">
</head>
<body>
<p><a href=\"latest/index.html\">Rok Docs</a></p>
</body>
</html>
"
}
