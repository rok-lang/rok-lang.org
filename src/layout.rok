// Page chrome: header with nav and search, chapter sidebar, prev / next
// pager, footer.

use pkg::Page;
use pkg::Site;
use markdown::{Doc, Options, esc, strip_tags};

/// Markdown as HTML: `link` maps hrefs, ```rok / ```rokon highlighted,
/// ```output as `<pre class="output">`; Korean callout titles if `ko`
/// (Korean spec pages), English otherwise.
pub fn md(src: str, link: fn(str) -> str, ko: bool) -> Doc {
    let o = if ko { Options { link: link, code: code_html, callout: callout_ko } } else { Options { link: link, code: code_html } };
    let d = markdown::render(src, o);
    d.html = d.html.replace("<pre><code class=\"language-output\">", "<pre class=\"output\"><code class=\"language-output\">");
    // The heading permalinks are aria-hidden, so keep them out of the tab order too.
    d.html = d.html.replace("class=\"anchor\" href=", "class=\"anchor\" tabindex=\"-1\" href=");
    d
}

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn callout_ko(kind: str) -> str {
    if kind == "note" {
        "참고"
    } else if kind == "tip" {
        "팁"
    } else if kind == "important" {
        "중요"
    } else if kind == "warning" {
        "경고"
    } else if kind == "caution" {
        "주의"
    } else {
        kind
    }
}

/// The end of a page whose source is at `url`.
pub fn edit_link(url: str, ko: bool) -> str {
    let (ask, label) = if ko { ("잘못된 곳이 있나요?", "GitHub에서 이 페이지 고치기") } else { ("Found a mistake?", "Edit this page on GitHub") };
    f"<p class=\"edit\">{ask} <a href=\"{esc(url)}\">{label}</a>.</p>\n"
}

/// `../` once per directory level of `out`, back to the site root.
pub fn root_of(out: str) -> str {
    let n = 0usize;
    for c in out.chars() {
        if c == '/' { n += 1; }
    }
    "../".repeat(n)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn readme_of(dir: str) -> str {
    if dir.is_empty() { "README.md" } else { dir + "/README.md" }
}

fn is_readme(src: str) -> bool { src == "README.md" || src.ends_with("/README.md") }

/// Relative href from the page at `from` to the site path `to`.
pub fn rel(from: str, to: str) -> str {
    let a: List<str> = List::new();
    for s in dir_of(from).split("/") {
        if !s.is_empty() { a.push(s); }
    }
    let b: List<str> = List::new();
    for s in to.split("/") { b.push(s); }
    let c = 0usize;
    while c < a.len() && c + 1 < b.len() && a[c] == b[c] { c += 1; }
    let out = StrBuf::new();
    for _ in c..a.len() { out.push_str("../"); }
    for k in c..b.len() {
        if k > c { out.push('/'); }
        out.push_str(b[k]);
    }
    out.to_str()
}

fn find(pages: List<Page>, src: str) -> usize | none {
    for k in 0..pages.len() {
        if pages[k].src == src { return k; }
    }
    none
}

/// `"5. Sum Types"` -> `("5", "Sum Types")`; `("", t)` if unnumbered.
pub fn split_no(t: str) -> (str, str) {
    let n = 0usize;
    for c in t.chars() {
        if c < '0' || c > '9' { break; }
        n += 1;
    }
    if n > 0 && t[n:].starts_with(". ") { return (t[:n], t[n + 2:]); }
    ("", t)
}

/// A sidebar link label: the chapter number in its own column.
fn label(t: str) -> str {
    let (no, rest) = split_no(t);
    if no.is_empty() { esc(t) } else { f"<span class=\"no\">{no}</span>{esc(rest)}" }
}

/// A learn chapter's `<h1>N. Title</h1>` as "Chapter N" over the title.
pub fn chapter(html: str, title: str) -> str {
    let (no, rest) = split_no(title);
    if no.is_empty() { return html; }
    let t = esc(rest) + "</h1>";
    let h = html.replace(f"aria-hidden=\"true\">#</a>{no}. {t}", "aria-hidden=\"true\">#</a>" + t);
    if let k: usize = h.find("<h1") { return h[:k] + f"<p class=\"chap\">Chapter {no}</p>\n" + h[k:]; }
    h
}

/// "On this page": the `##` and `###` sections of `p`.
pub fn toc(p: Page) -> str {
    let out = StrBuf::new();
    for h in p.heads {
        if h.level == 2 {
            out.push_str(f"<li><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        } else if h.level == 3 {
            out.push_str(f"<li class=\"sub\"><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        }
    }
    out.to_str()
}

/// The pages of the current chapter (directory): its index, its files
/// and its sub-chapters.
pub fn sidebar(pages: List<Page>, idx: usize) -> str {
    let p = pages[idx];
    let d = p.dir;
    let out = StrBuf::new();
    if !d.is_empty() {
        if let up: usize = find(pages, readme_of(dir_of(d))) {
            out.push_str(f"<a class=\"up\" href=\"{rel(p.out, pages[up].out)}\">← {esc(pages[up].title)}</a>");
        }
    }
    if let h: usize = find(pages, readme_of(d)) {
        let cur = if h == idx { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<p class=\"side-title\"><a{cur} href=\"{rel(p.out, pages[h].out)}\">{esc(pages[h].title)}</a></p>");
    }
    out.push_str("<ul class=\"pages\">");
    for k in 0..pages.len() {
        let q = pages[k];
        let file = q.dir == d && !is_readme(q.src);
        let sub = is_readme(q.src) && q.dir != d && dir_of(q.dir) == d;
        if !file && !sub { continue; }
        let cur = if k == idx { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<li><a{cur} href=\"{rel(p.out, q.out)}\">{label(q.title)}</a></li>");
    }
    out.push_str("</ul>");
    out.to_str()
}

/// First paragraph of a page's HTML (its summary), tags and all.
fn lead(html: str) -> str {
    if let a: usize = html.find("<p>") {
        if let b: usize = html[a:].find("</p>") { return html[a + 3:a + b]; }
    }
    ""
}

/// The summary of a page as plain text.
pub fn lead_text(html: str) -> str { strip_tags(lead(html)).replace("\n", " ").trim() }

/// A section index's list of its pages (after the index itself): a
/// two-column list for `examples/`, numbered chapters otherwise.
pub fn contents(group: List<Page>) -> str {
    let p = group[0];
    let ex = p.out.starts_with("examples/");
    let out = StrBuf::new();
    out.push_str(if ex { "<div class=\"ex-list\">" } else { "<ol class=\"chapters\">" });
    for k in 1..group.len() {
        let q = group[k];
        let href = rel(p.out, q.out);
        if ex {
            out.push_str(f"<a class=\"ex\" href=\"{href}\"><b>{esc(q.title)}</b><span>{esc(lead_text(q.html))}</span></a>");
        } else {
            let (no, rest) = split_no(q.title);
            out.push_str(f"<li><span class=\"no\">{no}</span><div><a href=\"{href}\">{esc(rest)}</a><p>{lead(q.html)}</p></div></li>");
        }
    }
    out.push_str(if ex { "</div>" } else { "</ol>" });
    out.to_str()
}

/// Sidebar of a standalone page: just its title.
pub fn page_toc(p: Page) -> str {
    f"<p class=\"side-title\"><a aria-current=\"page\" href=\"#\">{esc(p.title)}</a></p>"
}

pub fn pager(pages: List<Page>, idx: usize) -> str {
    let p = pages[idx];
    let out = StrBuf::new();
    out.push_str("<nav class=\"pager\" aria-label=\"Previous and next page\">");
    if idx > 0 {
        let q = pages[idx - 1];
        out.push_str(f"<a class=\"prev\" href=\"{rel(p.out, q.out)}\"><small>← Previous</small><span>{esc(q.title)}</span></a>");
    }
    if idx + 1 < pages.len() {
        let q = pages[idx + 1];
        out.push_str(f"<a class=\"next\" href=\"{rel(p.out, q.out)}\"><small>Next →</small><span>{esc(q.title)}</span></a>");
    }
    out.push_str("</nav>");
    out.to_str()
}

fn nav_item(href: str, label: str, on: bool) -> str {
    let cur = if on { " aria-current=\"page\"" } else { "" };
    f"<a href=\"{href}\"{cur}>{label}</a>"
}

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// The page's summary for `<meta name="description">`: its first paragraph.
fn describe(site: Site, out: str, body: str) -> str {
    if out == "index.html" || out == "404.html" { return site.description; }
    let s = lead_text(body);
    if s.is_empty() { site.description } else { clip(s, 160) }
}

const FONTS: str = "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap";
const PRETENDARD: str = "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css";

/// `<head>` from the charset to the icons. `root` leads to the icons and
/// stylesheets, `url` is the canonical address, `img` the og:image.
fn head(site: Site, root: str, full: str, desc: str, url: str, img: str, extra: str) -> str {
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<script>try{{var t=localStorage.getItem(\"theme\");if(t!==\"light\"&&t!==\"dark\")t=matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\";document.documentElement.className=\"rk \"+(t===\"dark\"?\"dk\":\"lt\")}}catch(e){{document.documentElement.className=\"rk lt\"}}</script>
<meta name=\"description\" content=\"{desc}\">
<link rel=\"canonical\" href=\"{esc(url)}\">
{extra}<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
<meta property=\"og:url\" content=\"{esc(url)}\">
<meta property=\"og:image\" content=\"{esc(img)}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"theme-color\" content=\"#fbfbfc\" media=\"(prefers-color-scheme: light)\">
<meta name=\"theme-color\" content=\"#0f1013\" media=\"(prefers-color-scheme: dark)\">
<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">
<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
<link rel=\"stylesheet\" href=\"{esc(FONTS)}\">
<link rel=\"stylesheet\" href=\"{PRETENDARD}\">
<link rel=\"stylesheet\" href=\"{root}rok.css\">
<link rel=\"stylesheet\" href=\"{root}style.css\">
<link rel=\"icon\" href=\"{root}logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
"
}

/// The address of `path` in the newest release's docs.
pub fn latest(site: Site, path: str) -> str { site.docs_url + "/latest/" + path }

const ICON_SEARCH: str = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>";
const ICON_THEME: str = "<svg class=\"moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>";

const TOGGLE: str = "<button class=\"nav-toggle\" type=\"button\" aria-label=\"Menu\" aria-expanded=\"false\" aria-controls=\"nav\"><span class=\"bars\"></span></button>";

/// Where the footer's links go, from the page it sits on.
struct Links {
    home: str;
    docs: str;
    learn: str;
    examples: str;
    spec: str;
    api: str;
    tools: str;
    publishing: str;
    roadmap: str;
}

fn footer(site: Site, l: Links, note: str, logo: str) -> str {
    let gh = "https://github.com/rok-lang";
    let col = |head: str, items: str| f"<div class=\"col\"><p class=\"t-label\">{head}</p>{items}</div>";
    f"<footer class=\"foot\" lang=\"en\">
<div class=\"frame cols\">
<div class=\"about\"><a class=\"brand\" href=\"{esc(l.home)}\"><img src=\"{logo}\" alt=\"\" width=\"24\" height=\"24\">Rok</a><p>{esc(site.tagline)}.</p><p class=\"social\"><a href=\"{gh}\">GitHub</a><a href=\"https://x.com/roklangorg\">X</a><a href=\"https://bsky.app/profile/rok-lang.org\">Bluesky</a><a rel=\"me\" href=\"https://mastodon.social/@roklang\">Mastodon</a></p></div>
{col("Learn", f"<a href=\"{esc(l.learn)}\">Guide</a><a href=\"{esc(l.examples)}\">Examples</a><a href=\"{esc(site.playground)}\">Playground</a>")}
{col("Reference", f"<a href=\"{esc(l.spec)}\">Language spec</a><a href=\"{esc(l.api)}\">Std library</a><a href=\"{esc(l.tools)}\">Tools</a>")}
{col("Ecosystem", f"<a href=\"{esc(site.packages)}\">Stones</a><a href=\"{esc(l.publishing)}\">Publishing</a><a href=\"{gh}/rok.vscode\">VS Code</a><a href=\"{gh}/rok.vim\">Vim</a>")}
{col("Project", f"<a href=\"{esc(l.roadmap)}\">Roadmap</a><a href=\"{gh}/rok\">GitHub</a><a href=\"{gh}/rok/blob/main/SECURITY.md\">Security</a><a href=\"{gh}/rok/blob/main/CODE_OF_CONDUCT.md\">Code of conduct</a><a href=\"mailto:contact@rok-lang.org\">Contact</a>")}
</div>
<div class=\"frame bar\">
<nav aria-label=\"Rok sites\"><a href=\"{esc(l.home)}\">Home</a><a href=\"{esc(l.docs)}\">Docs</a><a href=\"{esc(site.packages)}\">Stones</a><a href=\"{esc(site.playground)}\">Playground</a></nav>
<span class=\"mono\">rok {esc(site.release)}</span>
<span>MIT OR Apache-2.0</span>{note}
<span class=\"seg\" role=\"group\" aria-label=\"Theme\"><button type=\"button\" data-theme-set=\"auto\">System</button><button type=\"button\" data-theme-set=\"light\">Light</button><button type=\"button\" data-theme-set=\"dark\">Dark</button></span>
</div>
</footer>
"
}

/// The section a docs page belongs to: (label, index page).
fn section(at: str) -> (str, str) {
    if at.starts_with("learn/") { return ("Learn", "learn/index.html"); }
    if at.starts_with("examples/") { return ("Examples", "examples/index.html"); }
    if at.starts_with("spec/refs-lang/009-tools/") { return ("Tools", "spec/refs-lang/009-tools/index.html"); }
    if at.starts_with("spec/refs-lang/") { return ("Language", "spec/refs-lang/index.html"); }
    if at.starts_with("spec/refs-standard-libraries/") || at.starts_with("std/") { return ("Std library", "std/index.html"); }
    if at.starts_with("spec/") { return ("Spec", "spec/index.html"); }
    ("", "")
}

/// A page of the docs of one version, `out` relative to that version's
/// root. search.js fills the version menu and banner from `versions.json`
/// beside the version directories.
pub fn page(site: Site, out: str, title: str, side: str, toc: str, body: str, pager: str) -> str {
    // The 404 page sits above the versions and is served for any missing
    // path, so it borrows the newest release's files.
    let root = if out == "404.html" { "/latest/" } else { root_of(out) };
    let ko = out.starts_with("ko/");
    // Nav state of a Korean spec page is that of its English twin.
    let at = if ko { out["ko/".len():] } else { out };
    let (sec, sec_index) = section(at);
    let nav = StrBuf::new();
    for (label, href) in [("Learn", "learn/index.html"), ("Examples", "examples/index.html"), ("Language", "spec/refs-lang/index.html"), ("Std library", "std/index.html"), ("Tools", "spec/refs-lang/009-tools/index.html")] {
        nav.push_str(nav_item(root + href, label, sec == label));
    }
    let name = site.title + " Docs";
    let full = if out == "index.html" { name } else { title + " - " + name };
    let aside = if side.is_empty() {
        ""
    } else {
        f"<nav class=\"side\" aria-label=\"Contents\"><details open><summary>Contents</summary>{side}</details></nav>\n"
    };
    let on_page = if toc.is_empty() { "" } else { f"<aside class=\"toc\" aria-label=\"On this page\"><p class=\"t-label\">On this page</p><ul>{toc}</ul></aside>\n" };
    let kind = if out == "index.html" { "home" } else if side.is_empty() { "doc wide" } else { "doc" };
    let crumb = if sec.is_empty() || at == sec_index || out == "404.html" { "" } else { f"<nav class=\"crumb\" aria-label=\"Breadcrumb\"><a href=\"{root}{sec_index}\">{sec}</a></nav>\n" };
    let lang = if ko { "ko" } else { "en" };
    let desc = esc(describe(site, out, body));
    let url = latest(site, if out == "index.html" || out == "404.html" { "" } else { out });
    // Unreleased docs stay out of search engines.
    let robots = if site.version == "dev" { "<meta name=\"robots\" content=\"noindex\">\n" } else { "" };
    let ver = if site.version == "dev" { "dev" } else { "v" + site.version };
    let links = Links { home: site.base_url, docs: root + "index.html", learn: root + "learn/index.html", examples: root + "examples/index.html", spec: root + "spec/refs-lang/index.html", api: root + "std/index.html", tools: root + "spec/refs-lang/009-tools/index.html", publishing: root + "learn/18-features-and-stones.html#publishing-a-stone", roadmap: site.base_url + "/roadmap" };
    let note = if at.starts_with("spec/") { "<span>Spec text © Han Damin, <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a></span>" } else { "" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"{lang}\">
<head>
{head(site, root, full, desc, url, latest(site, "og.png"), robots)}</head>
<body class=\"{kind}\" data-root=\"{root}\" data-version=\"{esc(site.version)}\" data-play=\"{esc(site.playground)}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr top\" lang=\"en\">
<div class=\"in\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"24\" height=\"24\">Rok<span class=\"sl\">/</span><span class=\"site\">Docs</span></a>
{TOGGLE}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"Sections\">{nav.to_str()}</nav>
<div class=\"tools\">
<div class=\"search\" role=\"search\">{ICON_SEARCH}<input id=\"q\" type=\"search\" placeholder=\"Search docs\" aria-label=\"Search docs\" aria-keyshortcuts=\"/\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"results\"><kbd class=\"kbd\" aria-hidden=\"true\">/</kbd><ul id=\"results\" class=\"results\" role=\"listbox\" aria-label=\"Search results\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></div>
<details class=\"vers\"><summary aria-label=\"Docs version: {ver}\">{ver}</summary><ul class=\"vers-menu\"></ul></details>
<button class=\"ib theme\" type=\"button\" aria-label=\"Switch theme\">{ICON_THEME}</button>
</div>
</div>
</header>
<div class=\"shell\">
{aside}<main id=\"content\" class=\"main\">
<article class=\"prose\">
{crumb}{body}{pager}
</article>
{on_page}</main>
</div>
{footer(site, links, note, root + "logo.svg")}<script src=\"{root}search.js\" defer></script>
</body>
</html>
"
}

/// A page of the home site (rok-lang.org): no search, its nav into the
/// newest docs. The landing page (`index.html`) brings its own layout.
pub fn www_page(site: Site, out: str, title: str, body: str) -> str {
    let root = if out == "404.html" { "/" } else { root_of(out) };
    let nav = StrBuf::new();
    nav.push_str(nav_item(esc(latest(site, "learn/index.html")), "Learn", false));
    nav.push_str(nav_item(esc(latest(site, "index.html")), "Docs", false));
    nav.push_str(nav_item(esc(latest(site, "examples/index.html")), "Examples", false));
    nav.push_str(nav_item(esc(site.playground), "Playground", false));
    nav.push_str(nav_item(esc(site.packages), "Stones", false));
    nav.push_str(nav_item(root + "roadmap.html", "Roadmap", out == "roadmap.html"));
    let full = if out == "index.html" { site.title + " - " + site.tagline } else { title + " - " + site.title };
    let url = if out == "index.html" || out == "404.html" { site.base_url + "/" } else { site.base_url + "/" + out };
    let kind = if out == "index.html" { "landing" } else { "plain" };
    let desc = esc(if out == "download.html" { f"Download rok {site.release} for macOS, Linux and Windows: the install script, or an archive with its SHA-256." } else if out == "roadmap.html" { "The rok roadmap: what the current release ships and where the language is headed next." } else { site.description });
    let main = if out == "index.html" { body } else { f"<div class=\"frame page\"><article class=\"prose\">\n{body}</article></div>\n" };
    let install = if out == "download.html" { " aria-current=\"page\"" } else { "" };
    let links = Links { home: root + "index.html", docs: latest(site, "index.html"), learn: latest(site, "learn/index.html"), examples: latest(site, "examples/index.html"), spec: latest(site, "spec/refs-lang/index.html"), api: latest(site, "std/index.html"), tools: latest(site, "spec/refs-lang/009-tools/index.html"), publishing: latest(site, "learn/18-features-and-stones.html#publishing-a-stone"), roadmap: root + "roadmap.html" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"en\">
<head>
{head(site, root, full, desc, url, site.base_url + "/og.png", "")}</head>
<body class=\"{kind} www\" data-root=\"{root}\" data-play=\"{esc(site.playground)}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr top\" lang=\"en\">
<div class=\"frame in\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"26\" height=\"26\">Rok</a>
{TOGGLE}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"Main\">{nav.to_str()}</nav>
<div class=\"tools\">
<a class=\"gh\" href=\"https://github.com/rok-lang/rok\">GitHub</a>
<a class=\"btn btn-sm\" href=\"{root}download.html\"{install}>Install</a>
<button class=\"ib theme\" type=\"button\" aria-label=\"Switch theme\">{ICON_THEME}</button>
</div>
</div>
</header>
<main id=\"content\">
{main}</main>
{footer(site, links, "", root + "logo.svg")}<script src=\"{root}search.js\" defer></script>
</body>
</html>
"
}

/// Body of a 404 page, a compiler-style error; search.js fills in the
/// path. `to(p)` is the address of docs page `p`.
pub fn not_found(to: fn(str) -> str, search: bool) -> str {
    let help = if search { "search with <kbd class=\"kbd\">/</kbd>, or start from one of these" } else { "start from one of these" };
    f"<div class=\"lost\">
<h1>Page not found</h1>
<p class=\"lead\">This page rolled away, or it never existed.</p>
<pre class=\"err\"><span class=\"e\">error[E404]</span>: page not found
 <span class=\"g\">--&gt;</span> <span id=\"lost-path\">this address</span>
  <span class=\"g\">|</span>
  <span class=\"g\">=</span> <span class=\"h\">help</span>: {help}</pre>
<p class=\"cta\"><a class=\"btn\" href=\"{esc(to("index.html"))}\">Docs home</a><a href=\"{esc(to("learn/index.html"))}\">Learn</a><a href=\"{esc(to("spec/refs-lang/index.html"))}\">Language</a><a href=\"{esc(to("std/index.html"))}\">Std library</a></p>
</div>
"
}
/// The docs root's `index.html`: off to the newest release.
pub fn to_latest(site: Site) -> str {
    let home = esc(latest(site, "index.html"));
    f"<!doctype html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Rok Docs</title>
<meta http-equiv=\"refresh\" content=\"0; url=latest/index.html\">
<link rel=\"canonical\" href=\"{home}\">
</head>
<body>
<p><a href=\"latest/index.html\">Rok Docs</a></p>
</body>
</html>
"
}
