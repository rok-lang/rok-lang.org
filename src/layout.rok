// Page chrome: header with nav and search, chapter sidebar, prev / next
// pager, footer.

use pkg::Page;
use pkg::Site;
use markdown::{Doc, Options, esc, strip_tags};

/// Markdown as HTML: `link` maps hrefs, ```rok / ```rokon highlighted,
/// ```output as `<pre class="output">`; Korean callout titles if `ko`
/// (Korean spec pages), English otherwise.
pub fn md(src: str, link: fn(str) -> str, ko: bool) -> Doc {
    let o = if ko { Options { link: link, code: code_html, callout: callout_ko } } else { Options { link: link, code: code_html } };
    let d = markdown::render(src, o);
    d.html = d.html.replace("<pre><code class=\"language-output\">", "<pre class=\"output\"><code class=\"language-output\">");
    // The heading permalinks are aria-hidden, so keep them out of the tab order too.
    d.html = d.html.replace("class=\"anchor\" href=", "class=\"anchor\" tabindex=\"-1\" href=");
    d.html = code_blocks(d.html, ko);
    d
}

/// Visible text of highlighted code: tags dropped, entities decoded.
fn code_text(html: str) -> str {
    strip_tags(html).replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")
}

fn text_lines(text: str) -> List<str> {
    let ls: List<str> = List::new();
    for l in text.trim_end_matches("\n").split("\n") { ls.push(l); }
    ls
}

fn widest(ls: List<str>) -> usize {
    let w = 0usize;
    for l in ls {
        if l.char_count() > w { w = l.char_count(); }
    }
    w
}

/// Fenced code as a `.code.cb` block: its bar, the output that follows
/// it folded in, side by side when both are short, folded when long.
/// Decided here, not in search.js, so nothing moves once the page shows;
/// search.js only adds the buttons to the bar.
fn code_blocks(html: str, ko: bool) -> str {
    let open = "<pre><code";
    let close = "</code></pre>";
    let out = StrBuf::new();
    let rest = html;
    loop {
        let k = rest.find(open) ?? rest.len();
        out.push_str(rest[:k]);
        rest = rest[k:];
        if rest.is_empty() { break; }
        let e = rest.find(close) ?? 0;
        let b = (rest[open.len():].find(">") ?? 0) + open.len() + 1;
        if e < b {
            out.push_str(rest);
            break;
        }
        let lang = "";
        let cls = "<pre><code class=\"language-";
        if rest.starts_with(cls) {
            if let q: usize = rest[cls.len():].find("\"") { lang = rest[cls.len():cls.len() + q]; }
        }
        let code = rest[:e + close.len()];
        let c = text_lines(code_text(rest[b:e]));
        rest = rest[e + close.len():];
        let output = "";
        let t = rest.trim_start();
        if t.starts_with("<pre class=\"output\">") {
            if let oe: usize = t.find(close) {
                output = t[:oe + close.len()];
                rest = t[oe + close.len():];
            }
        }
        let side = if output.is_empty() {
            false
        } else {
            let o = text_lines(code_text(output));
            o.len() <= c.len() && widest(o) <= 28 && widest(c) <= 60
        };
        // search.js clips a block taller than 440px (20 lines of 22px).
        let tall = c.len() > 20;
        let label = if lang == "text" { "" } else { lang };
        let fold = if tall { " tall collapsed" } else { "" };
        let two = if side { " side-by-side" } else { "" };
        out.push_str(f"<div class=\"code cb{fold}\"><div class=\"cb-h\"><span class=\"t-label\">{label}</span></div><div class=\"cb-body{two}\">{code}{output}</div>");
        if tall {
            let more = if ko { f"{c.len()}줄 모두 보기" } else { f"Show all {c.len()} lines" };
            out.push_str(f"<button type=\"button\" class=\"expand\" aria-expanded=\"false\">{more}</button>");
        }
        out.push_str("</div>\n");
    }
    out.to_str()
}

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn callout_ko(kind: str) -> str {
    if kind == "note" {
        "참고"
    } else if kind == "tip" {
        "팁"
    } else if kind == "important" {
        "중요"
    } else if kind == "warning" {
        "경고"
    } else if kind == "caution" {
        "주의"
    } else {
        kind
    }
}

/// The end of a page whose source is at `url`.
pub fn edit_link(url: str, ko: bool) -> str {
    let (ask, label) = if ko { ("잘못된 곳이 있나요?", "GitHub에서 이 페이지 고치기") } else { ("Found a mistake?", "Edit this page on GitHub") };
    f"<p class=\"edit\">{ask} <a href=\"{esc(url)}\">{label}</a>.</p>\n"
}

/// `../` once per directory level of `out`, back to the site root.
pub fn root_of(out: str) -> str {
    let n = 0usize;
    for c in out.chars() {
        if c == '/' { n += 1; }
    }
    "../".repeat(n)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn readme_of(dir: str) -> str {
    if dir.is_empty() { "README.md" } else { dir + "/README.md" }
}

fn is_readme(src: str) -> bool { src == "README.md" || src.ends_with("/README.md") }

/// Relative href from the page at `from` to the site path `to`.
pub fn rel(from: str, to: str) -> str {
    let a: List<str> = List::new();
    for s in dir_of(from).split("/") {
        if !s.is_empty() { a.push(s); }
    }
    let b: List<str> = List::new();
    for s in to.split("/") { b.push(s); }
    let c = 0usize;
    while c < a.len() && c + 1 < b.len() && a[c] == b[c] { c += 1; }
    let out = StrBuf::new();
    for _ in c..a.len() { out.push_str("../"); }
    for k in c..b.len() {
        if k > c { out.push('/'); }
        out.push_str(b[k]);
    }
    out.to_str()
}

fn find(pages: List<Page>, src: str) -> usize | none {
    for k in 0..pages.len() {
        if pages[k].src == src { return k; }
    }
    none
}

/// `"5. Sum Types"` -> `("5", "Sum Types")`; `("", t)` if unnumbered.
pub fn split_no(t: str) -> (str, str) {
    let n = 0usize;
    for c in t.chars() {
        if c < '0' || c > '9' { break; }
        n += 1;
    }
    if n > 0 && t[n:].starts_with(". ") { return (t[:n], t[n + 2:]); }
    ("", t)
}

/// A sidebar link label: the chapter number in its own column.
fn label(t: str) -> str {
    let (no, rest) = split_no(t);
    if no.is_empty() { esc(t) } else { f"<span class=\"no\">{no}</span>{esc(rest)}" }
}

/// A learn chapter's `<h1>N. Title</h1>` as "Chapter N" over the title.
pub fn chapter(html: str, title: str) -> str {
    let (no, rest) = split_no(title);
    if no.is_empty() { return html; }
    let t = esc(rest) + "</h1>";
    let h = html.replace(f"aria-hidden=\"true\">#</a>{no}. {t}", "aria-hidden=\"true\">#</a>" + t);
    if let k: usize = h.find("<h1") { return h[:k] + f"<p class=\"chap\">Chapter {no}</p>\n" + h[k:]; }
    h
}

/// "On this page": the `##` and `###` sections of `p`.
pub fn toc(p: Page) -> str {
    let out = StrBuf::new();
    for h in p.heads {
        if h.level == 2 {
            out.push_str(f"<li><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        } else if h.level == 3 {
            out.push_str(f"<li class=\"sub\"><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        }
    }
    out.to_str()
}

/// The pages of the current chapter (directory): its index, its files
/// and its sub-chapters.
pub fn sidebar(pages: List<Page>, idx: usize) -> str {
    let p = pages[idx];
    let d = p.dir;
    let out = StrBuf::new();
    if !d.is_empty() {
        if let up: usize = find(pages, readme_of(dir_of(d))) {
            out.push_str(f"<a class=\"up\" href=\"{rel(p.out, pages[up].out)}\">← {esc(pages[up].title)}</a>");
        }
    }
    if let h: usize = find(pages, readme_of(d)) {
        let cur = if h == idx { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<p class=\"side-title\"><a{cur} href=\"{rel(p.out, pages[h].out)}\">{esc(pages[h].title)}</a></p>");
    }
    out.push_str("<ul class=\"pages\">");
    for k in 0..pages.len() {
        let q = pages[k];
        let file = q.dir == d && !is_readme(q.src);
        let sub = is_readme(q.src) && q.dir != d && dir_of(q.dir) == d;
        if !file && !sub { continue; }
        let cur = if k == idx { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<li><a{cur} href=\"{rel(p.out, q.out)}\">{label(q.title)}</a></li>");
    }
    out.push_str("</ul>");
    out.to_str()
}

/// First paragraph of a page's HTML (its summary), tags and all.
fn lead(html: str) -> str {
    if let a: usize = html.find("<p>") {
        if let b: usize = html[a:].find("</p>") { return html[a + 3:a + b]; }
    }
    ""
}

/// The summary of a page as plain text.
pub fn lead_text(html: str) -> str { strip_tags(lead(html)).replace("\n", " ").trim() }

/// A section index's list of its pages (after the index itself): a
/// two-column list for `examples/`, numbered chapters otherwise.
pub fn contents(group: List<Page>) -> str {
    let p = group[0];
    let ex = p.out.starts_with("examples/");
    let out = StrBuf::new();
    out.push_str(if ex { "<div class=\"ex-list\">" } else { "<ol class=\"chapters\">" });
    for k in 1..group.len() {
        let q = group[k];
        let href = rel(p.out, q.out);
        if ex {
            out.push_str(f"<a class=\"ex\" href=\"{href}\"><b>{esc(q.title)}</b><span>{esc(lead_text(q.html))}</span></a>");
        } else {
            let (no, rest) = split_no(q.title);
            out.push_str(f"<li><span class=\"no\">{no}</span><div><a href=\"{href}\">{esc(rest)}</a><p>{lead(q.html)}</p></div></li>");
        }
    }
    out.push_str(if ex { "</div>" } else { "</ol>" });
    out.to_str()
}

/// Sidebar of a standalone page: just its title.
pub fn page_toc(p: Page) -> str {
    f"<p class=\"side-title\"><a aria-current=\"page\" href=\"#\">{esc(p.title)}</a></p>"
}

pub fn pager(pages: List<Page>, idx: usize) -> str {
    let p = pages[idx];
    let out = StrBuf::new();
    out.push_str("<nav class=\"pager\" aria-label=\"Previous and next page\">");
    if idx > 0 {
        let q = pages[idx - 1];
        out.push_str(f"<a class=\"prev\" href=\"{rel(p.out, q.out)}\"><small>← Previous</small><span>{esc(q.title)}</span></a>");
    }
    if idx + 1 < pages.len() {
        let q = pages[idx + 1];
        out.push_str(f"<a class=\"next\" href=\"{rel(p.out, q.out)}\"><small>Next →</small><span>{esc(q.title)}</span></a>");
    }
    out.push_str("</nav>");
    out.to_str()
}

fn nav_item(href: str, label: str, on: bool) -> str {
    let cur = if on { " aria-current=\"page\"" } else { "" };
    f"<a href=\"{href}\"{cur}>{label}</a>"
}

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// The page's summary for `<meta name="description">`: its first paragraph.
fn describe(site: Site, out: str, body: str) -> str {
    if out == "index.html" || out == "404.html" { return site.description; }
    let s = lead_text(body);
    if s.is_empty() { site.description } else { clip(s, 160) }
}

const FONTS: str = "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap";
const PRETENDARD: str = "https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css";

/// `<head>` from the charset to the icons. `root` leads to the icons and
/// stylesheets, `url` is the canonical address, `img` the og:image.
fn head(site: Site, root: str, full: str, desc: str, url: str, img: str, extra: str) -> str {
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<script>try{{var m=document.cookie.match(/(?:^|; )theme=(light|dark)(?:;|$)/),t=m?m[1]:localStorage.getItem(\"theme\");if(t!==\"light\"&&t!==\"dark\")t=matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\";document.documentElement.className=\"rk \"+(t===\"dark\"?\"dk\":\"lt\")}}catch(e){{document.documentElement.className=\"rk lt\"}}</script>
<meta name=\"description\" content=\"{desc}\">
<link rel=\"canonical\" href=\"{esc(url)}\">
{extra}<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
<meta property=\"og:url\" content=\"{esc(url)}\">
<meta property=\"og:image\" content=\"{esc(img)}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"theme-color\" content=\"#fbfbfc\" media=\"(prefers-color-scheme: light)\">
<meta name=\"theme-color\" content=\"#0f1013\" media=\"(prefers-color-scheme: dark)\">
<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">
<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
<link rel=\"stylesheet\" href=\"{esc(FONTS)}\">
<link rel=\"stylesheet\" href=\"{PRETENDARD}\">
<link rel=\"stylesheet\" href=\"{root}rok.css\">
<link rel=\"stylesheet\" href=\"{root}style.css\">
<link rel=\"icon\" href=\"{root}logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
"
}

/// The address of `path` in the newest release's docs.
pub fn latest(site: Site, path: str) -> str { site.docs_url + "/latest/" + path }

const ICON_SEARCH: str = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>";
const ICON_THEME: str = "<svg class=\"moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>";

const ICON_SIDE: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16\"/></svg>";
const ICON_CLOSE: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>";

const TOGGLE: str = "<button class=\"nav-toggle\" type=\"button\" aria-label=\"Menu\" aria-expanded=\"false\" aria-controls=\"nav\"><span class=\"bars\"></span></button>";

/// Where the footer's links go, from the page it sits on.
struct Links {
    home: str;
    docs: str;
    learn: str;
    examples: str;
    spec: str;
    api: str;
    tools: str;
    publishing: str;
    roadmap: str;
}

/// The header's theme button; search.js keeps aria-pressed and the title
/// in step with the theme.
fn theme_button(ko: bool) -> str {
    let (label, title) = if ko { ("다크 테마", "다크 테마로 바꾸기") } else { ("Dark theme", "Switch to dark theme") };
    f"<button class=\"ib theme\" type=\"button\" aria-label=\"{label}\" aria-pressed=\"false\" title=\"{title}\">{ICON_THEME}</button>"
}

/// The footer's System / Light / Dark switch.
fn theme_seg(ko: bool) -> str {
    let (lang, group, sys, light, dark) = if ko { ("ko", "테마", "시스템", "라이트", "다크") } else { ("en", "Theme", "System", "Light", "Dark") };
    f"<span class=\"seg\" role=\"group\" aria-label=\"{group}\" lang=\"{lang}\"><button type=\"button\" data-theme-set=\"auto\" aria-pressed=\"false\">{sys}</button><button type=\"button\" data-theme-set=\"light\" aria-pressed=\"false\">{light}</button><button type=\"button\" data-theme-set=\"dark\" aria-pressed=\"false\">{dark}</button></span>"
}

fn footer(site: Site, l: Links, note: str, logo: str, ko: bool) -> str {
    let gh = "https://github.com/rok-lang";
    let col = |head: str, items: str| f"<div class=\"col\"><p class=\"t-label\">{head}</p>{items}</div>";
    f"<footer class=\"foot\" lang=\"en\">
<div class=\"frame cols\">
<div class=\"about\"><a class=\"brand\" href=\"{esc(l.home)}\"><img src=\"{logo}\" alt=\"\" width=\"24\" height=\"24\">Rok</a><p>{esc(site.tagline)}.</p><span class=\"social\"><a href=\"https://github.com/rok-lang\" aria-label=\"GitHub\" title=\"GitHub\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\"/></svg></a><a href=\"https://x.com/roklangorg\" aria-label=\"X\" title=\"X\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z\"/></svg></a><a href=\"https://bsky.app/profile/rok-lang.org\" aria-label=\"Bluesky\" title=\"Bluesky\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.74