// Page chrome: header with nav and search, chapter sidebar, prev / next
// pager, footer.

use pkg::Page;
use pkg::Frag;
use pkg::Site;
use web::chrome;
use web::url;
use markdown::{Doc, Heading, Options, esc, strip_tags};

/// Markdown as HTML: `link` maps hrefs, ```rok / ```rokon highlighted,
/// ```output as `<pre class="output">`; Korean callout titles if `ko`
/// (Korean spec pages), English otherwise.
pub fn md(src: str, link: fn(str) -> str, ko: bool) -> Doc {
    // Fragments of links into the docs follow the tidied heading ids.
    let fix = |h: str| tidy_ref(link(h));
    let o = if ko { Options { link: fix, code: code_html, callout: callout_ko } } else { Options { link: fix, code: code_html } };
    let d = markdown::render(src, o);
    d.html = d.html.replace("<pre><code class=\"language-output\">", "<pre class=\"output\"><code class=\"language-output\">");
    // The heading permalinks are links in their own right: named, focusable.
    d.html = d.html.replace(" aria-hidden=\"true\">#</a>", f" aria-label=\"{anchor_label(ko)}\">#</a>");
    d = tidy_ids(d);
    d.html = code_blocks(d.html, ko);
    d
}

/// The accessible name of a heading's permalink.
pub fn anchor_label(ko: bool) -> str { if ko { "이 절의 링크" } else { "Link to this section" } }

/// A heading slug with each run of dashes collapsed and none at either
/// end: `31410-the--operator---early-return-of-none` ->
/// `31410-the-operator-early-return-of-none`.
pub fn tidy(id: str) -> str {
    let out = StrBuf::new();
    let dash = false;
    for c in id.chars() {
        if c == '-' {
            dash = true;
            continue;
        }
        if dash && !out.is_empty() { out.push('-'); }
        dash = false;
        out.push(c);
    }
    let t = out.to_str();
    if t.is_empty() { id } else { t }
}

/// `href` with its fragment tidied, for links within the docs.
pub fn tidy_ref(href: str) -> str {
    if href.contains("://") || href.starts_with("mailto:") { return href; }
    let k = href.find("#") ?? return href;
    href[:k + 1] + tidy(href[k + 1:])
}

/// `d` with its heading ids tidied. The old id stays on an empty span in
/// the heading, so links written before (and other sites') still land.
/// An id whose tidy form another heading has keeps its old form.
fn tidy_ids(d: Doc) -> Doc {
    let have: Set<str> = Set::new();
    for h in d.headings { have.insert(h.id); }
    for k in 0..d.headings.len() {
        let h = d.headings[k];
        let id = tidy(h.id);
        if id == h.id || have.contains(id) { continue; }
        let old = f"id=\"{h.id}\"><a class=\"anchor\" href=\"#{h.id}\"";
        if !d.html.contains(old) { continue; }
        d.html = d.html.replace(old, f"id=\"{id}\"><span id=\"{h.id}\" class=\"old-id\"></span><a class=\"anchor\" href=\"#{id}\"");
        have.insert(id);
        d.headings[k] = Heading { level: h.level, id: id, text: h.text };
    }
    d
}

/// Visible text of highlighted code: tags dropped, entities decoded.
fn code_text(html: str) -> str {
    strip_tags(html).replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")
}

fn text_lines(text: str) -> List<str> {
    let ls: List<str> = List::new();
    for l in text.trim_end_matches("\n").split("\n") { ls.push(l); }
    ls
}

fn widest(ls: List<str>) -> usize {
    let w = 0usize;
    for l in ls {
        if l.char_count() > w { w = l.char_count(); }
    }
    w
}

/// Fenced code as a `.code.cb` block: its bar, the output that follows
/// it folded in, side by side when both are short, folded when long.
/// Decided here, not in search.js, so nothing moves once the page shows;
/// search.js only adds the buttons to the bar.
fn code_blocks(html: str, ko: bool) -> str {
    let open = "<pre><code";
    let close = "</code></pre>";
    let out = StrBuf::new();
    let rest = html;
    loop {
        let k = rest.find(open) ?? rest.len();
        out.push_str(rest[:k]);
        rest = rest[k:];
        if rest.is_empty() { break; }
        let e = rest.find(close) ?? 0;
        let b = (rest[open.len():].find(">") ?? 0) + open.len() + 1;
        if e < b {
            out.push_str(rest);
            break;
        }
        let code = rest[:e + close.len()];
        let raw = code_text(rest[b:e]);
        // rokc's diagnostics (a ```text block that starts with one) as
        // the terminal that printed them.
        if rest.starts_with("<pre><code class=\"language-text\"") && (raw.starts_with("error[") || raw.starts_with("warning[")) {
            out.push_str(f"<pre class=\"term diag\">{diag_html(raw)}</pre>\n");
            rest = rest[e + close.len():];
            continue;
        }
        let c = text_lines(raw);
        rest = rest[e + close.len():];
        let output = "";
        let t = rest.trim_start();
        if t.starts_with("<pre class=\"output\">") {
            if let oe: usize = t.find(close) {
                output = t[:oe + close.len()];
                rest = t[oe + close.len():];
            }
        }
        let side = if output.is_empty() {
            false
        } else {
            let o = text_lines(code_text(output));
            o.len() <= c.len() && widest(o) <= 28 && widest(c) <= 60
        };
        // search.js clips a block taller than 440px (20 lines of 22px).
        let tall = c.len() > 20;
        // The bar names the file the block shows, else its language.
        let label = file_label(c);
        if label.is_empty() { label = code_lang(code); }
        let name = if label.is_empty() { "" } else { f"<span class=\"t-label\">{label}</span>" };
        let fold = if tall { " tall collapsed" } else { "" };
        let two = if side { " side-by-side" } else { "" };
        out.push_str(f"<div class=\"code cb{fold}\"><div class=\"cb-h\">{name}</div><div class=\"cb-body{two}\">{code}{output}</div>");
        if tall {
            let more = if ko { f"{c.len()}줄 모두 보기" } else { f"Show all {c.len()} lines" };
            out.push_str(f"<button type=\"button\" class=\"expand\" aria-expanded=\"false\">{more}</button>");
        }
        out.push_str("</div>\n");
    }
    out.to_str()
}

/// rokc's output (plain text) in its terminal colours (`.term` classes):
/// status verbs, error and warning codes, the `-->` / `|` gutter, the
/// carets, `= help`.
pub fn diag_html(out: str) -> str {
    let b = StrBuf::new();
    for raw in out.trim_end().lines() {
        let l = esc(raw);
        let t = l.trim_start();
        let pad = l[:l.len() - t.len()];
        if t.starts_with("Compiling ") || t.starts_with("Finished ") || t.starts_with("Running ") || t.starts_with("Checking ") || t.starts_with("Checked ") {
            let (w, rest) = t.split_once(" ") ?? (t, "");
            b.push_str(f"<span class=\"v\">{pad}{w}</span> {rest}\n");
        } else if t.starts_with("error[") || t.starts_with("warning[") || t.starts_with("error:") || t.starts_with("warning:") {
            let e = (t.find(if t.contains("[") && (t.find("[") ?? 99) < 8 { "]" } else { ":" }) ?? 0) + 1;
            let cls = if t.starts_with("error") { "e" } else { "w" };
            b.push_str(f"{pad}<span class=\"{cls}\">{t[:e]}</span>{t[e:]}\n");
        } else if t.starts_with("--&gt;") {
            b.push_str(f"{pad}<span class=\"g\">--&gt;</span>{t["--&gt;".len():]}\n");
        } else if t.starts_with("= ") {
            let rest = t[2:];
            let (w, tail) = rest.split_once(":") ?? (rest, "");
            b.push_str(f"{pad}<span class=\"g\">=</span> <span class=\"h\">{w}</span>:{tail}\n");
        } else if let k: usize = t.find("|") {
            let gutter = t[:k + 1];
            let rest = t[k + 1:];
            let num = gutter[:k].trim();
            let is_gutter = num.is_empty() || num.chars().all(|c| c >= '0' && c <= '9');
            if !is_gutter {
                b.push_str(l + "\n");
                continue;
            }
            let marks = !rest.trim().is_empty() && rest.trim().replace("^", "").replace("-", "").is_empty();
            let tail = if marks { f"<span class=\"e\">{rest}</span>" } else { rest };
            b.push_str(f"{pad}<span class=\"g\">{gutter}</span>{tail}\n");
        } else {
            b.push_str(l + "\n");
        }
    }
    b.to_str().trim_end()
}

/// The file a block names on its first line (`// src/main.rok`,
/// `# rok.rokon`), for its bar; `""` when it names none.
fn file_label(lines: List<str>) -> str {
    if lines.len() == 0 { return ""; }
    let t = lines[0].trim();
    let name = t.strip_prefix("// ") ?? (t.strip_prefix("# ") ?? "");
    if name.is_empty() || name.contains(" ") || !name.contains(".") || name.ends_with(".") || name.char_count() > 48 { return ""; }
    esc(name)
}

/// The language of a `<pre><code class="language-x">` block, `""` for none.
fn code_lang(code: str) -> str {
    let at = code.find("class=\"language-") ?? return "";
    let rest = code[at + "class=\"language-".len():];
    let lang = rest[:rest.find("\"") ?? 0];
    if lang.char_count() > 16 || lang.contains(" ") { "" } else { esc(lang) }
}

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn callout_ko(kind: str) -> str {
    if kind == "note" {
        "참고"
    } else if kind == "tip" {
        "팁"
    } else if kind == "important" {
        "중요"
    } else if kind == "warning" {
        "경고"
    } else if kind == "caution" {
        "주의"
    } else {
        kind
    }
}

/// The end of a page whose source is at `url`.
pub fn edit_link(url: str, ko: bool) -> str {
    let (ask, label) = if ko { ("잘못된 곳이 있나요?", "GitHub에서 이 페이지 고치기") } else { ("Found a mistake?", "Edit this page on GitHub") };
    f"<p class=\"edit\">{ask} <a href=\"{esc(url)}\">{label}</a>.</p>\n"
}

/// `../` once per directory level of `out`, back to the site root.
pub fn root_of(out: str) -> str {
    let n = 0usize;
    for c in out.chars() {
        if c == '/' { n += 1; }
    }
    "../".repeat(n)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn readme_of(dir: str) -> str {
    if dir.is_empty() { "README.md" } else { dir + "/README.md" }
}

fn is_readme(src: str) -> bool { src == "README.md" || src.ends_with("/README.md") }

/// Relative href from the page at `from` to the site path `to`.
pub fn rel(from: str, to: str) -> str {
    let a: List<str> = List::new();
    for s in dir_of(from).split("/") {
        if !s.is_empty() { a.push(s); }
    }
    let b: List<str> = List::new();
    for s in to.split("/") { b.push(s); }
    let c = 0usize;
    while c < a.len() && c + 1 < b.len() && a[c] == b[c] { c += 1; }
    let out = StrBuf::new();
    for _ in c..a.len() { out.push_str("../"); }
    for k in c..b.len() {
        if k > c { out.push('/'); }
        out.push_str(b[k]);
    }
    out.to_str()
}

fn find(pages: List<Page>, src: str) -> usize | none {
    for k in 0..pages.len() {
        if pages[k].src == src { return k; }
    }
    none
}

/// `"5. Sum Types"` -> `("5", "Sum Types")`; `("", t)` if unnumbered.
pub fn split_no(t: str) -> (str, str) {
    let n = 0usize;
    for c in t.chars() {
        if c < '0' || c > '9' { break; }
        n += 1;
    }
    if n > 0 && t[n:].starts_with(". ") { return (t[:n], t[n + 2:]); }
    ("", t)
}

/// A sidebar link label: the chapter number in its own column.
fn label(t: str) -> str {
    let (no, rest) = split_no(t);
    if no.is_empty() { esc(t) } else { f"<span class=\"no\">{no}</span>{esc(rest)}" }
}

/// A learn chapter's `<h1>N. Title</h1>` as just the title: the
/// breadcrumb says "Chapter N".
pub fn chapter(html: str, title: str) -> str {
    let (no, rest) = split_no(title);
    if no.is_empty() { return html; }
    let t = esc(rest) + "</h1>";
    html.replace(f"\">#</a>{no}. {t}", "\">#</a>" + t)
}

/// "On this page": the `##` and `###` sections of `p`.
pub fn toc(p: Page) -> str {
    let out = StrBuf::new();
    for h in p.heads {
        if h.level == 2 {
            out.push_str(f"<li><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        } else if h.level == 3 {
            out.push_str(f"<li class=\"sub\"><a href=\"#{esc(h.id)}\">{esc(h.text)}</a></li>");
        }
    }
    out.to_str()
}

/// The sidebar of `pages[idx]`: the part it is in (its first directory:
/// a spec reference, a docs section) with every chapter listed and the
/// ones on the way to the page open.
pub fn sidebar(pages: List<Page>, idx: usize) -> str {
    let p = pages[idx];
    let top = if let k: usize = p.dir.find("/") { p.dir[:k] } else { p.dir };
    let out = StrBuf::new();
    if !top.is_empty() {
        if let up: usize = find(pages, readme_of(dir_of(top))) {
            out.push_str(f"<a class=\"up\" href=\"{rel(p.out, pages[up].out)}\">← {esc(pages[up].title)}</a>");
        }
    }
    if let h: usize = find(pages, readme_of(top)) {
        let cur = if h == idx { " aria-current=\"page\"" } else { "" };
        out.push_str(f"<p class=\"side-title\"><a{cur} href=\"{rel(p.out, pages[h].out)}\">{esc(pages[h].title)}</a></p>");
    }
    out.push_str(side_tree(pages, idx, top));
    out.to_str()
}

/// The files and sub-chapters of directory `d`, a sub-chapter on the way
/// to `pages[idx]` open.
fn side_tree(pages: List<Page>, idx: usize, d: str) -> str {
    let p = pages[idx];
    let out = StrBuf::new();
    out.push_str("<ul class=\"pages\">");
    for k in 0..pages.len() {
        let q = pages[k];
        let file = q.dir == d && !is_readme(q.src);
        let sub = is_readme(q.src) && q.dir != d && dir_of(q.dir) == d;
        if !file && !sub { continue; }
        let cur = if k == idx { " aria-current=\"page\"" } else { "" };
        let open = sub && (p.dir == q.dir || p.dir.starts_with(q.dir + "/"));
        let cls = if open { " class=\"open\"" } else { "" };
        out.push_str(f"<li{cls}><a{cur} href=\"{rel(p.out, q.out)}\">{label(q.title)}</a>");
        if open { out.push_str(side_tree(pages, idx, q.dir)); }
        out.push_str("</li>");
    }
    out.push_str("</ul>");
    out.to_str()
}

/// First paragraph of a page's HTML (its summary), tags and all: not one
/// in a quote or callout, nor a line that only switches the language.
fn lead(html: str) -> str {
    let h = drop_blocks(drop_blocks(html, "<blockquote", "blockquote"), "<div class=\"callout", "div");
    let at = 0usize;
    loop {
        let a = (h[at:].find("<p>") ?? return "") + at;
        let b = (h[a:].find("</p>") ?? return "") + a;
        let p = h[a + 3:b];
        if !is_lang_line(p) { return p; }
        at = b;
    }
}

/// `English · 한국어` and the like.
fn is_lang_line(p: str) -> bool {
    let t = strip_tags(p);
    t.contains("English") && t.contains("한국어") && t.char_count() < 40
}

/// `html` without the elements that start with `open` (`<blockquote`),
/// nested `<tag>`s and all.
fn drop_blocks(html: str, open: str, tag: str) -> str {
    let out = StrBuf::new();
    let rest = html;
    let o_pat = "<" + tag;
    let c_pat = "</" + tag + ">";
    loop {
        let k = rest.find(open) ?? rest.len();
        out.push_str(rest[:k]);
        if k == rest.len() { break; }
        let i = k + open.len();
        let depth = 1;
        while depth > 0 {
            let c = rest[i:].find(c_pat) ?? rest.len();
            if c == rest.len() {
                i = rest.len();
                break;
            }
            let o = rest[i:].find(o_pat) ?? rest.len();
            if o < c {
                depth += 1;
                i = i + o + o_pat.len();
            } else {
                depth -= 1;
                i = i + c + c_pat.len();
            }
        }
        rest = rest[i:];
    }
    out.to_str()
}

/// The summary of a page as plain text.
pub fn lead_text(html: str) -> str { strip_tags(lead(html)).replace("\n", " ").trim() }

/// A section index's list of its pages (after the index itself): a
/// two-column list for `examples/`, numbered chapters otherwise.
pub fn contents(group: List<Page>) -> str {
    let p = group[0];
    let ex = p.out.starts_with("examples/") || p.out.starts_with("ko/examples/");
    let out = StrBuf::new();
    out.push_str(if ex { "<div class=\"ex-list\">" } else { "<ol class=\"chapters\">" });
    for k in 1..group.len() {
        let q = group[k];
        let href = rel(p.out, q.out);
        if ex {
            out.push_str(f"<a class=\"ex\" href=\"{href}\"><b>{esc(q.title)}</b><span>{esc(lead_text(q.html))}</span></a>");
        } else {
            let (no, rest) = split_no(q.title);
            out.push_str(f"<li><span class=\"no\">{no}</span><div><a href=\"{href}\">{esc(rest)}</a><p>{lead(q.html)}</p></div></li>");
        }
    }
    out.push_str(if ex { "</div>" } else { "</ol>" });
    out.to_str()
}

/// Sidebar of a standalone page: just its title.
pub fn page_toc(p: Page) -> str {
    f"<p class=\"side-title\"><a aria-current=\"page\" href=\"#\">{esc(p.title)}</a></p>"
}

/// `en` on English pages, `kr` on Korean ones.
pub fn tr(ko: bool, en: str, kr: str) -> str { if ko { kr } else { en } }

pub fn pager(pages: List<Page>, idx: usize, ko: bool) -> str {
    let p = pages[idx];
    let out = StrBuf::new();
    out.push_str(f"<nav class=\"pager\" aria-label=\"{tr(ko, "Previous and next page", "이전 페이지와 다음 페이지")}\">");
    if idx > 0 {
        let q = pages[idx - 1];
        out.push_str(f"<a class=\"prev\" href=\"{rel(p.out, q.out)}\"><small>← {tr(ko, "Previous", "이전")}</small><span>{esc(q.title)}</span></a>");
    }
    if idx + 1 < pages.len() {
        let q = pages[idx + 1];
        out.push_str(f"<a class=\"next\" href=\"{rel(p.out, q.out)}\"><small>{tr(ko, "Next", "다음")} →</small><span>{esc(q.title)}</span></a>");
    }
    out.push_str("</nav>");
    out.to_str()
}

fn nav_item(href: str, label: str, on: bool) -> str {
    let cur = if on { " aria-current=\"page\"" } else { "" };
    f"<a href=\"{href}\"{cur}>{label}</a>"
}

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// The site's description in Korean (site.description in English).
pub const DESC_KO: str = "Rok은 무엇을 써야 하는지 알려 주는 컴파일 언어입니다. 닫힌 합 타입, AOT 컴파일, 풍부한 라이브러리, 패키지 레지스트리, REPL, Jupyter를 갖추고 있습니다.";

/// The page's summary for `<meta name="description">`: its first paragraph.
fn describe(site: Site, out: str, body: str) -> str {
    let ko = out.starts_with("ko/");
    let whole = if ko { DESC_KO } else { site.description };
    let at = out.strip_prefix("ko/") ?? out;
    if at == "index.html" || at == "404.html" { return whole; }
    let s = lead_text(body);
    if s.is_empty() { whole } else { clip(s, 160) }
}

/// Static file `name` under `root`, with `?v=` and the first 10 hex
/// digits of its SHA-256 when known (Site::assets): `serve` caches a file
/// asked for by its current version for good.
pub fn asset(site: Site, root: str, name: str) -> str {
    if let v: str = site.assets.get(name) { return root + name + "?v=" + v; }
    root + name
}

/// `<head>` from the charset to the icons. `root` leads to the icons and
/// stylesheets, `url` is the canonical address (`""`: none), `img` the
/// og:image (with its `?v=`) and `alt` its text. `ko`: a Korean page
/// (the kit's chrome::fonts_in loads Pretendard for those only).
fn head(site: Site, root: str, full: str, desc: str, url: str, img: str, alt: str, extra: str, ko: bool) -> str {
    // The docs' own cards are 1200 x 630; the site's card is og.png's size.
    let (w, h) = if img.contains("/og/") { (1200i64, 630i64) } else { (site.og_w, site.og_h) };
    let img = esc(img);
    let alt = esc(alt);
    let canonical = if url.is_empty() { "" } else { f"<link rel=\"canonical\" href=\"{esc(url)}\">\n" };
    let og_url = if url.is_empty() { "" } else { f"<meta property=\"og:url\" content=\"{esc(url)}\">\n" };
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<meta name=\"color-scheme\" content=\"light dark\">
<meta name=\"theme-color\" content=\"#fbfbfc\">
<script src=\"{asset(site, root, "theme.js")}\"></script>
<meta name=\"description\" content=\"{desc}\">
{canonical}{extra}<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
{og_url}<meta property=\"og:image\" content=\"{img}\">
<meta property=\"og:image:type\" content=\"image/png\">
<meta property=\"og:image:width\" content=\"{w}\">
<meta property=\"og:image:height\" content=\"{h}\">
<meta property=\"og:image:alt\" content=\"{alt}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"twitter:image\" content=\"{img}\">
<meta name=\"twitter:image:alt\" content=\"{alt}\">
{chrome::fonts_in(root, ko)}<link rel=\"stylesheet\" href=\"{asset(site, root, "rok.css")}\">
<link rel=\"stylesheet\" href=\"{asset(site, root, "style.css")}\">
{chrome::icons(root)}"
}

/// The address of `path` (`learn/index.html#x`) in the newest release's
/// docs: `https://docs.rok-lang.org/latest/learn#x`.
pub fn latest(site: Site, path: str) -> str {
    let (p, rest) = url::split_ref(path);
    let c = url::canon(p);
    site.docs_url + "/latest" + (if c.is_empty() { "" } else { "/" + c }) + rest
}

/// An absolute link into either site as its canonical address
/// (`https://docs.rok-lang.org` -> `.../latest`); any other href as is.
pub fn own(site: Site, href: str) -> str {
    for base in [site.docs_url, site.base_url] {
        let at = href.strip_prefix(base) ?? "-";
        if !(at.is_empty() || at.starts_with("/") || at.starts_with("?") || at.starts_with("#")) { continue; }
        let (p, rest) = url::split_ref(at);
        let c = url::canon(if p.is_empty() { "/" } else { p });
        if base == site.docs_url && c == "/" { c = "/latest"; }
        return base + c + rest;
    }
    href
}

/// The file name of the link preview card of docs page `out` under
/// static/og/: `learn/05-sum-types.html` -> `learn-05-sum-types.png`.
pub fn og_name(out: str) -> str { out.replace(".html", "").replace("/", "-") + ".png" }

/// The pages that have a card of their own: each section's index and
/// each guide chapter, in both languages.
pub fn has_card(out: str) -> bool {
    let at = out.strip_prefix("ko/") ?? out;
    if at.starts_with("learn/") { return true; }
    for (_, _, _, index) in SECTIONS {
        if at == index { return true; }
    }
    at == "spec/refs-standard-libraries/index.html"
}

/// The og:image of docs page `out`: its own card, else its section's,
/// else the site's.
pub fn og_image(site: Site, out: str) -> str {
    let ko = out.starts_with("ko/");
    let at = if ko { out["ko/".len():] } else { out };
    let (_, _, _, index) = section(at);
    for k in [out, if index.is_empty() { "" } else { in_lang(index, ko) }] {
        if k.is_empty() { continue; }
        let name = og_name(k);
        if let v: str = site.og_cards.get(name) { return latest(site, "og/" + name) + "?v=" + v; }
    }
    latest(site, "og.png") + (if site.og.is_empty() { "" } else { "?v=" + site.og })
}

const ICON_SEARCH: str = "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>";
const ICON_SIDE: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16\"/></svg>";
const ICON_CLOSE: str = "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>";

const TOGGLE: str = "<button class=\"nav-toggle\" type=\"button\" aria-label=\"Menu\" aria-expanded=\"false\" aria-controls=\"nav\"><span class=\"bars\"></span></button>";

/// Where the footer's links go, from the page it sits on.
struct Links {
    home: str;
    docs: str;
    learn: str;
    examples: str;
    errors: str;
    spec: str;
    api: str;
    tools: str;
    publishing: str;
    roadmap: str;
}

/// The footer of the Rok sites (chrome.rok), with this site's columns.
/// `on` is the site the page belongs to, `home` or `docs`.
fn footer(site: Site, l: Links, note: str, logo: str, ko: bool, on: str) -> str {
    let gh = "https://github.com/rok-lang";
    let a = |href: str, text: str| f"<a href=\"{esc(href)}\">{text}</a>";
    chrome::footer(chrome::Footer {
        home: l.home,
        logo: logo,
        tagline: tr(ko, site.tagline + ".", "무엇을 써야 하는지 알려 주는 컴파일 언어."),
        cols: [
            (tr(ko, "Docs", "문서"), a(l.learn, tr(ko, "Guide", "가이드")) + a(l.examples, tr(ko, "Examples", "예제")) + (if l.errors.is_empty() { "" } else { a(l.errors, tr(ko, "Error codes", "에러 코드")) })),
            (tr(ko, "Reference", "참조"), a(l.spec, tr(ko, "Language spec", "언어 사양")) + a(l.api, tr(ko, "Std library", "표준 라이브러리")) + a(l.tools, tr(ko, "Tools", "도구"))),
            (tr(ko, "Ecosystem", "생태계"), a(site.playground, tr(ko, "Playground", "플레이그라운드")) + a(site.packages, tr(ko, "Stones", "stone")) + a(l.publishing, tr(ko, "Publishing", "stone 공개")) + a(gh + "/rok.vscode", "VS Code") + a(gh + "/rok.vim", "Vim")),
            (tr(ko, "Project", "프로젝트"), a(l.roadmap, tr(ko, "Roadmap", "로드맵")) + a(gh + "/rok", "GitHub") + a(chrome::SECURITY, tr(ko, "Security", "보안")) + a(gh + "/rok/blob/main/CODE_OF_CONDUCT.md", tr(ko, "Code of conduct", "행동 강령")) + a("mailto:contact@rok-lang.org", tr(ko, "Contact", "연락처"))),
        ],
        sites: chrome::Sites { home: l.home, docs: l.docs, stones: site.packages, playground: site.playground, current: on },
        after: note,
        ko: ko,
        release: site.release,
    })
}

/// The docs' sections in header order: nav key, English and Korean name,
/// index page. One name per section, everywhere.
pub const SECTIONS: [(str, str, str, str); 6] = [
    ("guide", "Guide", "가이드", "learn/index.html"),
    ("examples", "Examples", "예제", "examples/index.html"),
    ("spec", "Language spec", "언어 사양", "spec/refs-lang/index.html"),
    ("std", "Std library", "표준 라이브러리", "std/index.html"),
    ("errors", "Error codes", "에러 코드", "errors/index.html"),
    ("tools", "Tools", "도구", "spec/refs-lang/009-tools/index.html"),
];

/// The section of docs page `at` (without `ko/`): nav key, English and
/// Korean name, index page; empty outside the sections.
pub fn section(at: str) -> (str, str, str, str) {
    if at.starts_with("learn/") { return SECTIONS[0]; }
    if at.starts_with("examples/") { return SECTIONS[1]; }
    if at.starts_with("errors/") { return SECTIONS[4]; }
    if at.starts_with("spec/refs-lang/009-tools/") { return SECTIONS[5]; }
    if at.starts_with("spec/refs-standard-libraries/") { return ("std", "Library spec", "라이브러리 사양", "spec/refs-standard-libraries/index.html"); }
    if at.starts_with("spec/") { return SECTIONS[2]; }
    if at.starts_with("std/") { return SECTIONS[3]; }
    ("", "", "", "")
}

/// Docs page `p` (from the version root) in Korean if `ko`.
pub fn in_lang(p: str, ko: bool) -> str { if ko { "ko/" + p } else { p } }

/// The note over the docs of any version but the newest release, linking
/// to this page in latest/ if it is there (`in_latest`), else to latest/.
/// `root` leads from the page to its version's directory.
pub fn ver_banner(site: Site, root: str, out: str, in_latest: bool) -> str {
    if site.version == site.newest || site.newest.is_empty() { return ""; }
    let ko = out.starts_with("ko/");
    let up = if root.starts_with("/") { "/" } else { root + "../" };
    let to = up + "latest/" + if in_latest && !out.ends_with("404.html") { out } else { in_lang("index.html", ko) };
    let rel = "v" + if site.newest_release.is_empty() { site.newest } else { site.newest_release };
    let (what, go) = if ko {
        (if site.version == "dev" { "아직 릴리스하지 않은 다음 버전의 문서입니다." } else { f"v{site.version} 문서를 보고 있습니다." }, f"최신 릴리스: {rel} →")
    } else {
        (if site.version == "dev" { "Unreleased docs for the next version." } else { f"You are reading the docs for v{site.version}." }, f"Latest release: {rel} →")
    };
    f"<p class=\"ver-banner\">{what} <a href=\"{to}\">{go}</a></p>\n"
}

/// A page of the docs of one version under `banner` (`ver_banner`).
/// search.js fills the version menu from `versions.json` beside the
/// version directories.
pub fn page(site: Site, f: Frag, banner: str) -> str { frame(site, root_of(f.out), f, banner) }

/// The 404 page of the version directory `dir` (its Korean one if `ko`),
/// served for any missing path under it, so its links are absolute and
/// stay in that version.
pub fn not_found_page(site: Site, dir: str, ko: bool) -> str {
    let root = "/" + dir + "/";
    let out = if ko { "ko/404.html" } else { "404.html" };
    let f = Frag { out: out, title: tr(ko, "Page not found", "페이지를 찾을 수 없습니다"), side: "", body: not_found(|p| root + in_lang(p, ko), ko, site.no_errors), pager: "", head: "" };
    frame(site, root, f, ver_banner(site, root, out, false))
}

/// EN / Korean switch of the page `at` (without `ko/`): links to `alt`,
/// the other language's page, from the version root, else to the same
/// path in the other language. `sec` pairs this page's heading ids with
/// the other's (search.js).
fn lang_switch(root: str, at: str, ko: bool, alt: str, sec: str) -> str {
    let other = if !alt.is_empty() { alt } else if ko { at } else { "ko/" + at };
    let href = root + other;
    let data = if sec.is_empty() { "" } else { f" data-sec=\"{esc(sec)}\"" };
    let en = if ko { f"<a href=\"{href}\" hreflang=\"en\" lang=\"en\">English</a>" } else { "<span aria-current=\"true\" lang=\"en\">English</span>" };
    let kr = if ko { "<span aria-current=\"true\" lang=\"ko\">한국어</span>" } else { f"<a href=\"{href}\" hreflang=\"ko\" lang=\"ko\">한국어</a>" };
    f"<nav class=\"lang-switch\" aria-label=\"{tr(ko, "Language", "언어")}\"{data}>{en}{kr}</nav>"
}

/// The version menu's items: each released version and dev, linking to
/// this page in it (to its docs home from a 404 page). search.js sends a
/// reader to the section's start when that version lacks the page.
fn vers_items(site: Site, root: str, out: str, lost: bool) -> str {
    let ko = out.starts_with("ko/");
    let page = if lost { in_lang("index.html", ko) } else { out };
    let b = StrBuf::new();
    let item = |dir: str, label: str, note: str| {
        let cur = if dir == site.version { " aria-current=\"true\"" } else { "" };
        let small = if note.is_empty() { "" } else { f"<small>{esc(note)}</small>" };
        b.push_str(f"<li><a href=\"{root}../{dir}/{page}\" data-label=\"{esc(label)}\"{cur}>{esc(label)}{small}</a></li>");
    };
    for r in site.released {
        let patch = site.patches.get(r) ?? "";
        let note = if r == site.newest { if patch.is_empty() { "latest" } else { patch + " · latest" } } else { patch };
        item(r, "v" + r, note);
    }
    item("dev", "dev", tr(ko, "main branch", "main 브랜치"));
    b.to_str()
}

/// The version a page title names off the newest release: ` (v0.1.0)`,
/// ` (dev)`; `""` on the newest.
fn ver_suffix(site: Site) -> str {
    if site.version == site.newest || site.newest.is_empty() { return ""; }
    if site.version == "dev" { " (dev)" } else { f" (v{site.version})" }
}

fn frame(site: Site, root: str, f: Frag, banner: str) -> str {
    let out = f.out;
    let ko = out.starts_with("ko/");
    let at = if ko { out["ko/".len():] } else { out };
    let lost = at == "404.html";
    let (sec, sec_en, sec_ko, sec_index) = section(at);
    let nav = StrBuf::new();
    for (key, en, kr, href) in SECTIONS {
        if key == "errors" && site.no_errors { continue; }
        nav.push_str(nav_item(root + in_lang(href, ko), tr(ko, en, kr), sec == key));
    }
    let name = tr(ko, "Rok Docs", "Rok 문서");
    let full = (if at == "index.html" { name } else { f.title + " - " + name }) + ver_suffix(site);
    let contents = tr(ko, "Contents", "목차");
    let on_this = tr(ko, "On this page", "이 페이지의 내용");
    // On narrow screens the sidebar is a drawer, opened from a bar in
    // the sticky header (search.js).
    let (aside, bar) = if f.side.is_empty() {
        ("", "")
    } else {
        (f"<nav id=\"side\" class=\"side\" aria-label=\"{contents}\"><div class=\"side-h\"><p class=\"t-label\">{contents}</p><button class=\"ib side-close\" type=\"button\" aria-label=\"{tr(ko, "Close contents", "목차 닫기")}\">{ICON_CLOSE}</button></div>{f.side}</nav>\n", f"<div class=\"cbar\"><button class=\"side-toggle\" type=\"button\" aria-controls=\"side\" aria-expanded=\"false\">{ICON_SIDE}{contents}</button></div>\n")
    };
    let on_page = if f.toc.is_empty() { "" } else { f"<aside class=\"toc\" aria-label=\"{on_this}\"><p class=\"t-label\">{on_this}</p><ul>{f.toc}</ul></aside>\n" };
    // Below the wide layout's "On this page" column: the same list,
    // folded under the title.
    let body = if f.toc.is_empty() {
        f.body
    } else if let k: usize = f.body.find("</h1>") {
        f.body[:k + 5] + f"\n<details class=\"toc-m\"><summary>{on_this}</summary><ul>{f.toc}</ul></details>" + f.body[k + 5:]
    } else {
        f.body
    };
    let kind = if at == "index.html" { "home" } else if f.side.is_empty() { "doc wide" } else { "doc" };
    // One line says where the page is: its section and, in the guide,
    // the chapter; the language switch sits at its end.
    let crumb = if sec.is_empty() || at == sec_index || lost {
        ""
    } else {
        let (no, _) = split_no(f.title);
        let sep = "<span class=\"sep\" aria-hidden=\"true\">/</span>";
        let chap = if sec == "guide" && !no.is_empty() {
            f"{sep}<span aria-current=\"page\">{tr(ko, "Chapter " + no, no + "장")}</span>"
        } else if !f.crumb.is_empty() {
            f"{f.crumb}{sep}<span class=\"here\" aria-current=\"page\">{esc(f.title)}</span>"
        } else {
            ""
        };
        f"<nav class=\"crumb\" aria-label=\"{tr(ko, "Breadcrumb", "이동 경로")}\"><a href=\"{root}{in_lang(sec_index, ko)}\">{tr(ko, sec_en, sec_ko)}</a>{chap}</nav>"
    };
    let switch = if lost { "" } else { lang_switch(root, at, ko, f.alt, f.sec) };
    let pagehead = if crumb.is_empty() && switch.is_empty() { "" } else { f"<div class=\"pagehead\">{crumb}{switch}</div>\n" };
    let lang = if ko { "ko" } else { "en" };
    let desc = esc(describe(site, out, body));
    // A 404 page has no address of its own; the Korean API pages are the
    // English ones in Korean chrome, so they name those.
    let url = if lost { "" } else if ko && at.starts_with("std/") { latest(site, at) } else { latest(site, if at == "index.html" && !ko { "" } else { out }) };
    // Unreleased docs, and Korean pages still in English, stay out of
    // search engines.
    let robots = if site.version == "dev" || f.noindex { "<meta name=\"robots\" content=\"noindex\">\n" } else { "" };
    let ver = if site.version == "dev" { "dev" } else { "v" + site.version };
    let links = Links { home: site.base_url, docs: root + in_lang("index.html", ko), learn: root + in_lang("learn/index.html", ko), examples: root + in_lang("examples/index.html", ko), errors: if site.no_errors { "" } else { root + in_lang("errors/index.html", ko) }, spec: root + in_lang("spec/refs-lang/index.html", ko), api: root + in_lang("std/index.html", ko), tools: root + in_lang("spec/refs-lang/009-tools/index.html", ko), publishing: root + in_lang("learn/18-features-and-stones.html", ko) + (if ko { "" } else { "#publishing-a-stone" }), roadmap: site.base_url + "/roadmap" };
    let play = if !site.newest.is_empty() && site.version == site.newest { esc(site.playground) } else { "" };
    let (skip, menu, sections, find, results, version) = if ko {
        ("본문으로 건너뛰기", "메뉴", "섹션", "문서 검색", "검색 결과", "문서 버전")
    } else {
        ("Skip to content", "Menu", "Sections", "Search docs", "Search results", "Docs version")
    };
    let note = if at.starts_with("spec/") { tr(ko, "<span>Spec text © Han Damin, <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a></span>", "<span>사양 본문 © Han Damin, <a href=\"https://creativecommons.org/licenses/by/4.0/\">CC BY 4.0</a></span>") } else { "" };
    let img = og_image(site, out);
    let alt = if img.contains("/og/") { f.title + " - " + name } else { f"{site.title}: {site.tagline}" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"{lang}\">
<head>
{head(site, root, full, desc, url, img, alt, robots + f.head, ko)}</head>
<body class=\"{kind}\" data-root=\"{root}\" data-version=\"{esc(site.version)}\" data-play=\"{play}\">
<a class=\"skip\" href=\"#content\">{skip}</a>
<header class=\"hdr top\" lang=\"{lang}\">
<div class=\"in\">
<a class=\"brand\" href=\"{root}{in_lang("index.html", ko)}\" lang=\"en\"><img src=\"{root}logo.svg\" alt=\"\" width=\"24\" height=\"24\">Rok<span class=\"sl\">/</span><span class=\"site\">Docs</span></a>
{TOGGLE.replace("aria-label=\"Menu\"", f"aria-label=\"{menu}\"")}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"{sections}\">{nav.to_str()}</nav>
<div class=\"tools\">
<div class=\"search\" role=\"search\">{ICON_SEARCH}<input id=\"q\" type=\"search\" placeholder=\"{find}\" aria-label=\"{find}\" aria-keyshortcuts=\"/ Control+K Meta+K\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"results\"><kbd class=\"kbd\" aria-hidden=\"true\">/</kbd><ul id=\"results\" class=\"results\" role=\"listbox\" aria-label=\"{results}\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></div>
<details class=\"vers\"><summary aria-label=\"{version}: {ver}\">{ver}</summary><ul class=\"vers-menu\">{vers_items(site, root, out, lost)}</ul></details>
{chrome::theme_button(ko)}
</div>
</div>
{bar}</header>
{banner}<div class=\"shell\">
{aside}<main id=\"content\" class=\"main\">
<article class=\"prose\">
{pagehead}{body}{f.pager}
</article>
{on_page}</main>
</div>
{footer(site, links, note, root + "logo.svg", ko, "docs")}<script src=\"{asset(site, root, "keys.js")}\" defer></script>
<script src=\"{asset(site, root, "copy.js")}\" defer></script>
<script src=\"{asset(site, root, "search.js")}\" defer></script>
</body>
</html>
"
}

/// A page of the home site (rok-lang.org): no search, its nav into the
/// newest docs. The landing page (`index.html`) brings its own layout.
pub fn www_page(site: Site, out: str, title: str, body: str) -> str {
    let root = if out == "404.html" { "/" } else { root_of(out) };
    let nav = StrBuf::new();
    nav.push_str(nav_item(esc(latest(site, "learn/index.html")), "Guide", false));
    nav.push_str(nav_item(esc(latest(site, "index.html")), "Docs", false));
    nav.push_str(nav_item(esc(latest(site, "examples/index.html")), "Examples", false));
    nav.push_str(nav_item(esc(site.playground), "Playground", false));
    nav.push_str(nav_item(esc(site.packages), "Stones", false));
    nav.push_str(nav_item(root + "roadmap.html", "Roadmap", out == "roadmap.html"));
    // "Download Rok" is "Download - Rok", not "Download Rok - Rok".
    let short = title.strip_suffix(" " + site.title) ?? title;
    let full = if out == "index.html" { site.title + " - " + site.tagline } else { short + " - " + site.title };
    let url = if out == "404.html" { "" } else if out == "index.html" { site.base_url + "/" } else { site.base_url + "/" + url::canon(out) };
    let kind = if out == "index.html" { "landing" } else { "plain" };
    let desc = esc(if out == "download.html" { f"Download rok {site.release} for macOS, Linux and Windows: the install script, or an archive with its SHA-256." } else if out == "roadmap.html" { "The rok roadmap: what the current release ships and where the language is headed next." } else { site.description });
    let main = if out == "index.html" { body } else { f"<div class=\"frame page\"><article class=\"prose\">\n{body}</article></div>\n" };
    let install = if out == "download.html" { " aria-current=\"page\"" } else { "" };
    let links = Links { home: root + "index.html", docs: latest(site, "index.html"), learn: latest(site, "learn/index.html"), examples: latest(site, "examples/index.html"), errors: if site.no_errors { "" } else { latest(site, "errors/index.html") }, spec: latest(site, "spec/refs-lang/index.html"), api: latest(site, "std/index.html"), tools: latest(site, "spec/refs-lang/009-tools/index.html"), publishing: latest(site, "learn/18-features-and-stones.html#publishing-a-stone"), roadmap: root + "roadmap.html" };
    let img = site.base_url + "/og.png" + (if site.og.is_empty() { "" } else { "?v=" + site.og });
    let hero = if out == "index.html" { f"<script src=\"{asset(site, root, "hero.js")}\" defer></script>\n" } else { "" };
    f"<!doctype html>
<html class=\"rk lt\" lang=\"en\">
<head>
{head(site, root, full, desc, url, img, f"{site.title}: {site.tagline}", "", false)}</head>
<body class=\"{kind} www\" data-root=\"{root}\" data-play=\"{esc(site.playground)}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr top\" lang=\"en\">
<div class=\"frame in\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"26\" height=\"26\">Rok</a>
{TOGGLE}
<nav id=\"nav\" class=\"nav main-nav\" aria-label=\"Main\">{nav.to_str()}</nav>
<div class=\"tools\">
<a class=\"gh\" href=\"https://github.com/rok-lang/rok\">GitHub</a>
<a class=\"btn btn-sm\" href=\"{root}download.html\"{install}>Install</a>
{chrome::theme_button(false)}
</div>
</div>
</header>
<main id=\"content\">
{main}</main>
{footer(site, links, "", root + "logo.svg", false, "home")}<script src=\"{asset(site, root, "copy.js")}\" defer></script>
<script src=\"{asset(site, root, "search.js")}\" defer></script>
{hero}</body>
</html>
"
}

/// Body of a 404 page: one sentence (search.js names the path), a search
/// field that opens the docs search, and where to go instead. `to(p)` is
/// the address of docs page `p`.
pub fn not_found(to: fn(str) -> str, ko: bool, no_errors: bool) -> str {
    let links = StrBuf::new();
    links.push_str(f"<li><a href=\"{esc(to("index.html"))}\">{tr(ko, "Docs home", "문서 홈")}</a></li>");
    for (key, en, kr, href) in SECTIONS {
        if key == "errors" && no_errors { continue; }
        links.push_str(f"<li><a href=\"{esc(to(href))}\">{tr(ko, en, kr)}</a></li>"); }
    let find = tr(ko, "Search the docs", "문서 검색");
    // A form's action is no href, so site_hrefs leaves it: canonical here.
    let home = to("index.html");
    let action = if home.starts_with("/") { url::canon(home) } else { home };
    f"<div class=\"lost\">
<h1>{tr(ko, "Page not found", "페이지를 찾을 수 없습니다")}</h1>
<p class=\"lead\">{tr(ko, "There is no page at <code id=\"lost-path\">this address</code>.", "<code id=\"lost-path\">이 주소</code>에는 페이지가 없습니다.")}</p>
<p class=\"lost-hint\" hidden></p>
<form class=\"lost-find\" action=\"{esc(action)}\" method=\"get\" role=\"search\"><label class=\"lost-q\">{ICON_SEARCH}<input name=\"q\" type=\"search\" placeholder=\"{find}\" aria-label=\"{find}\" autocomplete=\"off\"></label><button class=\"btn-2\" type=\"submit\">{tr(ko, "Search", "검색")}</button></form>
<ul class=\"lost-links\">{links.to_str()}</ul>
</div>
"
}
/// The docs root's `index.html`: off to the newest release.
pub fn to_latest(site: Site) -> str {
    let home = esc(latest(site, ""));
    f"<!doctype html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<title>Rok Docs</title>
<meta http-equiv=\"refresh\" content=\"0; url=/latest\">
<link rel=\"canonical\" href=\"{home}\">
</head>
<body>
<p><a href=\"/latest\">Rok Docs</a></p>
</body>
</html>
"
}
