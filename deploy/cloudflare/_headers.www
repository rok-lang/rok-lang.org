# Copied into public/www/ by deploy.sh. Identity well-knowns served at
# the rok-lang.org root: Bluesky handle verification (atproto-did) and a
# Mastodon WebFinger alias (@rok@rok-lang.org -> @roklang@mastodon.social).
# Both need an explicit content type since the files carry no extension.
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
/.well-known/webfinger
  Content-Type: application/jrd+json; charset=utf-8
  Access-Control-Allow-Origin: *
